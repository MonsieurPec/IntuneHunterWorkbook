                },
                {
                  "type": 12,
                  "content": {
                    "version": "NotebookGroup/1.0",
                    "groupType": "editable",
                    "items": [
                      {
                        "type": 3,
                        "content": {
                          "version": "KqlItem/1.0",
                          "query": "let InventoryLookback = 30d;\nlet InventoryStart = iif({TimeRange:start} < ago(InventoryLookback), {TimeRange:start}, ago(InventoryLookback));\n// IntuneDevices reports StorageFree / StorageTotal as a raw long. Units are not\n// documented by Microsoft; this tenant reports MB. Set to 1073741824.0 if bytes.\nlet StorageUnitToGB = 1024.0;\nlet CriticalGB = 10.0;\nlet WarningGB = 25.0;\nlet Disk = IntuneDevices\n| where TimeGenerated > InventoryStart\n| where OS == \"Windows\"\n| summarize arg_max(TimeGenerated, DeviceName, SerialNumber, UPN, Model, Manufacturer, StorageFree, StorageTotal, LastContact) by DeviceId\n| extend Free = todouble(StorageFree), Total = todouble(StorageTotal)\n| where isnotnull(Free) and isnotnull(Total) and Free > 0 and Total > 0\n| extend Free_GB = round(Free / StorageUnitToGB, 2), Total_GB = round(Total / StorageUnitToGB, 2)\n| extend Free_Percentage = round(Free * 100.0 / Total, 2)\n| extend Disk_Status = case(Free_GB < CriticalGB, \"Critical\", Free_GB < WarningGB, \"Warning\", \"OK\");\nDisk\n| where Disk_Status == \"Critical\"\n| summarize Count = count()\n| extend Text = \"Critical (< 10 GB)\"\n| extend Range = strcat(\"last \", tostring(toint(round((now() - InventoryStart) / 1d, 0))), \" d snapshot\")",
                          "size": 1,
                          "queryType": 0,
                          "resourceType": "microsoft.operationalinsights/workspaces",
                          "title": "Critical",
                          "visualization": "tiles",
                          "timeContextFromParameter": "TimeRange",
                          "tileSettings": {
                            "titleContent": {
                              "columnMatch": "Text",
                              "formatter": 18,
                              "formatOptions": {
                                "thresholdsOptions": "icons",
                                "thresholdsGrid": [
                                  {
                                    "operator": "Default",
                                    "thresholdValue": null,
                                    "representation": "2",
                                    "text": "{0}{1}"
                                  }
                                ]
                              }
                            },
                            "leftContent": {
                              "columnMatch": "Count",
                              "formatter": 12,
                              "formatOptions": {
                                "min": 0,
                                "palette": "red"
                              }
                            },
                            "secondaryContent": {
                              "columnMatch": "Range",
                              "formatter": 1
                            },
                            "showBorder": false
                          },
                          "crossComponentResources": [
                            "{IntuneWorkspace}"
                          ]
                        },
                        "name": "kpi-disk-critical",
                        "customWidth": "25"
                      },
                      {
                        "type": 3,
                        "content": {
                          "version": "KqlItem/1.0",
                          "query": "let InventoryLookback = 30d;\nlet InventoryStart = iif({TimeRange:start} < ago(InventoryLookback), {TimeRange:start}, ago(InventoryLookback));\n// IntuneDevices reports StorageFree / StorageTotal as a raw long. Units are not\n// documented by Microsoft; this tenant reports MB. Set to 1073741824.0 if bytes.\nlet StorageUnitToGB = 1024.0;\nlet CriticalGB = 10.0;\nlet WarningGB = 25.0;\nlet Disk = IntuneDevices\n| where TimeGenerated > InventoryStart\n| where OS == \"Windows\"\n| summarize arg_max(TimeGenerated, DeviceName, SerialNumber, UPN, Model, Manufacturer, StorageFree, StorageTotal, LastContact) by DeviceId\n| extend Free = todouble(StorageFree), Total = todouble(StorageTotal)\n| where isnotnull(Free) and isnotnull(Total) and Free > 0 and Total > 0\n| extend Free_GB = round(Free / StorageUnitToGB, 2), Total_GB = round(Total / StorageUnitToGB, 2)\n| extend Free_Percentage = round(Free * 100.0 / Total, 2)\n| extend Disk_Status = case(Free_GB < CriticalGB, \"Critical\", Free_GB < WarningGB, \"Warning\", \"OK\");\nDisk\n| where Disk_Status == \"Warning\"\n| summarize Count = count()\n| extend Text = \"Warning (< 25 GB)\"\n| extend Range = strcat(\"last \", tostring(toint(round((now() - InventoryStart) / 1d, 0))), \" d snapshot\")",
                          "size": 1,
                          "queryType": 0,
                          "resourceType": "microsoft.operationalinsights/workspaces",
                          "title": "Warning",
                          "visualization": "tiles",
                          "timeContextFromParameter": "TimeRange",
                          "tileSettings": {
                            "titleContent": {
                              "columnMatch": "Text",
                              "formatter": 18,
                              "formatOptions": {
                                "thresholdsOptions": "icons",
                                "thresholdsGrid": [
                                  {
                                    "operator": "Default",
                                    "thresholdValue": null,
                                    "representation": "Alert",
                                    "text": "{0}{1}"
                                  }
                                ]
                              }
                            },
                            "leftContent": {
                              "columnMatch": "Count",
                              "formatter": 12,
                              "formatOptions": {
                                "min": 0,
                                "palette": "orange"
                              }
                            },
                            "secondaryContent": {
                              "columnMatch": "Range",
                              "formatter": 1
                            },
                            "showBorder": false
                          },
                          "crossComponentResources": [
                            "{IntuneWorkspace}"
                          ]
                        },
                        "name": "kpi-disk-warning",
                        "customWidth": "25"
                      },
                      {
                        "type": 3,
                        "content": {
                          "version": "KqlItem/1.0",
                          "query": "let InventoryLookback = 30d;\nlet InventoryStart = iif({TimeRange:start} < ago(InventoryLookback), {TimeRange:start}, ago(InventoryLookback));\n// IntuneDevices reports StorageFree / StorageTotal as a raw long. Units are not\n// documented by Microsoft; this tenant reports MB. Set to 1073741824.0 if bytes.\nlet StorageUnitToGB = 1024.0;\nlet CriticalGB = 10.0;\nlet WarningGB = 25.0;\nlet Disk = IntuneDevices\n| where TimeGenerated > InventoryStart\n| where OS == \"Windows\"\n| summarize arg_max(TimeGenerated, DeviceName, SerialNumber, UPN, Model, Manufacturer, StorageFree, StorageTotal, LastContact) by DeviceId\n| extend Free = todouble(StorageFree), Total = todouble(StorageTotal)\n| where isnotnull(Free) and isnotnull(Total) and Free > 0 and Total > 0\n| extend Free_GB = round(Free / StorageUnitToGB, 2), Total_GB = round(Total / StorageUnitToGB, 2)\n| extend Free_Percentage = round(Free * 100.0 / Total, 2)\n| extend Disk_Status = case(Free_GB < CriticalGB, \"Critical\", Free_GB < WarningGB, \"Warning\", \"OK\");\nDisk\n| where Disk_Status == \"OK\"\n| summarize Count = count()\n| extend Text = \"OK\"\n| extend Range = strcat(\"last \", tostring(toint(round((now() - InventoryStart) / 1d, 0))), \" d snapshot\")",
                          "size": 1,
                          "queryType": 0,
                          "resourceType": "microsoft.operationalinsights/workspaces",
                          "title": "OK",
                          "visualization": "tiles",
                          "timeContextFromParameter": "TimeRange",
                          "tileSettings": {
                            "titleContent": {
                              "columnMatch": "Text",
                              "formatter": 18,
                              "formatOptions": {
                                "thresholdsOptions": "icons",
                                "thresholdsGrid": [
                                  {
                                    "operator": "Default",
                                    "thresholdValue": null,
                                    "representation": "success",
                                    "text": "{0}{1}"
                                  }
                                ]
                              }
                            },
                            "leftContent": {
                              "columnMatch": "Count",
                              "formatter": 12,
                              "formatOptions": {
                                "min": 0,
                                "palette": "greenRed"
                              }
                            },
                            "secondaryContent": {
                              "columnMatch": "Range",
                              "formatter": 1
                            },
                            "showBorder": false
                          },
                          "crossComponentResources": [
                            "{IntuneWorkspace}"
                          ]
                        },
                        "name": "kpi-disk-ok",
                        "customWidth": "25"
                      },
                      {
                        "type": 3,
                        "content": {
                          "version": "KqlItem/1.0",
                          "query": "let InventoryLookback = 30d;\nlet InventoryStart = iif({TimeRange:start} < ago(InventoryLookback), {TimeRange:start}, ago(InventoryLookback));\n// IntuneDevices reports StorageFree / StorageTotal as a raw long. Units are not\n// documented by Microsoft; this tenant reports MB. Set to 1073741824.0 if bytes.\nlet StorageUnitToGB = 1024.0;\nlet CriticalGB = 10.0;\nlet WarningGB = 25.0;\nlet Disk = IntuneDevices\n| where TimeGenerated > InventoryStart\n| where OS == \"Windows\"\n| summarize arg_max(TimeGenerated, DeviceName, SerialNumber, UPN, Model, Manufacturer, StorageFree, StorageTotal, LastContact) by DeviceId\n| extend Free = todouble(StorageFree), Total = todouble(StorageTotal)\n| where isnotnull(Free) and isnotnull(Total) and Free > 0 and Total > 0\n| extend Free_GB = round(Free / StorageUnitToGB, 2), Total_GB = round(Total / StorageUnitToGB, 2)\n| extend Free_Percentage = round(Free * 100.0 / Total, 2)\n| extend Disk_Status = case(Free_GB < CriticalGB, \"Critical\", Free_GB < WarningGB, \"Warning\", \"OK\");\nDisk\n| summarize Count = count()\n| extend Text = \"Devices evaluated\"\n| extend Range = strcat(\"last \", tostring(toint(round((now() - InventoryStart) / 1d, 0))), \" d snapshot\")",
                          "size": 1,
                          "queryType": 0,
                          "resourceType": "microsoft.operationalinsights/workspaces",
                          "title": "Devices evaluated",
                          "visualization": "tiles",
                          "timeContextFromParameter": "TimeRange",
                          "tileSettings": {
                            "titleContent": {
                              "columnMatch": "Text",
                              "formatter": 18,
                              "formatOptions": {
                                "thresholdsOptions": "icons",
                                "thresholdsGrid": [
                                  {
                                    "operator": "Default",
                                    "thresholdValue": null,
                                    "representation": "AllServices",
                                    "text": "{0}{1}"
                                  }
                                ]
                              }
                            },
                            "leftContent": {
                              "columnMatch": "Count",
                              "formatter": 12,
                              "formatOptions": {
                                "min": 0,
                                "palette": "blue"
                              }
                            },
                            "secondaryContent": {
                              "columnMatch": "Range",
                              "formatter": 1
                            },
                            "showBorder": false
                          },
                          "crossComponentResources": [
