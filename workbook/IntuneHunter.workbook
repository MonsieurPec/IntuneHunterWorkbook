                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "let MinJustificationLength = 15;\nlet BusinessStart = 7;\nlet BusinessEnd = 19;\nlet PIMActivations = AuditLogs\n| where TimeGenerated {TimeRange}\n| where LoggedByService == \"PIM\"\n| where OperationName == \"Add member to role completed (PIM activation)\"\n| extend Requestor = tostring(InitiatedBy.user.userPrincipalName)\n| where isnotempty(Requestor)\n| where Requestor in ({Actor}) or '*' in ({Actor})\n| mv-apply Target = todynamic(TargetResources) on (\n    summarize RoleSet = make_set_if(tostring(Target.displayName), tostring(Target.type) =~ \"Role\"),\n              UserSet = make_set_if(tostring(Target.userPrincipalName), tostring(Target.type) =~ \"User\"),\n              ScopeSet = make_set_if(tostring(Target.displayName), tostring(Target.type) !~ \"Role\" and isnotempty(tostring(Target.displayName))))\n| extend Role = tostring(RoleSet[0]), TargetUser = tostring(UserSet[0]), ResourceName = tostring(ScopeSet[0])\n| extend RawDetails = iif(array_length(todynamic(AdditionalDetails)) == 0, pack_array(bag_pack(\"key\", \"_none\", \"value\", \"\")), todynamic(AdditionalDetails))\n| mv-apply Detail = RawDetails on (\n    summarize Bag = make_bag(bag_pack(tostring(Detail.key), Detail.value)))\n| extend Justification = coalesce(tostring(Bag[\"Justification\"]), tostring(ResultReason), tostring(ResultDescription), \"\")\n| extend StartTime = todatetime(coalesce(tostring(Bag[\"StartTime\"]), tostring(Bag[\"startDateTime\"])))\n| extend EndTime = todatetime(coalesce(tostring(Bag[\"ExpirationTime\"]), tostring(Bag[\"EndTime\"]), tostring(Bag[\"expirationDateTime\"])))\n| extend TicketNumber = tostring(Bag[\"TicketNumber\"]), TicketSystem = tostring(Bag[\"TicketSystem\"]), ActorIP = tostring(Bag[\"ipaddr\"])\n| extend DurationHours = iif(isnotnull(StartTime) and isnotnull(EndTime), round((EndTime - StartTime) / 1h, 1), real(-1))\n| extend JustificationLength = strlen(Justification)\n| extend JustificationQuality = case(JustificationLength == 0, \"Missing\", JustificationLength < MinJustificationLength, \"Too short\", \"Provided\")\n| extend OutsideHours = hourofday(TimeGenerated) < BusinessStart or hourofday(TimeGenerated) >= BusinessEnd or dayofweek(TimeGenerated) in (0d, 6d)\n| where Role in ({PIMRole}) or '*' in ({PIMRole});\nPIMActivations\n| where JustificationQuality != \"Provided\"\n| summarize Count = count()\n| extend Text = \"Weak justifications\"\n| extend Range = \"missing or < 15 chars\"",
