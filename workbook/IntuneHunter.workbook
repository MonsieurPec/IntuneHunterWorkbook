                      {
                        "type": 3,
                        "content": {
                          "version": "KqlItem/1.0",
                          "query": "let AllDevicesTrend = IntuneDevices\n| where TimeGenerated {TimeRange}\n| extend Day = bin(TimeGenerated, 1d)\n| summarize arg_max(TimeGenerated, OS) by DeviceId, Day\n| project-away TimeGenerated\n| extend OSShortName = case(OS =~ \"iOS/iPadOS\", \"iOS/iPadOS\", OS has \"Android\", \"Android\", OS has \"Windows\", \"Windows\", OS =~ \"MacOS\", \"macOS\", isempty(OS), \"Unknown\", \"Other\");\nAllDevicesTrend\n| summarize DeviceCount = count() by OSShortName, TimeGenerated = Day\n| project TimeGenerated, OSShortName, DeviceCount\n| sort by TimeGenerated asc",
                          "size": 2,
                          "queryType": 0,
                          "resourceType": "microsoft.operationalinsights/workspaces",
                          "title": "Devices per day by OS - {TimeRange:label}",
                          "visualization": "linechart",
                          "timeContextFromParameter": "TimeRange",
                          "chartSettings": {
                            "showLegend": true,
                            "seriesLabelSettings": [
                              {
                                "seriesName": "Windows",
                                "color": "blue"
                              },
                              {
                                "seriesName": "iOS/iPadOS",
                                "color": "gray"
                              },
                              {
