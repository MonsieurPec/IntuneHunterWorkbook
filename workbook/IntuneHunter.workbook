                },
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "let InventoryLookback = 30d;\nlet InventoryStart = iif({TimeRange:start} < ago(InventoryLookback), {TimeRange:start}, ago(InventoryLookback));\nlet DeviceLookup = workspace('{IntuneWorkspace}').IntuneDevices\n| where TimeGenerated > InventoryStart\n| where isnotempty(ReferenceId)\n| summarize arg_max(TimeGenerated, SerialNumber) by DeviceId = ReferenceId\n| project DeviceId, SerialNumber;\nAuditLogs\n| where TimeGenerated {TimeRange}\n| where OperationName == \"Recover device local administrator password\"\n| mv-expand TargetResources\n| extend DeviceName = tostring(TargetResources.displayName)\n| extend DeviceId = tostring(TargetResources.id)\n| extend Actor = tostring(coalesce(InitiatedBy.user.userPrincipalName, InitiatedBy.app.appDisplayName))\n| where isnotempty(Actor)\n| where Actor in ({Actor}) or '*' in ({Actor})\n| join kind=leftouter (DeviceLookup) on DeviceId\n| project TimeGenerated, Actor, DeviceName, SerialNumber, DeviceId, Result\n| sort by TimeGenerated desc",
                    "size": 0,
                    "queryType": 0,
                    "resourceType": "microsoft.operationalinsights/workspaces",
                    "title": "Recovery request details",
                    "visualization": "table",
                    "timeContextFromParameter": "TimeRange",
                    "showExportToExcel": true,
                    "gridSettings": {
                      "formatters": [
                        {
                          "columnMatch": "Actor",
                          "formatter": 18,
                          "formatOptions": {
                            "thresholdsOptions": "icons",
                            "thresholdsGrid": [
                              {
                                "operator": "contains",
                                "thresholdValue": "(app)",
                                "representation": "Gear",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": "Default",
                                "thresholdValue": null,
                                "representation": "Person",
                                "text": "{0}{1}"
                              }
                            ]
                          }
                        },
                        {
                          "columnMatch": "Result",
                          "formatter": 18,
                          "formatOptions": {
                            "thresholdsOptions": "icons",
                            "thresholdsGrid": [
                              {
                                "operator": "==",
                                "thresholdValue": "success",
                                "representation": "success",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": "Default",
                                "thresholdValue": null,
                                "representation": "3",
                                "text": "{0}{1}"
                              }
                            ]
                          }
                        }
                      ],
                      "filter": true,
                      "rowLimit": 1000,
                      "labelSettings": [
                        {
                          "columnId": "TimeGenerated",
                          "label": "Timestamp"
                        },
                        {
                          "columnId": "DeviceName",
                          "label": "Device name"
                        },
                        {
                          "columnId": "DeviceId",
                          "label": "Device object ID"
                        }
                      ]
                    },
                    "crossComponentResources": [
                      "{EntraWorkspace}"
                    ]
                  },
                  "name": "table - laps",
                  "customWidth": 40
                },
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "AuditLogs\n| where TimeGenerated {TimeRange}\n| where OperationName == \"Recover device local administrator password\"\n| mv-expand TargetResources\n| extend DeviceName = tostring(TargetResources.displayName)\n| extend DeviceId = tostring(TargetResources.id)\n| extend Actor = tostring(coalesce(InitiatedBy.user.userPrincipalName, InitiatedBy.app.appDisplayName))\n| where isnotempty(Actor)\n| where Actor in ({Actor}) or '*' in ({Actor})\n| summarize DevicesRequested = dcount(DeviceName), Requests = count(), DeviceSet = make_set(DeviceName, 200) by Actor, bin(TimeGenerated, 1h)\n| where DevicesRequested >= 5\n| extend Devices = strcat_array(DeviceSet, \", \")\n| project TimeGenerated, Actor, DevicesRequested, Requests, Devices\n| sort by DevicesRequested desc",
                    "size": 0,
                    "queryType": 0,
                    "resourceType": "microsoft.operationalinsights/workspaces",
                    "title": "Potential harvesting (5+ distinct devices per hour by actor)",
                    "visualization": "table",
                    "timeContextFromParameter": "TimeRange",
                    "showExportToExcel": true,
                    "gridSettings": {
                      "formatters": [
