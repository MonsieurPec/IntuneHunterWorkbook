                      {
                        "type": 3,
                        "content": {
                          "version": "KqlItem/1.0",
                          "query": "let InventoryLookback = 30d;\nlet InventoryStart = iif({TimeRange:start} < ago(InventoryLookback), {TimeRange:start}, ago(InventoryLookback));\nlet LastSeen = IntuneDevices\n| where TimeGenerated > InventoryStart\n| summarize arg_max(TimeGenerated, *) by DeviceId\n| where DeviceState =~ \"Managed\"\n| extend OSShortName = case(OS =~ \"iOS/iPadOS\", \"iOS/iPadOS\", OS has \"Android\", \"Android\", OS has \"Windows\", \"Windows\", OS =~ \"MacOS\", \"macOS\", \"Other\")\n| where OSShortName in (\"iOS/iPadOS\", \"Android\")\n| where OSShortName in ({MobileOS}) or '*' in ({MobileOS})\n| where isnotempty(Model)\n| extend VersionRank = coalesce(parse_version(OSVersion), todecimal(0));\nlet ModelMax = LastSeen\n| summarize arg_max(VersionRank, OSVersion) by Model, OSShortName\n| project Model, OSShortName, MaxRank = VersionRank, LatestOSVersion = OSVersion;\nLastSeen\n| join kind=inner (ModelMax) on Model, OSShortName\n| where VersionRank != MaxRank\n| project DeviceName, UPN, OSShortName, Model, OSVersion, LatestOSVersion, DeviceState, LastContact, SerialNumber, DeviceId\n| sort by Model asc, OSVersion asc",
                          "size": 0,
                          "queryType": 0,
                          "resourceType": "microsoft.operationalinsights/workspaces",
                          "title": "Outdated devices",
                          "visualization": "table",
