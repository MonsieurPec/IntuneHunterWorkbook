                          ]
                        },
                        "name": "kpi-disk-total",
                        "customWidth": "25"
                      },
                      {
                        "type": 3,
                        "content": {
                          "version": "KqlItem/1.0",
                          "query": "let InventoryLookback = 30d;\nlet InventoryStart = iif({TimeRange:start} < ago(InventoryLookback), {TimeRange:start}, ago(InventoryLookback));\n// IntuneDevices reports StorageFree / StorageTotal as a raw long. Units are not\n// documented by Microsoft; this tenant reports MB. Set to 1073741824.0 if bytes.\nlet StorageUnitToGB = 1024.0;\nlet CriticalGB = 10.0;\nlet WarningGB = 25.0;\nlet Disk = IntuneDevices\n| where TimeGenerated > InventoryStart\n| where OS == \"Windows\"\n| summarize arg_max(TimeGenerated, DeviceName, SerialNumber, UPN, Model, Manufacturer, StorageFree, StorageTotal, LastContact) by DeviceId\n| extend Free = todouble(StorageFree), Total = todouble(StorageTotal)\n| where isnotnull(Free) and isnotnull(Total) and Free > 0 and Total > 0\n| extend Free_GB = round(Free / StorageUnitToGB, 2), Total_GB = round(Total / StorageUnitToGB, 2)\n| extend Free_Percentage = round(Free * 100.0 / Total, 2)\n| extend Disk_Status = case(Free_GB < CriticalGB, \"Critical\", Free_GB < WarningGB, \"Warning\", \"OK\");\nDisk\n| summarize Devices = count() by Disk_Status",
                          "size": 2,
                          "queryType": 0,
                          "resourceType": "microsoft.operationalinsights/workspaces",
                          "title": "Breakdown by status",
                          "visualization": "piechart",
                          "timeContextFromParameter": "TimeRange",
                          "chartSettings": {
                            "showLegend": false,
                            "seriesLabelSettings": [
                              {
                                "seriesName": "OK",
                                "color": "green"
                              },
                              {
                                "seriesName": "Warning",
                                "color": "orange"
                              },
                              {
                                "seriesName": "Critical",
                                "color": "red"
                              }
                            ]
                          },
                          "crossComponentResources": [
                            "{IntuneWorkspace}"
                          ]
                        },
                        "name": "chart - disk-status",
                        "customWidth": "35"
                      },
                      {
                        "type": 3,
                        "content": {
                          "version": "KqlItem/1.0",
                          "query": "let InventoryLookback = 30d;\nlet InventoryStart = iif({TimeRange:start} < ago(InventoryLookback), {TimeRange:start}, ago(InventoryLookback));\n// IntuneDevices reports StorageFree / StorageTotal as a raw long. Units are not\n// documented by Microsoft; this tenant reports MB. Set to 1073741824.0 if bytes.\nlet StorageUnitToGB = 1024.0;\nlet CriticalGB = 10.0;\nlet WarningGB = 25.0;\nlet Disk = IntuneDevices\n| where TimeGenerated > InventoryStart\n| where OS == \"Windows\"\n| summarize arg_max(TimeGenerated, DeviceName, SerialNumber, UPN, Model, Manufacturer, StorageFree, StorageTotal, LastContact) by DeviceId\n| extend Free = todouble(StorageFree), Total = todouble(StorageTotal)\n| where isnotnull(Free) and isnotnull(Total) and Free > 0 and Total > 0\n| extend Free_GB = round(Free / StorageUnitToGB, 2), Total_GB = round(Total / StorageUnitToGB, 2)\n| extend Free_Percentage = round(Free * 100.0 / Total, 2)\n| extend Disk_Status = case(Free_GB < CriticalGB, \"Critical\", Free_GB < WarningGB, \"Warning\", \"OK\");\nDisk\n| project DeviceName, Free_GB\n| top 15 by Free_GB asc",
                          "size": 2,
                          "queryType": 0,
                          "resourceType": "microsoft.operationalinsights/workspaces",
                          "title": "15 lowest devices by free space (GB)",
                          "visualization": "barchart",
                          "timeContextFromParameter": "TimeRange",
                          "chartSettings": {
                            "showLegend": false
                          },
                          "crossComponentResources": [
                            "{IntuneWorkspace}"
                          ]
                        },
                        "name": "chart - disk-lowest",
                        "customWidth": "65"
                      },
                      {
                        "type": 3,
                        "content": {
                          "version": "KqlItem/1.0",
                          "query": "let InventoryLookback = 30d;\nlet InventoryStart = iif({TimeRange:start} < ago(InventoryLookback), {TimeRange:start}, ago(InventoryLookback));\n// IntuneDevices reports StorageFree / StorageTotal as a raw long. Units are not\n// documented by Microsoft; this tenant reports MB. Set to 1073741824.0 if bytes.\nlet StorageUnitToGB = 1024.0;\nlet CriticalGB = 10.0;\nlet WarningGB = 25.0;\nlet Disk = IntuneDevices\n| where TimeGenerated > InventoryStart\n| where OS == \"Windows\"\n| summarize arg_max(TimeGenerated, DeviceName, SerialNumber, UPN, Model, Manufacturer, StorageFree, StorageTotal, LastContact) by DeviceId\n| extend Free = todouble(StorageFree), Total = todouble(StorageTotal)\n| where isnotnull(Free) and isnotnull(Total) and Free > 0 and Total > 0\n| extend Free_GB = round(Free / StorageUnitToGB, 2), Total_GB = round(Total / StorageUnitToGB, 2)\n| extend Free_Percentage = toint(round(Free * 100.0 / Total))\n| extend Disk_Status = case(Free_GB < CriticalGB, \"Critical\", Free_GB < WarningGB, \"Warning\", \"OK\");\nDisk\n| project DeviceName, UPN, Disk_Status, Free_GB, Total_GB, Free_Percentage, Manufacturer, Model, SerialNumber, LastContact\n| sort by Free_Percentage asc",
                          "size": 0,
                          "queryType": 0,
                          "resourceType": "microsoft.operationalinsights/workspaces",
                          "title": "Disk detail",
                          "visualization": "table",
                          "timeContextFromParameter": "TimeRange",
                          "showExportToExcel": true,
                          "gridSettings": {
                            "filter": true,
                            "rowLimit": 1000,
                            "formatters": [
                              {
                                "columnMatch": "Disk_Status",
                                "formatter": 18,
                                "formatOptions": {
                                  "thresholdsOptions": "icons",
                                  "thresholdsGrid": [
                                    {
                                      "operator": "==",
                                      "thresholdValue": "Critical",
                                      "representation": "2",
                                      "text": "{0}{1}"
                                    },
                                    {
                                      "operator": "==",
                                      "thresholdValue": "Warning",
                                      "representation": "Alert",
                                      "text": "{0}{1}"
                                    },
                                    {
                                      "operator": "Default",
                                      "thresholdValue": null,
                                      "representation": "success",
                                      "text": "{0}{1}"
                                    }
                                  ]
                                }
                              },
                              {
                                "columnMatch": "Free_Percentage",
                                "formatter": 4,
                                "formatOptions": {
                                  "palette": "redGreen",
                                  "min": 0,
                                  "max": 100
                                }
                              }
                            ],
                            "labelSettings": [
                              {
                                "columnId": "DeviceName",
                                "label": "Device name"
                              },
                              {
                                "columnId": "UPN",
                                "label": "Primary user"
                              },
                              {
                                "columnId": "Disk_Status",
                                "label": "Status"
                              },
                              {
                                "columnId": "Free_GB",
                                "label": "Free (GB)"
                              },
                              {
                                "columnId": "Total_GB",
                                "label": "Total (GB)"
                              },
                              {
                                "columnId": "Free_Percentage",
                                "label": "Free (%)"
                              },
                              {
                                "columnId": "SerialNumber",
                                "label": "Serial number"
                              },
                              {
                                "columnId": "LastContact",
                                "label": "Last check-in"
                              }
                            ]
                          },
                          "crossComponentResources": [
                            "{IntuneWorkspace}"
                          ]
                        },
                        "name": "table - disk"
                      }
                    ]
                  },
                  "conditionalVisibility": {
                    "parameterName": "InvSection",
                    "comparison": "isEqualTo",
                    "value": "Disk"
                  },
                  "name": "group - inv-disk",
                  "styleSettings": {
                    "showBorder": false,
                    "padding": "10px"
                  }
                },
                {
                  "type": 12,
                  "content": {
                    "version": "NotebookGroup/1.0",
                    "groupType": "editable",
                    "items": [
                      {
                        "type": 3,
                        "content": {
                          "version": "KqlItem/1.0",
                          "query": "let AutopilotBuilds = IntuneOperationalLogs\n| where TimeGenerated {TimeRange}\n| where OperationName == \"ESPEnrollment\"\n| extend P = todynamic(Properties)\n| extend ManagedDeviceId = tostring(P.DeviceId), AadDeviceId = tostring(P.AadDeviceId), SerialNumber = tostring(P.ZtdDeviceSerialNumber), IsAutopilot = tostring(P.IsAutopilot), Status = tostring(P.Status), EventId = tostring(P.EventId), Scope = tostring(P.Scope), EnrollmentType = tostring(P.EnrollmentTypeMessage), ESPPolicyName = tostring(P.ESPPolicyName)\n| where IsAutopilot =~ \"true\"\n| where Status =~ \"Success\"\n| where EventId == \"DeviceProvisioningProgressEvent\"\n| where Scope == \"DeviceEnrollmentSuccess\"\n| where isnotempty(ManagedDeviceId)\n| project BuildTime = TimeGenerated, ManagedDeviceId, AadDeviceId, SerialNumber, EnrollmentType, ESPPolicyName;\nAutopilotBuilds\n| summarize Count = count()\n| extend Text = \"Autopilot builds\"\n| extend Range = \"{TimeRange:label}\"",
