                  },
                  "name": "params - topactions"
                },
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "let Filtered = IntuneAuditLogs\n| where TimeGenerated {TimeRange}\n| where not(OperationName matches regex \"(?i)^Sync\")\n| where OperationName in ({Operation}) or '*' in ({Operation})\n| extend AuditProps = parse_json(Properties)\n| extend ActorUPN = tostring(AuditProps.Actor.UPN)\n| extend ActorApp = tostring(AuditProps.Actor.ApplicationName)\n| extend Actor = case(isnotempty(ActorUPN), ActorUPN, isnotempty(ActorApp), strcat(ActorApp, \" (app)\"), Identity)\n| where Actor in ({Actor}) or '*' in ({Actor})\n| extend Object = tostring(AuditProps.TargetDisplayNames[0])\n| extend EventId = tostring(AuditProps.AuditEventId);\nFiltered\n| summarize Count = dcount(EventId), Actors = dcount(Actor) by OperationName\n| top {TopN} by Count desc\n| extend Range = strcat(tostring(Actors), \" actor(s)\")\n| project Text = OperationName, Count, Range",
                    "size": 3,
                    "queryType": 0,
                    "resourceType": "microsoft.operationalinsights/workspaces",
                    "title": "Top {TopN} operations",
                    "visualization": "tiles",
                    "timeContextFromParameter": "TimeRange",
                    "tileSettings": {
