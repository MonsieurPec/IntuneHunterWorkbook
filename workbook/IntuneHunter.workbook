                  },
                  "name": "group - inv-autopilot",
                  "styleSettings": {
                    "showBorder": false,
                    "padding": "10px"
                  }
                },
                {
                  "type": 12,
                  "content": {
                    "version": "NotebookGroup/1.0",
                    "groupType": "editable",
                    "items": [
                      {
                        "type": 9,
                        "content": {
                          "version": "KqlParameterItem/1.0",
                          "parameters": [
                            {
                              "id": "f1000000-0000-0000-0000-000000000001",
                              "version": "KqlParameterItem/1.0",
                              "name": "MobileOS",
                              "label": "Operating system",
                              "type": 2,
                              "multiSelect": true,
                              "quote": "'",
                              "delimiter": ",",
                              "query": "IntuneDevices\n| where TimeGenerated > ago(30d)\n| extend OSShortName = case(OS =~ \"iOS/iPadOS\", \"iOS/iPadOS\", OS has \"Android\", \"Android\", \"Other\")\n| where OSShortName in (\"iOS/iPadOS\", \"Android\")\n| distinct OSShortName\n| order by OSShortName asc",
                              "typeSettings": {
                                "additionalResourceOptions": [
                                  "value::all"
                                ],
                                "showDefault": false
                              },
                              "defaultValue": "value::all",
                              "timeContext": {
                                "durationMs": 2592000000
                              },
                              "queryType": 0,
                              "resourceType": "microsoft.operationalinsights/workspaces",
                              "crossComponentResources": [
                                "{IntuneWorkspace}"
                              ]
                            }
                          ],
                          "style": "pills"
                        },
                        "name": "params - mobile"
                      },
                      {
                        "type": 3,
                        "content": {
                          "version": "KqlItem/1.0",
                          "query": "let InventoryLookback = 30d;\nlet InventoryStart = iif({TimeRange:start} < ago(InventoryLookback), {TimeRange:start}, ago(InventoryLookback));\nlet LastSeen = IntuneDevices\n| where TimeGenerated > InventoryStart\n| summarize arg_max(TimeGenerated, *) by DeviceId\n| where DeviceState =~ \"Managed\"\n| extend OSShortName = case(OS =~ \"iOS/iPadOS\", \"iOS/iPadOS\", OS has \"Android\", \"Android\", OS has \"Windows\", \"Windows\", OS =~ \"MacOS\", \"macOS\", \"Other\")\n| where OSShortName in (\"iOS/iPadOS\", \"Android\")\n| where OSShortName in ({MobileOS}) or '*' in ({MobileOS})\n| where isnotempty(Model)\n| extend VersionRank = coalesce(parse_version(OSVersion), todecimal(0));\nlet ModelMax = LastSeen\n| summarize arg_max(VersionRank, OSVersion) by Model, OSShortName\n| project Model, OSShortName, MaxRank = VersionRank, LatestOSVersion = OSVersion;\nlet ModelCurrency = LastSeen\n| join kind=inner (ModelMax) on Model, OSShortName\n| summarize Devices = count(), UpToDate = countif(VersionRank == MaxRank) by Model, OSShortName, LatestOSVersion\n| extend Outdated = Devices - UpToDate\n| extend UpToDatePct = round(100.0 * UpToDate / Devices, 1);\nModelCurrency\n| summarize Count = sum(Devices)\n| extend Text = \"Managed devices\"\n| extend Range = strcat(\"last \", tostring(toint(round((now() - InventoryStart) / 1d, 0))), \" d, in scope\")",
                          "size": 1,
                          "queryType": 0,
                          "resourceType": "microsoft.operationalinsights/workspaces",
                          "title": "Managed devices",
                          "visualization": "tiles",
                          "timeContextFromParameter": "TimeRange",
                          "tileSettings": {
                            "titleContent": {
                              "columnMatch": "Text",
                              "formatter": 18,
                              "formatOptions": {
                                "thresholdsOptions": "icons",
                                "thresholdsGrid": [
                                  {
                                    "operator": "Default",
                                    "thresholdValue": null,
                                    "representation": "AllServices",
                                    "text": "{0}{1}"
                                  }
                                ]
                              }
                            },
                            "leftContent": {
                              "columnMatch": "Count",
                              "formatter": 12,
                              "formatOptions": {
                                "min": 0,
                                "palette": "blue"
                              }
                            },
                            "secondaryContent": {
                              "columnMatch": "Range",
                              "formatter": 1
                            },
                            "showBorder": false
                          },
                          "crossComponentResources": [
                            "{IntuneWorkspace}"
                          ]
                        },
                        "name": "kpi-mob-devices",
                        "customWidth": "25"
                      },
                      {
                        "type": 3,
                        "content": {
                          "version": "KqlItem/1.0",
                          "query": "let InventoryLookback = 30d;\nlet InventoryStart = iif({TimeRange:start} < ago(InventoryLookback), {TimeRange:start}, ago(InventoryLookback));\nlet LastSeen = IntuneDevices\n| where TimeGenerated > InventoryStart\n| summarize arg_max(TimeGenerated, *) by DeviceId\n| where DeviceState =~ \"Managed\"\n| extend OSShortName = case(OS =~ \"iOS/iPadOS\", \"iOS/iPadOS\", OS has \"Android\", \"Android\", OS has \"Windows\", \"Windows\", OS =~ \"MacOS\", \"macOS\", \"Other\")\n| where OSShortName in (\"iOS/iPadOS\", \"Android\")\n| where OSShortName in ({MobileOS}) or '*' in ({MobileOS})\n| where isnotempty(Model)\n| extend VersionRank = coalesce(parse_version(OSVersion), todecimal(0));\nlet ModelMax = LastSeen\n| summarize arg_max(VersionRank, OSVersion) by Model, OSShortName\n| project Model, OSShortName, MaxRank = VersionRank, LatestOSVersion = OSVersion;\nlet ModelCurrency = LastSeen\n| join kind=inner (ModelMax) on Model, OSShortName\n| summarize Devices = count(), UpToDate = countif(VersionRank == MaxRank) by Model, OSShortName, LatestOSVersion\n| extend Outdated = Devices - UpToDate\n| extend UpToDatePct = round(100.0 * UpToDate / Devices, 1);\nModelCurrency\n| summarize Count = dcount(Model)\n| extend Text = \"Distinct models\"\n| extend Range = strcat(\"last \", tostring(toint(round((now() - InventoryStart) / 1d, 0))), \" d, in scope\")",
                          "size": 1,
                          "queryType": 0,
                          "resourceType": "microsoft.operationalinsights/workspaces",
