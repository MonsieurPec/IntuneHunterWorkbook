            },
            "conditionalVisibility": {
              "parameterName": "AuditSection",
              "comparison": "isEqualTo",
              "value": "BitLocker"
            },
            "name": "group - bitlocker",
            "styleSettings": {
              "showBorder": false,
              "padding": "10px"
            }
          },
          {
            "type": 12,
            "content": {
              "version": "NotebookGroup/1.0",
              "groupType": "editable",
              "items": [
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "let DestructiveOps = dynamic([\"wipe\",\"retire\",\"cleanWindowsDevice\",\"freshStart\",\"eraseDevice\",\"remoteLock\",\"resetPasscode\",\"disable\"]);\nlet InventoryLookback = 30d;\nlet InventoryStart = iif({TimeRange:start} < ago(InventoryLookback), {TimeRange:start}, ago(InventoryLookback));\nlet DeviceLookup = IntuneDevices\n| where TimeGenerated > InventoryStart\n| summarize arg_max(TimeGenerated, DeviceName, UPN, OS, OSVersion, Model, Manufacturer, LastContact) by DeviceId\n| extend InvOS = case(OS =~ \"iOS/iPadOS\", \"iOS/iPadOS\", OS has \"Android\", \"Android\", OS has \"Windows\", \"Windows\", OS =~ \"MacOS\", \"macOS\", \"Other\")\n| project DeviceId, InvDeviceName = DeviceName, UPN, InvOS, OSVersion, Model, Manufacturer, LastContact;\nIntuneAuditLogs\n| where TimeGenerated {TimeRange}\n| where OperationName has_any (DestructiveOps) or (OperationName contains \"Delete ManagedDevice\" and OperationName <> \"Delete ManagedDeviceMobileAppConfiguration\")\n| where OperationName in ({Operation}) or '*' in ({Operation})\n| extend AuditProps = parse_json(Properties)\n| extend ActorUPN = tostring(AuditProps.Actor.UPN)\n| extend ActorApp = tostring(AuditProps.Actor.ApplicationName)\n| extend Actor = case(isnotempty(ActorUPN), ActorUPN, isnotempty(ActorApp), strcat(ActorApp, \" (app)\"), Identity)\n| where Actor in ({Actor}) or '*' in ({Actor})\n| extend DeviceId = tostring(AuditProps.TargetObjectIds[0])\n| extend AuditTargetLabel = tostring(AuditProps.TargetDisplayNames[0])\n| extend AuditEventId = tostring(AuditProps.AuditEventId)\n| extend ActionType = case(OperationName has \"wipe\", \"Wipe\", OperationName has \"eraseDevice\", \"Erase\", OperationName has \"retire\", \"Retire\", OperationName has \"cleanWindowsDevice\", \"Fresh Start\", OperationName has \"freshStart\", \"Fresh Start\", OperationName has \"remoteLock\", \"Remote lock\", OperationName has \"resetPasscode\", \"Passcode reset\", OperationName has \"disable\", \"Disable\", OperationName contains \"Delete ManagedDevice\", \"Device deletion\", OperationName)\n| join kind=leftouter (DeviceLookup) on DeviceId\n| extend NameResolution = iif(isnotempty(InvDeviceName), \"Resolved\", \"Not in inventory\")\n| extend DeviceName = iif(isnotempty(InvDeviceName), InvDeviceName, strcat(\"<unresolved \", DeviceId, \">\"))\n| extend OSShortName = iif(isempty(InvOS), \"Unknown\", InvOS)\n| summarize Count = count()\n| extend Text = \"Wipe\" \n| extend Range = \"{TimeRange:label}\"",
                    "size": 1,
                    "queryType": 0,
                    "resourceType": "microsoft.operationalinsights/workspaces",
                    "title": "Wipe",
                    "visualization": "tiles",
                    "timeContextFromParameter": "TimeRange",
                    "tileSettings": {
                      "titleContent": {
                        "columnMatch": "Text",
                        "formatter": 18,
                        "formatOptions": {
                          "thresholdsOptions": "icons",
                          "thresholdsGrid": [
                            {
                              "operator": "Default",
                              "thresholdValue": null,
                              "representation": "2",
                              "text": "{0}{1}"
                            }
                          ]
                        }
                      },
                      "leftContent": {
                        "columnMatch": "Count",
                        "formatter": 12,
                        "formatOptions": {
                          "min": 0,
                          "palette": "red"
                        }
                      },
                      "secondaryContent": {
                        "columnMatch": "Range",
                        "formatter": 1
                      },
                      "showBorder": false
                    },
                    "crossComponentResources": [
                      "{IntuneWorkspace}"
                    ]
                  },
                  "name": "kpi-wipe-wipe",
                  "customWidth": "20"
                },
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "let DestructiveOps = dynamic([\"wipe\",\"retire\",\"cleanWindowsDevice\",\"freshStart\",\"eraseDevice\",\"remoteLock\",\"resetPasscode\",\"disable\"]);\nlet InventoryLookback = 30d;\nlet InventoryStart = iif({TimeRange:start} < ago(InventoryLookback), {TimeRange:start}, ago(InventoryLookback));\nlet DeviceLookup = IntuneDevices\n| where TimeGenerated > InventoryStart\n| summarize arg_max(TimeGenerated, DeviceName, UPN, OS, OSVersion, Model, Manufacturer, LastContact) by DeviceId\n| extend InvOS = case(OS =~ \"iOS/iPadOS\", \"iOS/iPadOS\", OS has \"Android\", \"Android\", OS has \"Windows\", \"Windows\", OS =~ \"MacOS\", \"macOS\", \"Other\")\n| project DeviceId, InvDeviceName = DeviceName, UPN, InvOS, OSVersion, Model, Manufacturer, LastContact;\nIntuneAuditLogs\n| where TimeGenerated {TimeRange}\n| where OperationName has_any (DestructiveOps) or (OperationName contains \"Delete ManagedDevice\" and OperationName <> \"Delete ManagedDeviceMobileAppConfiguration\")\n| where OperationName in ({Operation}) or '*' in ({Operation})\n| extend AuditProps = parse_json(Properties)\n| extend ActorUPN = tostring(AuditProps.Actor.UPN)\n| extend ActorApp = tostring(AuditProps.Actor.ApplicationName)\n| extend Actor = case(isnotempty(ActorUPN), ActorUPN, isnotempty(ActorApp), strcat(ActorApp, \" (app)\"), Identity)\n| where Actor in ({Actor}) or '*' in ({Actor})\n| extend DeviceId = tostring(AuditProps.TargetObjectIds[0])\n| extend AuditTargetLabel = tostring(AuditProps.TargetDisplayNames[0])\n| extend AuditEventId = tostring(AuditProps.AuditEventId)\n| extend ActionType = case(OperationName has \"wipe\", \"Wipe\", OperationName has \"eraseDevice\", \"Erase\", OperationName has \"retire\", \"Retire\", OperationName has \"cleanWindowsDevice\", \"Fresh Start\", OperationName has \"freshStart\", \"Fresh Start\", OperationName has \"remoteLock\", \"Remote lock\", OperationName has \"resetPasscode\", \"Passcode reset\", OperationName has \"disable\", \"Disable\", OperationName contains \"Delete ManagedDevice\", \"Device deletion\", OperationName)\n| join kind=leftouter (DeviceLookup) on DeviceId\n| extend NameResolution = iif(isnotempty(InvDeviceName), \"Resolved\", \"Not in inventory\")\n| extend DeviceName = iif(isnotempty(InvDeviceName), InvDeviceName, strcat(\"<unresolved \", DeviceId, \">\"))\n| extend OSShortName = iif(isempty(InvOS), \"Unknown\", InvOS)\n| where ActionType == \"Retire\"\n| summarize Count = count()\n| extend Text = \"Retire\" \n| extend Range = \"{TimeRange:label}\"",
                    "size": 1,
                    "queryType": 0,
                    "resourceType": "microsoft.operationalinsights/workspaces",
                    "title": "Retire",
                    "visualization": "tiles",
                    "timeContextFromParameter": "TimeRange",
                    "tileSettings": {
                      "titleContent": {
                        "columnMatch": "Text",
                        "formatter": 18,
                        "formatOptions": {
                          "thresholdsOptions": "icons",
                          "thresholdsGrid": [
                            {
                              "operator": "Default",
                              "thresholdValue": null,
                              "representation": "Discard",
                              "text": "{0}{1}"
                            }
                          ]
                        }
                      },
                      "leftContent": {
                        "columnMatch": "Count",
                        "formatter": 12,
                        "formatOptions": {
                          "min": 0,
                          "palette": "orange"
                        }
                      },
                      "secondaryContent": {
                        "columnMatch": "Range",
                        "formatter": 1
                      },
                      "showBorder": false
                    },
                    "crossComponentResources": [
                      "{IntuneWorkspace}"
                    ]
                  },
                  "name": "kpi-wipe-retire",
                  "customWidth": "20"
                },
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
