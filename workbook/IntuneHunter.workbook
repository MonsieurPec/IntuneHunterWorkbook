                {
                  "type": 12,
                  "content": {
                    "version": "NotebookGroup/1.0",
                    "groupType": "editable",
                    "items": [
                      {
                        "type": 9,
                        "content": {
                          "version": "KqlParameterItem/1.0",
                          "parameters": [
                            {
                              "id": "f2000000-0000-0000-0000-000000000001",
                              "version": "KqlParameterItem/1.0",
                              "name": "ComplianceOS",
                              "label": "Operating system",
                              "type": 2,
                              "multiSelect": true,
                              "quote": "'",
                              "delimiter": ",",
                              "query": "IntuneDeviceComplianceOrg\n| where TimeGenerated > ago(30d)\n| extend OSShortName = case(OS =~ \"iOS/iPadOS\", \"iOS/iPadOS\", OS has \"Android\", \"Android\", OS has \"Windows\", \"Windows\", OS =~ \"MacOS\", \"macOS\", isempty(OS), \"Unknown\", \"Other\")\n| distinct OSShortName\n| order by OSShortName asc",
                              "typeSettings": {
                                "additionalResourceOptions": [
                                  "value::all"
                                ],
                                "showDefault": false
                              },
                              "defaultValue": "value::all",
                              "timeContext": {
                                "durationMs": 2592000000
                              },
                              "queryType": 0,
                              "resourceType": "microsoft.operationalinsights/workspaces",
                              "crossComponentResources": [
                                "{IntuneWorkspace}"
                              ]
                            }
                          ],
                          "style": "pills"
                        },
                        "name": "params - compliance"
                      },
                      {
                        "type": 3,
                        "content": {
                          "version": "KqlItem/1.0",
                          "query": "let InventoryLookback = 30d;\nlet InventoryStart = iif({TimeRange:start} < ago(InventoryLookback), {TimeRange:start}, ago(InventoryLookback));\nlet Compliance = IntuneDeviceComplianceOrg\n| where TimeGenerated > InventoryStart\n| summarize arg_max(TimeGenerated, *) by DeviceId\n| extend OSShortName = case(OS =~ \"iOS/iPadOS\", \"iOS/iPadOS\", OS has \"Android\", \"Android\", OS has \"Windows\", \"Windows\", OS =~ \"MacOS\", \"macOS\", isempty(OS), \"Unknown\", \"Other\")\n| where OSShortName in ({ComplianceOS}) or '*' in ({ComplianceOS})\n| extend GraceUntil = todatetime(InGracePeriodUntil)\n| extend InGrace = isnotnull(GraceUntil) and GraceUntil > now() and GraceUntil < datetime(9000-01-01)\n| extend State = case(isempty(ComplianceState), \"Unknown\", ComplianceState);\nCompliance\n| summarize Count = count()\n| extend Text = \"Devices evaluated\"\n| extend Range = strcat(\"last \", tostring(toint(round((now() - InventoryStart) / 1d, 0))), \" d snapshot\")",
                          "size": 1,
                          "queryType": 0,
                          "resourceType": "microsoft.operationalinsights/workspaces",
                          "title": "Devices evaluated",
                          "visualization": "tiles",
                          "timeContextFromParameter": "TimeRange",
                          "tileSettings": {
                            "titleContent": {
                              "columnMatch": "Text",
                              "formatter": 18,
                              "formatOptions": {
                                "thresholdsOptions": "icons",
                                "thresholdsGrid": [
                                  {
                                    "operator": "Default",
                                    "thresholdValue": null,
                                    "representation": "AllServices",
                                    "text": "{0}{1}"
                                  }
                                ]
                              }
                            },
                            "leftContent": {
                              "columnMatch": "Count",
                              "formatter": 12,
                              "formatOptions": {
                                "min": 0,
                                "palette": "blue"
                              }
                            },
                            "secondaryContent": {
                              "columnMatch": "Range",
                              "formatter": 1
                            },
                            "showBorder": false
                          },
                          "crossComponentResources": [
                            "{IntuneWorkspace}"
                          ]
                        },
                        "name": "kpi-comp-total",
                        "customWidth": "20"
                      },
                      {
                        "type": 3,
                        "content": {
                          "version": "KqlItem/1.0",
                          "query": "let InventoryLookback = 30d;\nlet InventoryStart = iif({TimeRange:start} < ago(InventoryLookback), {TimeRange:start}, ago(InventoryLookback));\nlet Compliance = IntuneDeviceComplianceOrg\n| where TimeGenerated > InventoryStart\n| summarize arg_max(TimeGenerated, *) by DeviceId\n| extend OSShortName = case(OS =~ \"iOS/iPadOS\", \"iOS/iPadOS\", OS has \"Android\", \"Android\", OS has \"Windows\", \"Windows\", OS =~ \"MacOS\", \"macOS\", isempty(OS), \"Unknown\", \"Other\")\n| where OSShortName in ({ComplianceOS}) or '*' in ({ComplianceOS})\n| extend GraceUntil = todatetime(InGracePeriodUntil)\n| extend InGrace = isnotnull(GraceUntil) and GraceUntil > now() and GraceUntil < datetime(9000-01-01)\n| extend State = case(isempty(ComplianceState), \"Unknown\", ComplianceState);\nCompliance\n| where State =~ \"Compliant\"\n| summarize Count = count()\n| extend Text = \"Compliant\"\n| extend Range = strcat(\"last \", tostring(toint(round((now() - InventoryStart) / 1d, 0))), \" d snapshot\")",
                          "size": 1,
                          "queryType": 0,
                          "resourceType": "microsoft.operationalinsights/workspaces",
