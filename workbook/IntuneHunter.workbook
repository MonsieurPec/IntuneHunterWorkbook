                          "version": "KqlItem/1.0",
                          "query": "let InventoryLookback = 30d;\nlet InventoryStart = iif({TimeRange:start} < ago(InventoryLookback), {TimeRange:start}, ago(InventoryLookback));\nlet Clients = UCClient\n| where TimeGenerated > InventoryStart\n| summarize arg_max(TimeGenerated, Country, OSBuildNumber, OSVersion, DeviceFamily) by AzureADDeviceId\n| project AzureADDeviceId, Country, OSBuildNumber, ClientOSVersion = OSVersion, DeviceFamily;\nlet UpdateErrors = UCUpdateAlert\n| where TimeGenerated {TimeRange}\n| where AlertClassification == \"Error\"\n| where AlertStatus == \"Active\"\n| summarize arg_max(TimeGenerated, *) by AzureADDeviceId, AlertSubtype\n| project TimeGenerated, DeviceName, AzureADDeviceId, AlertSubtype, Description, Recommendation, TargetVersion, UpdateCategory, UpdateClassification\n| join kind=leftouter (Clients) on AzureADDeviceId\n| extend Country = iif(isempty(Country), \"Unknown\", Country);\nUpdateErrors\n| project TimeGenerated, DeviceName, Country, DeviceFamily, ClientOSVersion, OSBuildNumber, AlertSubtype, UpdateCategory, UpdateClassification, TargetVersion, Description, Recommendation\n| sort by TimeGenerated desc",
