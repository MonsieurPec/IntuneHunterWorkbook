                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "let BytesPerGB = 1073741824.0;\nlet DO = UCDOStatus\n| where TimeGenerated {TimeRange}\n| where GroupID in ({DOGroupId}) or '*' in ({DOGroupId})\n| where ContentType in ({DOContentType}) or '*' in ({DOContentType});\nlet Totals = DO\n| summarize CDN = sum(BytesFromCDN), LANPeers = sum(BytesFromPeers), GroupPeers = sum(BytesFromGroupPeers), IntPeers = sum(BytesFromIntPeers), MCC = sum(BytesFromCache), Devices = dcount(DeviceName)\n| extend TotalBytes = CDN + LANPeers + GroupPeers + IntPeers + MCC\n| extend PeerBytes = LANPeers + GroupPeers + IntPeers;\nTotals\n| extend Count = iif(TotalBytes > 0, toint(round(100.0 * MCC / TotalBytes)), 0)\n| extend Text = \"MCC share\"\n| extend Range = \"Connected Cache\"",
                    "size": 1,
