 0, \"Missing\", JustificationLength < MinJustificationLength, \"Too short\", \"Provided\")\n| extend OutsideHours = hourofday(TimeGenerated) < BusinessStart or hourofday(TimeGenerated) >= BusinessEnd or dayofweek(TimeGenerated) in (0d, 6d)\n| where Role in ({PIMRole}) or '*' in ({PIMRole});\nPIMActivations\n| extend NormalisedReason = trim(@\"\\s\", replace_regex(tolower(Justification), @\"[^\\w]+\", \" \"))\n| extend NormalisedReason = iif(isempty(NormalisedReason), \"<no justification>\", NormalisedReason)\n| summarize Activations = count(), Requestors = dcount(Requestor), LastUsed = max(TimeGenerated), RoleSet = make_set(Role, 50) by NormalisedReason, JustificationQuality\n| extend Roles = strcat_array(RoleSet, \", \")\n| project NormalisedReason, JustificationQuality, Activations, Requestors, Roles, LastUsed\n| sort by Activations desc",
