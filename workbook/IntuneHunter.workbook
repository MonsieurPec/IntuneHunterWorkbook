                  "name": "kpi-do-mcc",
                  "customWidth": "20"
                },
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "let BytesPerGB = 1073741824.0;\nlet DO = UCDOStatus\n| where TimeGenerated {TimeRange}\n| where GroupID in ({DOGroupId}) or '*' in ({DOGroupId})\n| where ContentType in ({DOContentType}) or '*' in ({DOContentType});\nlet Totals = DO\n| summarize CDN = sum(BytesFromCDN), LANPeers = sum(BytesFromPeers), GroupPeers = sum(BytesFromGroupPeers), IntPeers = sum(BytesFromIntPeers), MCC = sum(BytesFromCache), Devices = dcount(DeviceName)\n| extend TotalBytes = CDN + LANPeers + GroupPeers + IntPeers + MCC\n| extend PeerBytes = LANPeers + GroupPeers + IntPeers;\nTotals\n| extend Count = iif(TotalBytes > 0, toint(round(100.0 * CDN / TotalBytes)), 0)\n| extend Text = \"CDN share\"\n| extend Range = \"internet egress\"",
                    "size": 1,
                    "queryType": 0,
                    "resourceType": "microsoft.operationalinsights/workspaces",
                    "title": "CDN share",
                    "visualization": "tiles",
                    "timeContextFromParameter": "TimeRange",
                    "tileSettings": {
                      "titleContent": {
                        "columnMatch": "Text",
                        "formatter": 18,
                        "formatOptions": {
                          "thresholdsOptions": "icons",
                          "thresholdsGrid": [
                            {
                              "operator": "Default",
                              "thresholdValue": null,
                              "representation": "3",
                              "text": "{0}{1}"
                            }
                          ]
                        }
                      },
                      "leftContent": {
                        "columnMatch": "Count",
                        "formatter": 12,
                        "formatOptions": {
                          "min": 0,
                          "palette": "orange"
                        }
                      },
                      "secondaryContent": {
                        "columnMatch": "Range",
                        "formatter": 1
                      },
                      "showBorder": false
                    },
                    "crossComponentResources": [
                      "{WufbWorkspace}"
                    ]
                  },
                  "name": "kpi-do-cdn",
                  "customWidth": "20"
                },
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "let BytesPerGB = 1073741824.0;\nlet DO = UCDOStatus\n| where TimeGenerated {TimeRange}\n| where GroupID in ({DOGroupId}) or '*' in ({DOGroupId})\n| where ContentType in ({DOContentType}) or '*' in ({DOContentType});\nlet Totals = DO\n| summarize CDN = sum(BytesFromCDN), LANPeers = sum(BytesFromPeers), GroupPeers = sum(BytesFromGroupPeers), IntPeers = sum(BytesFromIntPeers), MCC = sum(BytesFromCache), Devices = dcount(DeviceName)\n| extend TotalBytes = CDN + LANPeers + GroupPeers + IntPeers + MCC\n| extend PeerBytes = LANPeers + GroupPeers + IntPeers;\nTotals\n| extend Count = Devices\n| extend Text = \"Reporting devices\"\n| extend Range = \"{TimeRange:label}\"",
                    "size": 1,
                    "queryType": 0,
                    "resourceType": "microsoft.operationalinsights/workspaces",
                    "title": "Reporting devices",
                    "visualization": "tiles",
                    "timeContextFromParameter": "TimeRange",
                    "tileSettings": {
                      "titleContent": {
                        "columnMatch": "Text",
                        "formatter": 18,
                        "formatOptions": {
                          "thresholdsOptions": "icons",
                          "thresholdsGrid": [
                            {
                              "operator": "Default",
                              "thresholdValue": null,
                              "representation": "Person",
                              "text": "{0}{1}"
                            }
                          ]
                        }
                      },
                      "leftContent": {
                        "columnMatch": "Count",
                        "formatter": 12,
                        "formatOptions": {
                          "min": 0,
                          "palette": "blue"
                        }
                      },
                      "secondaryContent": {
                        "columnMatch": "Range",
                        "formatter": 1
                      },
                      "showBorder": false
                    },
                    "crossComponentResources": [
                      "{WufbWorkspace}"
                    ]
                  },
                  "name": "kpi-do-devices",
                  "customWidth": "20"
                },
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "let BytesPerGB = 1073741824.0;\nlet DO = UCDOStatus\n| where TimeGenerated {TimeRange}\n| where GroupID in ({DOGroupId}) or '*' in ({DOGroupId})\n| where ContentType in ({DOContentType}) or '*' in ({DOContentType});\nDO\n| summarize CDN = sum(BytesFromCDN), LANPeers = sum(BytesFromPeers), GroupPeers = sum(BytesFromGroupPeers), IntPeers = sum(BytesFromIntPeers), MCC = sum(BytesFromCache) by bin(TimeGenerated, 1d)\n| extend TotalBytes = CDN + LANPeers + GroupPeers + IntPeers + MCC\n| where TotalBytes > 0\n| extend P2P = round(100.0 * (LANPeers + GroupPeers + IntPeers) / TotalBytes, 2), MCCPercent = round(100.0 * MCC / TotalBytes, 2), CDNPercent = round(100.0 * CDN / TotalBytes, 2)\n| project TimeGenerated, P2P, MCCPercent, CDNPercent\n| sort by TimeGenerated asc",
                    "size": 2,
                    "queryType": 0,
                    "resourceType": "microsoft.operationalinsights/workspaces",
                    "title": "Efficiency over time - {TimeRange:label}",
                    "visualization": "linechart",
                    "timeContextFromParameter": "TimeRange",
                    "chartSettings": {
                      "showLegend": false,
                      "seriesLabelSettings": [
                        {
                          "seriesName": "P2P",
                          "color": "green"
                        },
                        {
                          "seriesName": "MCCPercent",
                          "color": "blue"
                        },
                        {
                          "seriesName": "CDNPercent",
                          "color": "orange"
                        }
