                  "name": "table - wipe"
                },
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "let DestructiveOps = dynamic([\"wipe\",\"retire\",\"cleanWindowsDevice\",\"freshStart\",\"eraseDevice\",\"remoteLock\",\"resetPasscode\",\"disable\"]);\nlet InventoryLookback = 30d;\nlet InventoryStart = iif({TimeRange:start} < ago(InventoryLookback), {TimeRange:start}, ago(InventoryLookback));\nlet DeviceLookup = IntuneDevices\n| where TimeGenerated > InventoryStart\n| summarize arg_max(TimeGenerated, DeviceName, UPN, OS, OSVersion, Model, Manufacturer, LastContact) by DeviceId\n| extend InvOS = case(OS =~ \"iOS/iPadOS\", \"iOS/iPadOS\", OS has \"Android\", \"Android\", OS has \"Windows\", \"Windows\", OS =~ \"MacOS\", \"macOS\", \"Other\")\n| project DeviceId, InvDeviceName = DeviceName, UPN, InvOS, OSVersion, Model, Manufacturer, LastContact;\nIntuneAuditLogs\n| where TimeGenerated {TimeRange}\n| where OperationName has_any (DestructiveOps) or (OperationName contains \"Delete ManagedDevice\" and OperationName <> \"Delete ManagedDeviceMobileAppConfiguration\")\n| where OperationName in ({Operation}) or '*' in ({Operation})\n| extend AuditProps = parse_json(Properties)\n| extend ActorUPN = tostring(AuditProps.Actor.UPN)\n| extend ActorApp = tostring(AuditProps.Actor.ApplicationName)\n| extend Actor = case(isnotempty(ActorUPN), ActorUPN, isnotempty(ActorApp), strcat(ActorApp, \" (app)\"), Identity)\n| where Actor in ({Actor}) or '*' in ({Actor})\n| extend DeviceId = tostring(AuditProps.TargetObjectIds[0])\n| extend AuditTargetLabel = tostring(AuditProps.TargetDisplayNames[0])\n| extend AuditEventId = tostring(AuditProps.AuditEventId)\n| extend ActionType = case(OperationName has \"wipe\", \"Wipe\", OperationName has \"eraseDevice\", \"Erase\", OperationName has \"retire\", \"Retire\", OperationName has \"cleanWindowsDevice\", \"Fresh Start\", OperationName has \"freshStart\", \"Fresh Start\", OperationName has \"remoteLock\", \"Remote lock\", OperationName has \"resetPasscode\", \"Passcode reset\", OperationName has \"disable\", \"Disable\", OperationName contains \"Delete ManagedDevice\", \"Device deletion\", OperationName)\n| join kind=leftouter (DeviceLookup) on DeviceId\n| extend NameResolution = iif(isnotempty(InvDeviceName), \"Resolved\", \"Not in inventory\")\n| extend DeviceName = iif(isnotempty(InvDeviceName), InvDeviceName, strcat(\"<unresolved \", DeviceId, \">\"))\n| extend OSShortName = iif(isempty(InvOS), \"Unknown\", InvOS)\n| summarize Actions = count(), LastAction = max(TimeGenerated), ActionTypeSet = make_set(ActionType), ActorSet = make_set(Actor, 50) by DeviceName, UPN, OSShortName, NameResolution\n| extend ActionTypes = strcat_array(ActionTypeSet, \", \"), Actors = strcat_array(ActorSet, \", \")\n| project DeviceName, UPN, OSShortName, NameResolution, Actions, LastAction, ActionTypes, Actors\n| sort by Actions desc, LastAction desc",
                    "size": 0,
                    "queryType": 0,
                    "resourceType": "microsoft.operationalinsights/workspaces",
                    "title": "Per-device summary",
                    "visualization": "table",
                    "timeContextFromParameter": "TimeRange",
                    "showExportToExcel": true,
                    "gridSettings": {
                      "formatters": [
                        {
                          "columnMatch": "NameResolution",
                          "formatter": 18,
                          "formatOptions": {
                            "thresholdsOptions": "icons",
                            "thresholdsGrid": [
                              {
                                "operator": "==",
                                "thresholdValue": "Resolved",
                                "representation": "success",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": "Default",
                                "thresholdValue": null,
                                "representation": "2",
                                "text": "{0}{1}"
                              }
                            ]
                          }
                        },
                        {
                          "columnMatch": "Actions",
                          "formatter": 4,
                          "formatOptions": {
                            "palette": "red"
                          }
                        },
                        {
                          "columnMatch": "ActionTypes",
                          "formatter": 0,
                          "formatOptions": {
                            "customColumnWidthSetting": "2fr"
                          }
                        },
                        {
                          "columnMatch": "Actors",
                          "formatter": 0,
                          "formatOptions": {
                            "customColumnWidthSetting": "2fr"
                          }
                        }
                      ],
                      "filter": true,
                      "rowLimit": 500,
                      "labelSettings": [
                        {
                          "columnId": "DeviceName",
                          "label": "Device name"
                        },
                        {
                          "columnId": "UPN",
                          "label": "Primary user"
                        },
                        {
                          "columnId": "OSShortName",
                          "label": "OS"
                        },
                        {
                          "columnId": "NameResolution",
                          "label": "Name lookup"
                        },
                        {
                          "columnId": "LastAction",
                          "label": "Last action"
                        },
                        {
                          "columnId": "ActionTypes",
                          "label": "Action types"
                        }
                      ]
                    },
                    "crossComponentResources": [
                      "{IntuneWorkspace}"
                    ]
                  },
                  "name": "table - wipe-perdevice",
                  "customWidth": 60
                },
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "let DestructiveOps = dynamic([\"wipe\",\"retire\",\"cleanWindowsDevice\",\"freshStart\",\"eraseDevice\",\"remoteLock\",\"resetPasscode\",\"disable\"]);\nlet InventoryLookback = 30d;\nlet InventoryStart = iif({TimeRange:start} < ago(InventoryLookback), {TimeRange:start}, ago(InventoryLookback));\nlet DeviceLookup = IntuneDevices\n| where TimeGenerated > InventoryStart\n| summarize arg_max(TimeGenerated, DeviceName, UPN, OS, OSVersion, Model, Manufacturer, LastContact) by DeviceId\n| extend InvOS = case(OS =~ \"iOS/iPadOS\", \"iOS/iPadOS\", OS has \"Android\", \"Android\", OS has \"Windows\", \"Windows\", OS =~ \"MacOS\", \"macOS\", \"Other\")\n| project DeviceId, InvDeviceName = DeviceName, UPN, InvOS, OSVersion, Model, Manufacturer, LastContact;\nIntuneAuditLogs\n| where TimeGenerated {TimeRange}\n| where OperationName has_any (DestructiveOps) or (OperationName contains \"Delete ManagedDevice\" and OperationName <> \"Delete ManagedDeviceMobileAppConfiguration\")\n| where OperationName in ({Operation}) or '*' in ({Operation})\n| extend AuditProps = parse_json(Properties)\n| extend ActorUPN = tostring(AuditProps.Actor.UPN)\n| extend ActorApp = tostring(AuditProps.Actor.ApplicationName)\n| extend Actor = case(isnotempty(ActorUPN), ActorUPN, isnotempty(ActorApp), strcat(ActorApp, \" (app)\"), Identity)\n| where Actor in ({Actor}) or '*' in ({Actor})\n| extend DeviceId = tostring(AuditProps.TargetObjectIds[0])\n| extend AuditTargetLabel = tostring(AuditProps.TargetDisplayNames[0])\n| extend AuditEventId = tostring(AuditProps.AuditEventId)\n| extend ActionType = case(OperationName has \"wipe\", \"Wipe\", OperationName has \"eraseDevice\", \"Erase\", OperationName has \"retire\", \"Retire\", OperationName has \"cleanWindowsDevice\", \"Fresh Start\", OperationName has \"freshStart\", \"Fresh Start\", OperationName has \"remoteLock\", \"Remote lock\", OperationName has \"resetPasscode\", \"Passcode reset\", OperationName has \"disable\", \"Disable\", OperationName contains \"Delete ManagedDevice\", \"Device deletion\", OperationName)\n| join kind=leftouter (DeviceLookup) on DeviceId\n| extend NameResolution = iif(isnotempty(InvDeviceName), \"Resolved\", \"Not in inventory\")\n| extend DeviceName = iif(isnotempty(InvDeviceName), InvDeviceName, strcat(\"<unresolved \", DeviceId, \">\"))\n| extend OSShortName = iif(isempty(InvOS), \"Unknown\", InvOS)\n| where ActionType in (\"Wipe\", \"Erase\", \"Retire\")\n| summarize ActionCount = count(), DeviceSet = make_set(DeviceName, 200) by Actor, bin(TimeGenerated, 15m)\n| where ActionCount >= 3\n| extend Devices = strcat_array(DeviceSet, \", \")\n| project TimeGenerated, Actor, ActionCount, Devices\n| sort by ActionCount desc",
                    "size": 0,
                    "queryType": 0,
                    "resourceType": "microsoft.operationalinsights/workspaces",
                    "title": "Potential bursts (3+ wipe/retire per 15 min by actor)",
                    "visualization": "table",
                    "timeContextFromParameter": "TimeRange",
                    "showExportToExcel": true,
                    "gridSettings": {
                      "formatters": [
                        {
                          "columnMatch": "Actor",
                          "formatter": 18,
                          "formatOptions": {
                            "thresholdsOptions": "icons",
                            "thresholdsGrid": [
                              {
                                "operator": "contains",
                                "thresholdValue": "(app)",
                                "representation": "Gear",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": "Default",
                                "thresholdValue": null,
                                "representation": "Person",
                                "text": "{0}{1}"
                              }
                            ],
                            "customColumnWidthSetting": "34ch"
                          }
                        },
                        {
                          "columnMatch": "ActionCount",
                          "formatter": 4,
                          "formatOptions": {
                            "palette": "red",
                            "customColumnWidthSetting": "12ch"
                          }
                        },
                        {
                          "columnMatch": "Devices",
                          "formatter": 0,
                          "formatOptions": {
                            "customColumnWidthSetting": "3fr"
                          }
                        }
                      ],
                      "filter": true,
                      "labelSettings": [
                        {
                          "columnId": "TimeGenerated",
                          "label": "Window (15 min)"
                        },
                        {
                          "columnId": "ActionCount",
                          "label": "Actions"
                        },
                        {
                          "columnId": "Devices",
                          "label": "Devices affected"
                        }
                      ]
                    },
                    "crossComponentResources": [
                      "{IntuneWorkspace}"
                    ]
                  },
                  "name": "table - wipe-burst",
                  "customWidth": 40
                }
              ]
            },
            "conditionalVisibility": {
              "parameterName": "AuditSection",
              "comparison": "isEqualTo",
              "value": "Wipe"
            },
            "name": "group - wipe",
            "styleSettings": {
              "showBorder": false,
              "padding": "10px"
            }
          },
          {
            "type": 12,
            "content": {
              "version": "NotebookGroup/1.0",
              "groupType": "editable",
              "items": [
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
