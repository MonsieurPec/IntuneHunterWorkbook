                      {
                        "type": 3,
                        "content": {
                          "version": "KqlItem/1.0",
                          "query": "let ESPDuration = IntuneOperationalLogs\n| where TimeGenerated {TimeRange}\n| where OperationName == \"ESPEnrollment\"\n| where Properties has \"EspSlaIsDeviceSyncDone\"\n| extend P = todynamic(Properties)\n| where tostring(P.EventId) == \"EspSlaIsDeviceSyncDone\"\n| where tostring(P.Scope) == \"DeviceEspE2E\"\n| where tostring(P.IsAutopilot) =~ \"true\"\n| extend ManagedDeviceId = tostring(P.DeviceId)\n| extend Time_Seconds = toreal(P.TimeDiff), Status = tostring(P.Status)\n| where isnotempty(Time_Seconds)\n// Latest ESP result per device\n| summarize arg_max(TimeGenerated, Status) by ManagedDeviceId\n| extend Outcome = iff(Status =~ \"Completed\", \"Success\", \"Failure\");\nESPDuration\n// One column per outcome so the workbook builds one series per column\n| summarize\n    Success = countif(Outcome == \"Success\"),\n    Failure = countif(Outcome == \"Failure\")\n    by TimeGenerated = bin(TimeGenerated, 1d)\n| sort by TimeGenerated asc",
                          "size": 2,
                          "queryType": 0,
                          "resourceType": "microsoft.operationalinsights/workspaces",
                          "title": "ESP success vs failure by day - {TimeRange:label}",
                          "visualization": "linechart",
                          "timeContextFromParameter": "TimeRange",
                          "chartSettings": {
                            "showLegend": false,
                            "seriesLabelSettings": [
                              {
                                "seriesName": "Success",
                                "color": "green"
                              },
                              {
                                "seriesName": "Failure",
                                "color": "red"
                              }
                            ]
                          },
                          "crossComponentResources": [
                            "{IntuneWorkspace}"
                          ]
                        },
                        "name": "chart - ap-espSuccessVSFaillure",
                        "customWidth": "50",
                        "styleSettings": {}
                      },
                      {
                        "type": 3,
                        "content": {
                          "version": "KqlItem/1.0",
                          "query": "let ESPDuration = IntuneOperationalLogs\n| where TimeGenerated {TimeRange}\n| where OperationName == \"ESPEnrollment\"\n| where Properties has \"EspSlaIsDeviceSyncDone\"\n| extend P = todynamic(Properties)\n| extend EventId = tostring(P.EventId)\n| where EventId == \"EspSlaIsDeviceSyncDone\"\n| extend Scope = tostring(P.Scope)\n| where Scope == \"DeviceEspE2E\"\n| extend ManagedDeviceId = tostring(P.DeviceId)\n| extend Time_Seconds = toreal(P.TimeDiff)\n| extend Status = tostring(P.Status)\n| extend IsAutopilot = tostring(P.IsAutopilot)\n| where IsAutopilot =~ \"true\"\n| where isnotempty(Time_Seconds)\n| summarize arg_max(TimeGenerated, Time_Seconds, Status) by ManagedDeviceId\n| extend Outcome = iff(Status =~ \"Completed\", \"Success\", \"Failure\");\nESPDuration\n| where Outcome == \"Success\"\n| summarize AvgSeconds = avg(Time_Seconds) by TimeGenerated = bin(TimeGenerated, 1d)\n| extend AvgMinutes = round(AvgSeconds / 60.0, 1)\n| extend AvgDurationText = format_timespan(AvgSeconds * 1s, 'hh:mm:ss')\n| project TimeGenerated, AvgMinutes\n| sort by TimeGenerated desc",
                          "size": 2,
                          "queryType": 0,
