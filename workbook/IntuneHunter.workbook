          {
            "type": 12,
            "content": {
              "version": "NotebookGroup/1.0",
              "groupType": "editable",
              "items": [
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "IntuneAuditLogs\n| where TimeGenerated {TimeRange}\n| where not(OperationName matches regex \"(?i)^Sync\")\n| where OperationName in ({Operation}) or '*' in ({Operation})\n| extend AuditProps = parse_json(Properties)\n| extend ActorUPN = tostring(AuditProps.Actor.UPN)\n| extend ActorApp = tostring(AuditProps.Actor.ApplicationName)\n| extend Actor = case(isnotempty(ActorUPN), ActorUPN, isnotempty(ActorApp), strcat(ActorApp, \" (app)\"), Identity)\n| where Actor in ({Actor}) or '*' in ({Actor})\n| extend Object = tostring(AuditProps.TargetDisplayNames[0])\n| extend ObjectId = tostring(AuditProps.TargetObjectIds[0])\n| extend AuditEventId = tostring(AuditProps.AuditEventId)\n| extend IsDelegatedAdmin = tostring(AuditProps.Actor.IsDelegatedAdmin)\n| project TimeGenerated, Actor, IsDelegatedAdmin, OperationName, Object, ObjectId, ResultType, AuditEventId\n| sort by TimeGenerated desc",
                    "size": 0,
                    "queryType": 0,
                    "resourceType": "microsoft.operationalinsights/workspaces",
                    "title": "Raw events",
                    "visualization": "table",
                    "timeContextFromParameter": "TimeRange",
                    "showExportToExcel": true,
                    "gridSettings": {
                      "formatters": [
                        {
                          "columnMatch": "Actor",
                          "formatter": 18,
                          "formatOptions": {
                            "thresholdsOptions": "icons",
                            "thresholdsGrid": [
                              {
                                "operator": "contains",
                                "thresholdValue": "(app)",
                                "representation": "Gear",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": "Default",
                                "thresholdValue": null,
                                "representation": "Person",
                                "text": "{0}{1}"
                              }
                            ]
                          }
                        },
                        {
                          "columnMatch": "OperationName",
                          "formatter": 18,
                          "formatOptions": {
                            "thresholdsOptions": "icons",
                            "thresholdsGrid": [
                              {
                                "operator": "contains",
                                "thresholdValue": "wipe",
                                "representation": "2",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": "contains",
                                "thresholdValue": "eraseDevice",
                                "representation": "2",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": "contains",
                                "thresholdValue": "retire",
                                "representation": "Discard",
                                "text": "{0}{1}"
                              },
