                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "let InventoryLookback = 30d;\nlet InventoryStart = iif({TimeRange:start} < ago(InventoryLookback), {TimeRange:start}, ago(InventoryLookback));\nlet DeviceLookup = IntuneDevices\n| where TimeGenerated > InventoryStart\n| summarize arg_max(TimeGenerated, DeviceName, UPN, OS, Model, SerialNumber, LastContact) by DeviceId\n| extend InvOS = case(OS =~ \"iOS/iPadOS\", \"iOS/iPadOS\", OS has \"Android\", \"Android\", OS has \"Windows\", \"Windows\", OS =~ \"MacOS\", \"macOS\", \"Other\")\n| project DeviceId, InvDeviceName = DeviceName, UPN, InvOS, Model, SerialNumber, LastContact;\nIntuneAuditLogs\n| where TimeGenerated {TimeRange}\n| where OperationName contains \"ManagedDevice\"\n| where OperationName <> \"Delete ManagedDeviceMobileAppConfiguration\"\n| where OperationName in ({Operation}) or '*' in ({Operation})\n| extend AuditProps = parse_json(Properties)\n| extend ActorUPN = tostring(AuditProps.Actor.UPN)\n| extend ActorApp = tostring(AuditProps.Actor.ApplicationName)\n| extend Actor = case(isnotempty(ActorUPN), ActorUPN, isnotempty(ActorApp), strcat(ActorApp, \" (app)\"), Identity)\n| where Actor in ({Actor}) or '*' in ({Actor})\n| extend DeviceId = tostring(AuditProps.TargetObjectIds[0])\n| where isnotempty(DeviceId)\n| join kind=leftouter (DeviceLookup) on DeviceId\n| extend NameResolution = iif(isnotempty(InvDeviceName), \"Resolved\", \"Not in inventory\")\n| extend DeviceName = iif(isnotempty(InvDeviceName), InvDeviceName, strcat(\"<unresolved \", DeviceId, \">\"))\n| extend OSShortName = iif(isempty(InvOS), \"Unknown\", InvOS)\n| where OSShortName in ({OS}) or '*' in ({OS})\n| project TimeGenerated, Actor, OperationName, DeviceName, UPN, OSShortName, ResultType, SerialNumber, Model, LastContact, NameResolution\n| sort by TimeGenerated desc",
                    "size": 0,
                    "queryType": 0,
                    "resourceType": "microsoft.operationalinsights/workspaces",
                    "title": "Device action details",
