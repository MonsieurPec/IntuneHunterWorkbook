                            "max": 100
                          }
                        }
                      ],
                      "labelSettings": [
                        {
                          "columnId": "GroupID",
                          "label": "DO group ID"
                        },
                        {
                          "columnId": "TotalGB",
                          "label": "Total (GB)"
                        },
                        {
