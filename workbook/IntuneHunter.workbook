                  },
                  "name": "tiles - top-operations"
                },
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "let Filtered = IntuneAuditLogs\n| where TimeGenerated {TimeRange}\n| where not(OperationName matches regex \"(?i)^Sync\")\n| where OperationName in ({Operation}) or '*' in ({Operation})\n| extend AuditProps = parse_json(Properties)\n| extend ActorUPN = tostring(AuditProps.Actor.UPN)\n| extend ActorApp = tostring(AuditProps.Actor.ApplicationName)\n| extend Actor = case(isnotempty(ActorUPN), ActorUPN, isnotempty(ActorApp), strcat(ActorApp, \" (app)\"), Identity)\n| where Actor in ({Actor}) or '*' in ({Actor})\n| extend Object = tostring(AuditProps.TargetDisplayNames[0])\n| extend EventId = tostring(AuditProps.AuditEventId);\nFiltered\n| summarize Events = dcount(EventId) by OperationName\n| top {TopN} by Events desc",
                    "size": 2,
                    "queryType": 0,
                    "resourceType": "microsoft.operationalinsights/workspaces",
                    "title": "Volume by operation",
                    "visualization": "barchart",
                    "crossComponentResources": [
                      "{IntuneWorkspace}"
                    ],
                    "chartSettings": {
                      "showLegend": false
                    }
                  },
                  "name": "chart - top-operations-bar",
                  "customWidth": "50"
                },
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "let Filtered = IntuneAuditLogs\n| where TimeGenerated {TimeRange}\n| where not(OperationName matches regex \"(?i)^Sync\")\n| where OperationName in ({Operation}) or '*' in ({Operation})\n| extend AuditProps = parse_json(Properties)\n| extend ActorUPN = tostring(AuditProps.Actor.UPN)\n| extend ActorApp = tostring(AuditProps.Actor.ApplicationName)\n| extend Actor = case(isnotempty(ActorUPN), ActorUPN, isnotempty(ActorApp), strcat(ActorApp, \" (app)\"), Identity)\n| where Actor in ({Actor}) or '*' in ({Actor})\n| extend Object = tostring(AuditProps.TargetDisplayNames[0])\n| extend EventId = tostring(AuditProps.AuditEventId);\nlet TopOps = toscalar(Filtered | summarize Events = count() by OperationName | top {TopN} by Events desc | summarize make_set(OperationName));\nFiltered\n| where set_has_element(TopOps, OperationName)\n| make-series Trend = count() default = 0 on TimeGenerated from {TimeRange:start} to {TimeRange:end} step {TimeRange:grain} by OperationName",
                    "size": 2,
                    "queryType": 0,
                    "resourceType": "microsoft.operationalinsights/workspaces",
                    "title": "Trend of the 5 dominant operations",
                    "visualization": "linechart",
                    "timeContextFromParameter": "TimeRange",
                    "chartSettings": {
                      "showLegend": true
                    },
                    "crossComponentResources": [
                      "{IntuneWorkspace}"
                    ]
                  },
                  "name": "chart - top-operations-trend",
                  "customWidth": "50"
                },
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "let Filtered = IntuneAuditLogs\n| where TimeGenerated {TimeRange}\n| where not(OperationName matches regex \"(?i)^Sync\")\n| where OperationName in ({Operation}) or '*' in ({Operation})\n| extend AuditProps = parse_json(Properties)\n| extend ActorUPN = tostring(AuditProps.Actor.UPN)\n| extend ActorApp = tostring(AuditProps.Actor.ApplicationName)\n| extend Actor = case(isnotempty(ActorUPN), ActorUPN, isnotempty(ActorApp), strcat(ActorApp, \" (app)\"), Identity)\n| where Actor in ({Actor}) or '*' in ({Actor})\n| extend Object = tostring(AuditProps.TargetDisplayNames[0])\n| extend EventId = tostring(AuditProps.AuditEventId);\nlet TotalEvents = toscalar(Filtered | summarize dcount(EventId));\nFiltered\n| summarize Events = dcount(EventId), Actors = dcount(Actor), Objects = dcount(Object) by OperationName\n| extend Share = round(100.0 * Events / TotalEvents, 1)\n| top {TopN} by Events desc",
                    "size": 0,
                    "queryType": 0,
                    "resourceType": "microsoft.operationalinsights/workspaces",
                    "title": "Ranking detail",
                    "visualization": "table",
                    "timeContextFromParameter": "TimeRange",
                    "showExportToExcel": true,
                    "gridSettings": {
                      "formatters": [
                        {
                          "columnMatch": "OperationName",
                          "formatter": 18,
                          "formatOptions": {
                            "thresholdsOptions": "icons",
                            "thresholdsGrid": [
                              {
                                "operator": "contains",
                                "thresholdValue": "wipe",
                                "representation": "2",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": "contains",
                                "thresholdValue": "eraseDevice",
                                "representation": "2",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": "contains",
                                "thresholdValue": "retire",
                                "representation": "Discard",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": "contains",
                                "thresholdValue": "cleanWindowsDevice",
                                "representation": "Reimage",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": "contains",
                                "thresholdValue": "freshStart",
                                "representation": "Reimage",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": "contains",
                                "thresholdValue": "remoteLock",
                                "representation": "Alert",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": "contains",
                                "thresholdValue": "resetPasscode",
                                "representation": "Refresh",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": "contains",
                                "thresholdValue": "Delete",
                                "representation": "Delete",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": "contains",
                                "thresholdValue": "Create",
                                "representation": "Code",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": "contains",
