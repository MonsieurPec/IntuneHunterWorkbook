          {
            "type": 12,
            "content": {
              "version": "NotebookGroup/1.0",
              "groupType": "editable",
              "items": [
                {
                  "type": 9,
                  "content": {
                    "version": "KqlParameterItem/1.0",
                    "parameters": [
                      {
                        "id": "e1000000-0000-0000-0000-000000000001",
                        "version": "KqlParameterItem/1.0",
                        "name": "BitlockerActorType",
                        "label": "Actor type",
                        "type": 2,
                        "multiSelect": true,
                        "quote": "'",
                        "delimiter": ",",
                        "query": "AuditLogs\n| where TimeGenerated {TimeRange}\n| where OperationName == \"Read BitLocker key\"\n| extend ActorType = case(\n    isnotempty(InitiatedBy[\"app\"]), \"Application\",\n    isnotempty(InitiatedBy[\"user\"]), \"User\",\n    \"Unknown\")\n| distinct ActorType\n| order by ActorType asc",
                        "typeSettings": {
                          "additionalResourceOptions": [
                            "value::all"
                          ],
                          "showDefault": false
                        },
                        "defaultValue": "User",
                        "timeContext": {
                          "durationMs": 0
                        },
                        "timeContextFromParameter": "TimeRange",
                        "queryType": 0,
                        "resourceType": "microsoft.operationalinsights/workspaces",
                        "crossComponentResources": [
                          "{EntraWorkspace}"
                        ]
                      }
                    ],
                    "style": "pills"
                  },
                  "name": "params - bitlocker"
                },
                {
                  "type": 3,
                  "content": {
