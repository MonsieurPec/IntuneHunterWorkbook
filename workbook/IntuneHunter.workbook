 0, \"Missing\", JustificationLength < MinJustificationLength, \"Too short\", \"Provided\")\n| extend OutsideHours = hourofday(TimeGenerated) < BusinessStart or hourofday(TimeGenerated) >= BusinessEnd or dayofweek(TimeGenerated) in (0d, 6d)\n| where Role in ({PIMRole}) or '*' in ({PIMRole});\nPIMActivations\n| where isnotempty(Role)\n| summarize RolesActivated = dcount(Role), Activations = count(), RoleSet = make_set(Role, 50) by Requestor, bin(TimeGenerated, 1h)\n| where RolesActivated >= 2\n| extend Roles = strcat_array(RoleSet, \", \")\n| project TimeGenerated, Requestor, RolesActivated, Activations, Roles\n| sort by RolesActivated desc, Activations desc",
