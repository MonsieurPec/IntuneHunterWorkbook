          {
            "type": 12,
            "content": {
              "version": "NotebookGroup/1.0",
              "groupType": "editable",
              "items": [
                {
                  "type": 9,
                  "content": {
                    "version": "KqlParameterItem/1.0",
                    "parameters": [
                      {
                        "id": "g1000000-0000-0000-0000-000000000001",
                        "version": "KqlParameterItem/1.0",
                        "name": "DOGroupId",
                        "label": "DO group",
                        "type": 2,
                        "multiSelect": true,
                        "quote": "'",
                        "delimiter": ",",
                        "query": "UCDOStatus\n| where TimeGenerated {TimeRange}\n| where isnotempty(GroupID)\n| summarize Bytes = sum(BytesFromCDN) + sum(BytesFromPeers) + sum(BytesFromGroupPeers) + sum(BytesFromIntPeers) + sum(BytesFromCache) by GroupID\n| top 100 by Bytes desc\n| project GroupID",
                        "typeSettings": {
                          "additionalResourceOptions": [
                            "value::all"
                          ],
                          "showDefault": false
                        },
                        "defaultValue": "value::all",
                        "timeContext": {
                          "durationMs": 0
                        },
                        "timeContextFromParameter": "TimeRange",
                        "queryType": 0,
                        "resourceType": "microsoft.operationalinsights/workspaces",
                        "crossComponentResources": [
                          "{WufbWorkspace}"
                        ]
                      },
                      {
                        "id": "g1000000-0000-0000-0000-000000000002",
                        "version": "KqlParameterItem/1.0",
                        "name": "DOContentType",
                        "label": "Content type",
                        "type": 2,
                        "multiSelect": true,
                        "quote": "'",
                        "delimiter": ",",
                        "query": "UCDOStatus\n| where TimeGenerated {TimeRange}\n| distinct ContentType\n| order by ContentType asc",
                        "typeSettings": {
                          "additionalResourceOptions": [
                            "value::all"
                          ],
                          "showDefault": false
                        },
                        "defaultValue": "value::all",
                        "timeContext": {
                          "durationMs": 0
                        },
                        "timeContextFromParameter": "TimeRange",
                        "queryType": 0,
                        "resourceType": "microsoft.operationalinsights/workspaces",
                        "crossComponentResources": [
                          "{WufbWorkspace}"
                        ]
                      }
                    ],
                    "style": "pills"
                  },
                  "name": "params - do"
                },
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "let BytesPerGB = 1073741824.0;\nlet DO = UCDOStatus\n| where TimeGenerated {TimeRange}\n| where GroupID in ({DOGroupId}) or '*' in ({DOGroupId})\n| where ContentType in ({DOContentType}) or '*' in ({DOContentType});\nlet Totals = DO\n| summarize CDN = sum(BytesFromCDN), LANPeers = sum(BytesFromPeers), GroupPeers = sum(BytesFromGroupPeers), IntPeers = sum(BytesFromIntPeers), MCC = sum(BytesFromCache), Devices = dcount(DeviceName)\n| extend TotalBytes = CDN + LANPeers + GroupPeers + IntPeers + MCC\n| extend PeerBytes = LANPeers + GroupPeers + IntPeers;\nTotals\n| extend Count = toint(round(TotalBytes / BytesPerGB))\n| extend Text = \"Total volume (GB)\"\n| extend Range = \"{TimeRange:label}\"",
                    "size": 1,
                    "queryType": 0,
                    "resourceType": "microsoft.operationalinsights/workspaces",
                    "title": "Total volume",
                    "visualization": "tiles",
                    "timeContextFromParameter": "TimeRange",
                    "tileSettings": {
                      "titleContent": {
                        "columnMatch": "Text",
                        "formatter": 18,
                        "formatOptions": {
                          "thresholdsOptions": "icons",
                          "thresholdsGrid": [
                            {
                              "operator": "Default",
                              "thresholdValue": null,
                              "representation": "AllServices",
                              "text": "{0}{1}"
                            }
                          ]
                        }
                      },
                      "leftContent": {
                        "columnMatch": "Count",
                        "formatter": 12,
                        "formatOptions": {
                          "min": 0,
                          "palette": "blue"
                        }
                      },
                      "secondaryContent": {
                        "columnMatch": "Range",
                        "formatter": 1
                      },
                      "showBorder": false
                    },
                    "crossComponentResources": [
                      "{WufbWorkspace}"
                    ]
                  },
                  "name": "kpi-do-total",
                  "customWidth": "20"
                },
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "let BytesPerGB = 1073741824.0;\nlet DO = UCDOStatus\n| where TimeGenerated {TimeRange}\n| where GroupID in ({DOGroupId}) or '*' in ({DOGroupId})\n| where ContentType in ({DOContentType}) or '*' in ({DOContentType});\nlet Totals = DO\n| summarize CDN = sum(BytesFromCDN), LANPeers = sum(BytesFromPeers), GroupPeers = sum(BytesFromGroupPeers), IntPeers = sum(BytesFromIntPeers), MCC = sum(BytesFromCache), Devices = dcount(DeviceName)\n| extend TotalBytes = CDN + LANPeers + GroupPeers + IntPeers + MCC\n| extend PeerBytes = LANPeers + GroupPeers + IntPeers;\nTotals\n| extend Count = iif(TotalBytes > 0, toint(round(100.0 * PeerBytes / TotalBytes)), 0)\n| extend Text = \"P2P share\"\n| extend Range = \"LAN + group + internet\"",
                    "size": 1,
