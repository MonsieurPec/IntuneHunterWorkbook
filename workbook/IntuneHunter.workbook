{
  "version": "Notebook/1.0",
  "items": [
    {
      "type": 1,
      "content": {
        "json": "# Intune Hunter"
      },
      "name": "text - header"
    },
    {
      "type": 9,
      "content": {
        "version": "KqlParameterItem/1.0",
        "parameters": [
          {
            "id": "e1000001-0000-0000-0000-000000000001",
            "version": "KqlParameterItem/1.0",
            "name": "IntuneSubscription",
            "label": "Intune logs - Subscription",
            "type": 6,
            "isRequired": true,
            "value": "/subscriptions/<your-subscription-id>",
            "typeSettings": {
              "additionalResourceOptions": [],
              "showDefault": false
            },
            "timeContext": {
              "durationMs": 0
            }
          },
          {
            "id": "e1000002-0000-0000-0000-000000000002",
            "version": "KqlParameterItem/1.0",
            "name": "IntuneWorkspace",
            "label": "Intune logs - Workspace",
            "type": 5,
            "isRequired": true,
            "query": "resources\n| where type =~ 'microsoft.operationalinsights/workspaces'\n| project id, name\n| order by name asc",
            "value": "/subscriptions/<your-subscription-id>/resourceGroups/<your-resource-group>/providers/Microsoft.OperationalInsights/workspaces/<your-workspace-name>",
            "crossComponentResources": [
              "{IntuneSubscription}"
            ],
