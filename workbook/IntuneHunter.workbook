                    "query": "let ExcludedOperationPatterns = dynamic([\"^Sync\",\"ManagedDevice\",\"decrypt\",\"ClientCertificate\",\"WindowsAutopilotDeviceIdentity\",\"Assignment\"]);\nlet ExcludedRegex = strcat(\"(?i)\", strcat_array(ExcludedOperationPatterns, \"|\"));\nIntuneAuditLogs\n| where TimeGenerated {TimeRange}\n| where not(OperationName matches regex ExcludedRegex)\n| where OperationName in ({Operation}) or '*' in ({Operation})\n| extend AuditProps = parse_json(Properties)\n| extend ActorUPN = tostring(AuditProps.Actor.UPN)\n| extend ActorApp = tostring(AuditProps.Actor.ApplicationName)\n| extend Actor = case(isnotempty(ActorUPN), ActorUPN, isnotempty(ActorApp), strcat(ActorApp, \" (app)\"), Identity)\n| where Actor in ({Actor}) or '*' in ({Actor})\n| extend Object = tostring(AuditProps.TargetDisplayNames[0])\n| mv-expand Target = AuditProps.Targets\n| mv-expand ModifiedProperty = Target.ModifiedProperties\n| extend PropertyName = tostring(ModifiedProperty.Name), OldValue = tostring(ModifiedProperty.Old), NewValue = tostring(ModifiedProperty.New)\n| where isnotempty(PropertyName) and PropertyName != \"DeviceManagementAPIVersion\" \n| where Object <> \"<null>\" and isnotempty(Object)\n| summarize Changes = dcount(tostring(AuditProps.AuditEventId)) by Object\n| top 10 by Changes desc",
