                      ]
                    },
                    "crossComponentResources": [
                      "{WufbWorkspace}"
                    ]
                  },
                  "name": "table - do-groups",
                  "customWidth": 65
                },
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "let BytesPerGB = 1073741824.0;\nlet DO = UCDOStatus\n| where TimeGenerated {TimeRange}\n| where GroupID in ({DOGroupId}) or '*' in ({DOGroupId})\n| where ContentType in ({DOContentType}) or '*' in ({DOContentType});\nDO\n| where isnotnull(CacheNodeDetails) and array_length(CacheNodeDetails) > 0\n| mv-expand CacheNodeDetail = CacheNodeDetails\n| extend CacheNodeId = tostring(CacheNodeDetail.Id), CacheNodeDate = todatetime(CacheNodeDetail.Date), CacheNodeBytes = tolong(CacheNodeDetail.Bytes)\n| where isnotempty(CacheNodeId)\n| summarize MCCVolumeGB = round(sum(CacheNodeBytes) / BytesPerGB, 2), Devices = dcount(DeviceName), LastSeen = max(CacheNodeDate) by CacheNodeId\n| sort by MCCVolumeGB desc",
                    "size": 0,
                    "queryType": 0,
                    "resourceType": "microsoft.operationalinsights/workspaces",
                    "title": "MCC server usage",
                    "visualization": "table",
                    "timeContextFromParameter": "TimeRange",
                    "showExportToExcel": true,
                    "gridSettings": {
                      "filter": true,
                      "rowLimit": 500,
                      "formatters": [
                        {
                          "columnMatch": "MCCVolumeGB",
                          "formatter": 4,
                          "formatOptions": {
                            "palette": "blue"
                          }
                        },
                        {
                          "columnMatch": "Devices",
                          "formatter": 4,
                          "formatOptions": {
                            "palette": "green"
                          }
                        }
                      ],
                      "labelSettings": [
                        {
                          "columnId": "CacheNodeId",
                          "label": "MCC server (cache node)"
                        },
                        {
                          "columnId": "MCCVolumeGB",
                          "label": "Volume served (GB)"
                        },
                        {
                          "columnId": "Devices",
                          "label": "Devices served"
                        },
                        {
                          "columnId": "LastSeen",
                          "label": "Last seen"
                        }
                      ]
                    },
                    "crossComponentResources": [
                      "{WufbWorkspace}"
                    ]
                  },
                  "name": "table - do-mcc-nodes",
                  "customWidth": 35
                },
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "let BytesPerGB = 1073741824.0;\nlet InventoryLookback = 30d;\nlet InventoryStart = iif({TimeRange:start} < ago(InventoryLookback), {TimeRange:start}, ago(InventoryLookback));\nlet DeviceLookup = workspace('{IntuneWorkspace}').IntuneDevices\n| where TimeGenerated > InventoryStart\n| where isnotempty(ReferenceId)\n| summarize arg_max(TimeGenerated, SerialNumber) by AzureADDeviceId = ReferenceId\n| project AzureADDeviceId, SerialNumber;\nlet DO = UCDOStatus\n| where TimeGenerated {TimeRange}\n| where GroupID in ({DOGroupId}) or '*' in ({DOGroupId})\n| where ContentType in ({DOContentType}) or '*' in ({DOContentType});\nDO\n| summarize CDN = sum(BytesFromCDN), LANPeers = sum(BytesFromPeers), GroupPeers = sum(BytesFromGroupPeers), IntPeers = sum(BytesFromIntPeers), MCC = sum(BytesFromCache), arg_max(TimeGenerated, DownloadMode, DownloadModeSrc, PeeringStatus, Country, City, GroupID, AzureADDeviceId) by DeviceName\n| extend TotalBytes = CDN + LANPeers + GroupPeers + IntPeers + MCC\n| where TotalBytes > 0\n| extend TotalGB = round(TotalBytes / BytesPerGB, 2)\n| extend P2PPercent = round(100.0 * (LANPeers + GroupPeers + IntPeers) / TotalBytes, 2)\n| extend MCCPercent = round(100.0 * MCC / TotalBytes, 2)\n| extend CDNPercent = round(100.0 * CDN / TotalBytes, 2)\n| join kind=leftouter (DeviceLookup) on AzureADDeviceId\n| project DeviceName, TotalGB, CDNPercent, P2PPercent, MCCPercent, SerialNumber, DownloadMode, DownloadModeSrc, PeeringStatus, Country, City, GroupID, TimeGenerated\n| sort by CDNPercent desc, TotalGB desc",
                    "size": 0,
                    "queryType": 0,
                    "resourceType": "microsoft.operationalinsights/workspaces",
                    "title": "Least efficient devices",
                    "visualization": "table",
                    "timeContextFromParameter": "TimeRange",
                    "showExportToExcel": true,
                    "gridSettings": {
                      "filter": true,
                      "rowLimit": 1000,
                      "formatters": [
                        {
                          "columnMatch": "CDNPercent",
                          "formatter": 4,
                          "formatOptions": {
                            "palette": "orange",
                            "min": 0,
                            "max": 100
                          }
                        },
                        {
                          "columnMatch": "P2PPercent",
                          "formatter": 4,
                          "formatOptions": {
                            "palette": "green",
                            "min": 0,
                            "max": 100
                          }
                        },
                        {
                          "columnMatch": "TotalGB",
                          "formatter": 4,
                          "formatOptions": {
                            "palette": "blue"
                          }
                        }
                      ],
                      "labelSettings": [
                        {
                          "columnId": "DeviceName",
                          "label": "Device name"
                        },
                        {
                          "columnId": "TotalGB",
                          "label": "Total (GB)"
                        },
                        {
                          "columnId": "CDNPercent",
                          "label": "CDN (%)"
                        },
                        {
                          "columnId": "P2PPercent",
                          "label": "P2P (%)"
                        },
                        {
                          "columnId": "MCCPercent",
                          "label": "MCC (%)"
                        },
                        {
                          "columnId": "DownloadMode",
                          "label": "Download mode"
                        },
                        {
                          "columnId": "DownloadModeSrc",
                          "label": "Mode source"
                        },
                        {
                          "columnId": "PeeringStatus",
                          "label": "Peering"
                        },
                        {
                          "columnId": "GroupID",
                          "label": "DO group ID"
                        },
                        {
                          "columnId": "TimeGenerated",
                          "label": "Last snapshot"
                        }
                      ]
                    },
                    "crossComponentResources": [
                      "{WufbWorkspace}"
                    ]
                  },
                  "name": "table - do-devices"
                }
              ]
            },
            "conditionalVisibility": {
              "parameterName": "InvTab",
              "comparison": "isEqualTo",
              "value": "DeliveryOpt"
            },
            "name": "group - deliveryopt",
            "styleSettings": {
              "showBorder": false,
              "padding": "10px"
            }
          }
        ]
      },
      "conditionalVisibility": {
        "parameterName": "Tab",
        "comparison": "isEqualTo",
        "value": "Inventory"
      },
      "name": "group - inventory-root",
      "styleSettings": {
        "showBorder": true,
        "padding": "10px"
      }
    },
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 11,
            "content": {
              "version": "LinkItem/1.0",
              "style": "tabs",
              "links": [
                {
                  "id": "f0000004-0000-0000-0000-000000000004",
                  "cellValue": "AboutSection",
                  "linkTarget": "parameter",
                  "linkLabel": "Data feeds",
                  "subTarget": "Feeds",
                  "style": "link"
                },
                {
                  "id": "f0000003-0000-0000-0000-000000000003",
                  "cellValue": "AboutSection",
                  "linkTarget": "parameter",
                  "linkLabel": "Navigation",
                  "subTarget": "Navigation",
                  "style": "link"
                },
                {
                  "id": "f0000001-0000-0000-0000-000000000001",
                  "cellValue": "AboutSection",
                  "linkTarget": "parameter",
                  "linkLabel": "Notes",
                  "subTarget": "Notes",
                  "style": "link"
                },
                {
                  "id": "f0000002-0000-0000-0000-000000000002",
                  "cellValue": "AboutSection",
                  "linkTarget": "parameter",
                  "linkLabel": "Sources",
                  "subTarget": "Sources",
                  "style": "link"
                }
              ]
            },
            "name": "tabs - about"
          },
          {
            "type": 12,
            "content": {
              "version": "NotebookGroup/1.0",
              "groupType": "editable",
              "items": [
                {
                  "type": 1,
                  "content": {
                    "json": "## Navigation\n\nEvery tab and sub-tab of this workbook, with the description that used to sit at\nthe top of each one. The data tabs now open straight onto their content; this\npage is the single place where the intent, the scope and the caveats of each\nsection are documented.\n\n- **Overview** and **Audit** read the audit streams: `IntuneAuditLogs` and the Entra ID `AuditLogs` directory audit.\n- **Inventory** reads the snapshot exports: `IntuneDevices`, `IntuneOperationalLogs`, `IntuneDeviceComplianceOrg` and the Windows Update for Business reports tables.\n- **About** holds this page, the reading notes and the sources.\n\nParameter scope: `TimeRange` is global. `Actor` and `Operation` are also declared\nglobally, so they still constrain every audit query, but the block is only\ndisplayed on the Audit tab. Sub-tab filters (`TopN`, `FocusOperation`, `OS`,\n`MobileOS`, `ComplianceOS`, `DOGroupId`, `DOContentType`) are local to their own\nsection.\n\n**Workspace scope.** Every table this workbook reads is grouped into one of three buckets, each with its own Subscription + Workspace picker at the top of the page: **Intune logs** (`IntuneAuditLogs`, `IntuneDevices`, `IntuneDeviceComplianceOrg`, `IntuneOperationalLogs`), **Entra ID logs** (`AuditLogs`), and **Windows Update reports** (`UCClient`, `UCUpdateAlert`, `UCDOStatus`). All three default to this tenant's own workspace, so nothing changes if you never touch them; another organization whose logs are split across separate workspaces (or subscriptions) can repoint any bucket independently. Five items read across two buckets in a single query (`Actor`, LAPS, BitLocker, DO devices, ingestion health): the secondary table is referenced explicitly with `workspace('{BucketWorkspace}').Table`, since cross-component resources union the *same* table across resources rather than let a join pull two *different* tables from two different workspaces.\n\n---\n\n### Overview\n\nVolume of administrative actions over **{TimeRange:label}**. Counters are de-duplicated by `AuditEventId`.\n\n---\n\n### Audit\n\nEverything sourced from `IntuneAuditLogs` and, for LAPS and BitLocker, the Entra ID `AuditLogs` directory audit. The **Actor** and **Operation** filters at the top of the page belong to this tab and propagate to every section below.\n\n---\n\n#### Assignments\n\nGroup added to or removed from a policy or an app. `Target.GroupId` is a raw GUID: the group display name is not present in this log. Join with an Entra ID export to resolve it.\n\n---\n\n#### BitLocker\n\nBitLocker recovery-key read requests, from the `AuditLogs` table (Entra ID directory audit, `Read BitLocker key`). Unlike LAPS, this event does not carry a device display name, only the device's Entra object ID; it is resolved against the `IntuneDevices` inventory the same way the Wipe and Device actions tabs resolve theirs. The bottom table flags actors who read keys for 5 or more distinct devices within a single hour, the same harvesting signal as LAPS.\n\nThe local **Actor type** filter (`User` / `Application` / `Unknown`) defaults to `User`, so automated backup or key-escrow service accounts reading keys in bulk don't drown out human activity. Switch it to select all to include them.\n\nNeither the recovery key ID nor the requester's source IP address is extracted by this tab's queries.\n\n> The **Operation** filter does not apply to this tab: it targets `IntuneAuditLogs` operations. The **Actor** filter applies normally.\n\n---\n\n#### Configuration\n\nPolicy and setting modifications (Create / Update / Delete / Patch), excluding assignments, `Sync*` jobs, device actions, `decrypt`, certificates and Autopilot noise. The `DeviceManagementAPIVersion` property is filtered out: present on almost every event, no analytical value.\n\n---\n\n#### Device actions\n\nActions pushed to managed devices, enriched with the `IntuneDevices` inventory. The inventory is a snapshot table (one row per device per day) and is de-duplicated with `arg_max` before the join: without that, every audit event would be multiplied by the number of retained snapshot days. The join is a left outer so that actions on devices no longer present in the inventory remain visible.\n\n**What this tab matches**\n\nEvery `IntuneAuditLogs` operation whose name contains `ManagedDevice`, minus\n`Delete ManagedDeviceMobileAppConfiguration`, which is a configuration object rather\nthan a device. In practice that covers three families.\n\n| Family | Typical operations | Meaning |\n|---|---|---|\n| Object lifecycle | `Create ManagedDevice`, `Delete ManagedDevice` | Enrolment and removal of the device record. |\n| Object edits | `Update ManagedDevice`, `Patch ManagedDevice` | Changes to the device record itself: rename, primary user reassignment, device category, ownership, notes. |\n| Remote commands | `wipe`, `retire`, `cleanWindowsDevice`, `remoteLock`, `resetPasscode`, `rebootNow`, `syncDevice`, and the rest of the action surface | A command pushed to the device. The audit event records that the command was *submitted*, not that it succeeded on the endpoint. |\n\n**Reading caveats**\n\n- **`Sync*` is not excluded here**, unlike the Overview, Configuration, Top actions and\n  Raw audit log tabs. Sync is by far the highest-volume device operation, so it will\n  dominate the *Top 10 device operations* chart unless you filter it out with the\n  global **Operation** picker.\n- `ResultType` reflects the **service-side** outcome. A device that never checks in\n  again keeps a pending command indefinitely, and a Retire or Wipe stays pending until\n  the MDM certificate expires, up to a year after enrolment.\n- Actions the user triggers themselves from the Company Portal appear with no\n  initiating admin. In the Intune admin center these show an empty *Initiated By*; here\n  they fall back to the raw `Identity` value.\n\n**References**\n\n- [Device actions overview, per-platform matrix and bulk actions](https://learn.microsoft.com/en-us/intune/device-management/actions/)\n- [Sync](https://learn.microsoft.com/en-us/intune/device-management/actions/sync) - [Restart](https://learn.microsoft.com/en-us/intune/device-management/actions/restart) - [Rename](https://learn.microsoft.com/en-us/intune/device-management/actions/rename) - [Collect diagnostics](https://learn.microsoft.com/en-us/intune/device-management/actions/collect-diagnostics)\n- [Rotate BitLocker keys](https://learn.microsoft.com/en-us/intune/device-management/actions/rotate-bitlocker-keys) - [Run remediation](https://learn.microsoft.com/en-us/intune/device-management/actions/run-remediation) - [Locate device](https://learn.microsoft.com/en-us/intune/device-management/actions/locate)\n- [Quick scan](https://learn.microsoft.com/en-us/intune/device-management/actions/quick-scan) - [Full scan](https://learn.microsoft.com/en-us/intune/device-management/actions/full-scan)\n- [Troubleshoot device actions](https://learn.microsoft.com/en-us/troubleshoot/mem/intune/device-management/troubleshoot-device-actions)\n\n---\n\n#### LAPS\n\nWindows LAPS local administrator password recovery requests, from the `AuditLogs` table (Entra ID directory audit, `Recover device local administrator password`). The bottom table flags actors who requested passwords for 5 or more distinct devices within a single hour (threshold adjustable in the query), useful for spotting password harvesting or lateral movement recon.\n\n> The **Operation** filter does not apply to this tab: it targets `IntuneAuditLogs` operations. The **Actor** filter applies normally.\n\n---\n\n#### PIM\n\nEntra ID Privileged Identity Management role activations, from `AuditLogs` where\n`LoggedByService == \"PIM\"`. The tab answers two questions: who elevated into which role,\nand whether they gave a usable reason for it.\n\n**Field resolution.** Two things in this schema are index-dependent and were rewritten:\n\n- The role sits in `TargetResources`, but **not always at index 0**: the array layout\n  differs between role assignments and group assignments. Role, target user and scope are\n  resolved by `type` (`Role`, `User`, everything else) with `make_set_if`, not by position.\n- The justification has three possible homes depending on tenant and event version:\n  `AdditionalDetails[\"Justification\"]`, `ResultReason`, or `ResultDescription`. Published\n  queries pick one and each is right somewhere. This tab `coalesce`s all three rather than\n  betting on one, and `AdditionalDetails` is folded into a bag with `make_bag` so the\n  activation window, ticket reference and source IP are read **by key**, not by array index.\n\n**Justification quality** is bucketed as `Provided`, `Too short` (under 15 characters) or\n`Missing`. The threshold is a `let` at the top of each query. The *Justifications, grouped*\ngrid normalises reasons to lowercase and collapses punctuation, so `RFC 1234`, `rfc-1234`\nand `rfc 1234` land on one row: that is where recurring copy-paste justifications become\nvisible.\n\n**Off hours** means before 07:00 or after 19:00 **UTC**, or a weekend. If your admins sit\nin a single timezone, shift `TimeGenerated` before `hourofday()` rather than reading the\ntile as-is.\n\n**Scope notes**\n\n- The role list is a workbook parameter built from your own data, not a hard-coded list.\n  Leave it on the *All* pill to see every role.\n- The global **Actor** filter applies to the requestor. The global **Operation** filter does\n  not: it targets `IntuneAuditLogs` operations, and this tab reads `AuditLogs`.\n- The KPI tiles and grids cover completed activations only. The *PIM operation mix* chart\n  is deliberately wider: it shows every PIM event in range, so requested, approved, denied\n  and deactivation events stay visible next to the completions.\n\n**References**\n\n- [Microsoft Entra audit log schema](https://learn.microsoft.com/en-us/azure/azure-monitor/reference/tables/auditlogs)\n- [View activity and audit history for Privileged Identity Management](https://learn.microsoft.com/en-us/entra/id-governance/privileged-identity-management/pim-how-to-use-audit-log)\n- [Activate Microsoft Entra roles in PIM](https://learn.microsoft.com/en-us/entra/id-governance/privileged-identity-management/pim-how-to-activate-role)\n- Query lineage: [reprise99, Audit-NewPIMRoleActivated](https://github.com/reprise99/Sentinel-Queries/blob/main/Azure%20Active%20Directory/Audit-NewPIMRoleActivated.kql), the starting point for the target and detail extraction\n\n---\n\n#### Raw audit log\n\nEvery `IntuneAuditLogs` event in range, without normalisation or exclusion, apart from `Sync*` operations. Use the column filters for ad hoc search, or the Excel export for offline analysis.\n\nAzure Monitor workbooks cap grid results at 2,000 rows. On a large tenant with a wide time range, the grid can silently truncate at that limit with no visible warning; narrow **{TimeRange:label}** or use the column filters to stay under it rather than assuming an empty result set means no matching events.\n\n---\n\n#### Top actions\n\nRanking of Intune operations over **{TimeRange:label}**, excluding `Sync*` operations (service volume, no audit value). Pick an operation in the **Focus** filter to drill into the underlying events.\n\n---\n\n#### Wipe / Retire / Reset\n\nDestructive and remote actions on managed devices, plus device object deletions in Intune (for reference: a deletion is not necessarily a wipe).\n\n**Device name resolution.** On these events `TargetDisplayNames[0]` carries the *action* label, not the device name, so the device name is resolved by joining `TargetObjectIds[0]` against a de-duplicated `IntuneDevices` snapshot (30-day lookback, `arg_max` per `DeviceId`). The join is a **left outer**: a device wiped then deleted disappears from the inventory, and an inner join would silently hide exactly the events that matter. Unresolved rows are kept and flagged in the `NameResolution` column.\n\nThe bottom table flags actors reaching 3 or more Wipe/Retire actions within a 15-minute window (threshold adjustable in the query), useful for spotting a compromised account or an unintended bulk wipe.\n\n**What each action actually does**\n\nThe `DestructiveOps` list in these queries is deliberately a **superset**: it collects\nevery *sensitive* remote action, not only the ones that destroy data. Three of them\nremove nothing at all and are here purely for correlation, because a passcode reset\nfollowed twenty minutes later by a wipe reads very differently from either on its own.\n\n| Shown as | Matched on | Data loss | What Intune actually does |\n|---|---|---|---|\n| Wipe | `wipe`, `eraseDevice` | Total | Factory reset. Removes all data, apps and settings. On Windows, enrolment can optionally be retained. |\n| Retire | `retire` | Company data only | Removes company data, apps and settings, leaves personal data intact. The device leaves management at its next check-in, so it stays visible in Intune until then. |\n| Device deletion | `Delete ManagedDevice` | Company data only | Removes the device from Intune immediately and triggers a Retire on the client. A status of *Completed* means the server side is done, not the device. |\n| Fresh Start | `cleanWindowsDevice`, `freshStart` | Apps, optionally user data | Reinstalls the latest Windows and removes manufacturer-installed apps. Used to de-bloat or repurpose a device rather than to secure it. |\n| Remote lock | `remoteLock` | **None** | Locks the device screen. Reversible. Requires a passcode policy assigned to the device. |\n| Passcode reset | `resetPasscode` | **None** | Issues a new passcode so a locked-out user gets back in without a wipe. On Android, distinguishes a device-level reset from a work-profile reset. |\n| Disable | `disable` | **None** | Blocks the device, typically tied to activation lock. Reversible. |\n\n**Two operational facts worth knowing when reading this tab**\n\n- **Retire, Wipe and Delete take precedence over every other pending action.** A device\n  carrying several pending commands executes only one of those three and silently drops\n  the rest. A remote lock logged just before a wipe may therefore never have run.\n- Intune enforces **daily tenant limits**: 500 Wipe, 1,000 Retire, 1,000 Delete,\n  cumulative across the admin center, bulk actions and Graph. A burst that stalls at a\n  round number is likely to be a quota, not a failure.\n\n**Known gap.** *Autopilot reset* is not matched by the operation names above. If your\ntenant emits it under a distinct operation, add it to `DestructiveOps`; until then it\nwill not appear on this tab even though it removes personal files, apps and settings,\nand clears the primary user and the Entra device owner.\n\n**References**\n\n- [Device actions overview, per-platform matrix and daily limits](https://learn.microsoft.com/en-us/intune/device-management/actions/)\n- [Wipe](https://learn.microsoft.com/en-us/intune/device-management/actions/wipe) - [Retire](https://learn.microsoft.com/en-us/intune/device-management/actions/retire) - [Delete](https://learn.microsoft.com/en-us/intune/device-management/actions/delete)\n- [Fresh Start](https://learn.microsoft.com/en-us/intune/device-management/actions/fresh-start) - [Autopilot reset](https://learn.microsoft.com/en-us/intune/device-management/actions/autopilot-reset)\n- [Reset passcode](https://learn.microsoft.com/en-us/intune/device-management/actions/reset-passcode)\n- [Troubleshoot device actions](https://learn.microsoft.com/en-us/troubleshoot/mem/intune/device-management/troubleshoot-device-actions), for pending states and MDM certificate expiry\n\n---\n\n### Inventory\n\nFleet state rather than administrative activity. Sources: `IntuneDevices`, `IntuneOperationalLogs`, `IntuneDeviceComplianceOrg` and the Windows Update for Business reports tables. The **Actor** and **Operation** filters do not apply here; each section carries its own filters where relevant.\n\n---\n\n#### Delivery Optimization\n\nBandwidth split between CDN, peers and Microsoft Connected Cache, from `UCDOStatus` (Windows Update for Business reports).\n\n**P2P here includes Internet peers.** The percentage is `(BytesFromPeers + BytesFromGroupPeers + BytesFromIntPeers) / Total`, where the denominator also carries `BytesFromCDN` and `BytesFromCache`. Counting only LAN and group peers, as most published queries do, understates peering wherever `DODownloadMode` is set to 3 (Internet).\n\n`GroupID` is an opaque hash derived from the Delivery Optimization group (`DOGroupID` policy, AD site, domain, or subnet depending on `DOGroupIdSource`). It cannot be resolved to a site name from this table: pick one in the filter below and correlate with your own DO policy assignment.\n\n**MCC server usage.** The *MCC server usage* table breaks the same data down by `CacheNodeId`, the Microsoft Connected Cache server that served the content, using the `CacheNodeDetails` dynamic array (cache node identifier, date and bytes served, one entry per node a device downloaded from). Adapted from Microsoft's own `DeliveryOptimization.workbook`, which uses the same `mv-expand` pattern to aggregate by cache node. `CacheNodeDetails`'s own sub-fields (`Id`, `Date`, `Bytes`) aren't individually itemised in the `UCDOStatus` schema reference beyond \"an array of cache node details\", so they're verified by construction against that workbook rather than an independent schema page.\n\n**Ingestion caveat.** WUfB reports refresh a full snapshot every 24 h for devices seen in the last **28 days**, so a time range beyond 28 days will not return older data, and the same device can be re-ingested on consecutive days even with no new download. Read the percentages as the shape of the traffic, not as an exact byte ledger.\n\n---\n\n#### Device inventory\n\nFleet state derived from the Intune device and compliance exports, the Intune operational log, and Windows Update for Business reports. Unlike the audit tabs, most sections here read a **fixed 30-day inventory lookback** that is deliberately independent of **{TimeRange:label}**: these are snapshot tables (one row per device per day), so a short range would contain no snapshot at all. Sections that are genuinely time-series (Autopilot builds, version evolution, update errors) do honour the global time range.\n\n> The global **Actor** and **Operation** filters do not apply here: they target `IntuneAuditLogs`, and none of these sections read that table.\n\n---\n\n##### All devices\n\nKPI tiles and a trend chart. The KPI tiles count distinct devices per major OS family (Windows, iOS/iPadOS, Android, macOS); devices on any other or unrecognised OS are still counted in the \"All devices\" total and visible in the chart, just without their own tile. The chart plots device count per day per OS, from a de-duplicated `IntuneDevices` snapshot.\n\n---\n\n##### Autopilot builds\n\nSuccessful Autopilot provisioning completions over **{TimeRange:label}**, from `IntuneOperationalLogs` / `ESPEnrollment`. Only `DeviceProvisioningProgressEvent` events with scope `DeviceEnrollmentSuccess` and `IsAutopilot = true` are kept, so one row equals one completed build, not one ESP step.\n\nThe device name is not present in the operational log: it is resolved by a left outer join against a de-duplicated `IntuneDevices` snapshot (30-day lookback). A device built and then deleted stays visible, flagged `<unresolved ...>`.\n\nThe **detail table** keeps only the **latest build per device** (`arg_max`), while the KPI tiles and the trend chart count **every build event**: a device rebuilt three times shows once in the table and three times in the counters.\n\nThis section also tracks the Enrollment Status Page (ESP) itself: per-build end-to-end duration and success/failure outcome, read from the same `EspSlaIsDeviceSyncDone` event within `ESPEnrollment`. Success is matched on `Status =~ \"Completed\"`, the only value Microsoft documents; anything else is bucketed as `Failure`.\n\n---\n\n##### Compliance\n\nCompliance state from `IntuneDeviceComplianceOrg`, de-duplicated on `DeviceId` (not `DeviceName`, which is not unique and is sometimes reported as `User deleted for this device`) over a 30-day lookback.\n\n`InGracePeriodUntil` is a **string** in this schema. It is cast with `todatetime()` and a device counts as in grace only when the date is in the future *and* below year 9000: Intune uses `9999-12-31` as the sentinel for \"no grace period\", which would otherwise make every device look like it is in grace.\n\nThe trend chart honours **{TimeRange:label}** and de-duplicates one row per device per day; the tiles and the breakdown read the 30-day snapshot.\n\n---\n\n##### Disk status\n\nFree space on Windows devices, from the latest `IntuneDevices` snapshot per device over a 30-day lookback. De-duplication is done on `DeviceId` rather than `SerialNumber`: serial numbers are not guaranteed unique across manufacturers and are sometimes blank on virtual machines.\n\n**Thresholds:** `Critical` below 10 GB free, `Warning` below 25 GB, `OK` above. Both are `let` constants at the top of each query, alongside `StorageUnitToGB`. That last one matters: Microsoft does not document the unit of `StorageFree` / `StorageTotal` (the schema just says `long`). This tenant reports **MB**, hence `1024.0`. If your Free_GB values come out roughly a million times too large, the export is in bytes and the constant should be `1073741824.0`.\n\n---\n\n##### Mobile OS currency\n\nAnswers a single question: **is this device on the newest OS version any device of the same model has reported?** The tenant is used as its own reference, so no external version feed is needed, at the cost of one assumption: at least one device per model must already be up to date.\n\nVersions are ranked with `parse_version()`, not by string comparison. That matters: lexicographically `\"9.5\"` sorts above `\"18.5\"`, which would silently mark an entire model as up to date on a version two years old.\n\nScope: last record per `DeviceId` over 30 days, `DeviceState = Managed` only. Use the **Operating system** filter below to restrict to Android and iOS/iPadOS; Windows is included by default but the per-model logic is far less meaningful there (use the Windows versions section instead).\n\n---\n\n##### Windows Update errors\n\nActive `Error` alerts from **Windows Update for Business reports** (`UCUpdateAlert`), enriched with device context from `UCClient`. One row per device and per alert subtype, keeping the most recent occurrence.\n\n`UCClient` is a daily snapshot, so it is de-duplicated with `arg_max` per `AzureADDeviceId` before the join, over a fixed 30-day lookback. WUfB reports only refresh devices seen in the **last 28 days**, so a time range beyond that returns nothing older, and `Recommendation` is the remediation text Microsoft ships with the alert, not a local judgement.\n\n---\n\n##### Windows versions\n\nFeature-update spread across the Windows fleet. The release name is derived from the **third octet** of `OSVersion` (`10.0.<build>.<revision>`) rather than a `startswith` match, so monthly revisions never break the mapping. The build map is an inline `case()` in each query rather than a `let` lambda: a lambda body is wrapped in braces, and braces are the workbook parameter-substitution syntax.\n\nBuild 28000 is **Windows 11 26H1**, a new-device-only release that is *not* offered as an in-place upgrade, which is why its build number sits above 26H2 (26300). LTSC editions cannot be distinguished from `OSVersion` alone: 17763 covers both 1809 and LTSC 2019, 19044 both 21H2 and LTSC 21H2, 26100 both 24H2 and LTSC 2024.\n\nKPI tiles and the distribution chart read the **30-day inventory snapshot**; the evolution chart honours **{TimeRange:label}** and de-duplicates one row per device per day before counting, otherwise multiple snapshots in a single day would inflate every point.\n\n---\n\n### About > Data feeds\n\nIngestion freshness for every table the workbook reads, over a fixed seven-day window\nindependent of `{TimeRange}`. A section that renders empty is almost always a feed\nproblem rather than a query problem, so check here first.\n\n`Feed lagging` means the most recent row is more than three days old. Tables that have\nnever ingested anything are dropped from the list entirely rather than shown as `n/a`.\n"
                  },
                  "name": "text - navigation"
                }
              ]
            },
            "conditionalVisibility": {
              "parameterName": "AboutSection",
              "comparison": "isEqualTo",
              "value": "Navigation"
            },
            "name": "group - about-navigation",
            "styleSettings": {
              "showBorder": false,
              "padding": "10px"
            }
          },
          {
            "type": 12,
            "content": {
              "version": "NotebookGroup/1.0",
              "groupType": "editable",
              "items": [
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "let LookBack = 7d;\nunion isfuzzy=true\n (IntuneAuditLogs | where TimeGenerated > ago(LookBack) | summarize LastEvent = max(TimeGenerated) | extend Source = \"IntuneAuditLogs\"),\n (IntuneDevices | where TimeGenerated > ago(LookBack) | summarize LastEvent = max(TimeGenerated) | extend Source = \"IntuneDevices\"),\n (IntuneOperationalLogs | where TimeGenerated > ago(LookBack) | summarize LastEvent = max(TimeGenerated) | extend Source = \"IntuneOperationalLogs\"),\n (IntuneDeviceComplianceOrg | where TimeGenerated > ago(LookBack) | summarize LastEvent = max(TimeGenerated) | extend Source = \"IntuneDeviceComplianceOrg\"),\n (workspace('{EntraWorkspace}').AuditLogs | where TimeGenerated > ago(LookBack) | summarize LastEvent = max(TimeGenerated) | extend Source = \"AuditLogs (Entra)\"),\n (workspace('{WufbWorkspace}').UCClient | where TimeGenerated > ago(LookBack) | summarize LastEvent = max(TimeGenerated) | extend Source = \"UCClient (WUfB)\"),\n (workspace('{WufbWorkspace}').UCUpdateAlert | where TimeGenerated > ago(LookBack) | summarize LastEvent = max(TimeGenerated) | extend Source = \"UCUpdateAlert (WUfB)\"),\n (workspace('{WufbWorkspace}').UCDOStatus | where TimeGenerated > ago(LookBack) | summarize LastEvent = max(TimeGenerated) | extend Source = \"UCDOStatus (WUfB)\")\n| where isnotnull(LastEvent)\n| extend Status = iif(LastEvent > ago(3d), \"Ingestion OK\", \"Feed lagging\")\n| extend Age = strcat(tostring(toint((now() - LastEvent) / 1h)), \" h\")\n| project Source, Status, LastEvent, Age\n| sort by Source asc",
                    "size": 2,
                    "queryType": 0,
                    "resourceType": "microsoft.operationalinsights/workspaces",
                    "title": "Feed freshness (last 7 days)",
                    "visualization": "table",
                    "timeContext": {
                      "durationMs": 604800000
                    },
                    "gridSettings": {
                      "formatters": [
                        {
                          "columnMatch": "Status",
                          "formatter": 18,
                          "formatOptions": {
                            "thresholdsOptions": "icons",
                            "thresholdsGrid": [
                              {
                                "operator": "==",
                                "thresholdValue": "Ingestion OK",
                                "representation": "success",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": "Default",
                                "thresholdValue": null,
                                "representation": "2",
                                "text": "{0}{1}"
                              }
                            ]
                          }
                        }
                      ],
                      "labelSettings": [
                        {
                          "columnId": "Source",
                          "label": "Table"
                        },
                        {
                          "columnId": "Status",
                          "label": "Status"
                        },
                        {
                          "columnId": "LastEvent",
                          "label": "Last event"
                        },
                        {
                          "columnId": "Age",
                          "label": "Age"
                        }
                      ]
                    },
                    "crossComponentResources": [
                      "{IntuneWorkspace}"
                    ]
                  },
                  "name": "health - ingestion",
                  "customWidth": "100"
                }
              ]
            },
            "conditionalVisibility": {
              "parameterName": "AboutSection",
              "comparison": "isEqualTo",
              "value": "Feeds"
            },
            "name": "group - about-feeds",
            "styleSettings": {
              "showBorder": false,
              "padding": "10px"
            }
          },
          {
            "type": 12,
            "content": {
              "version": "NotebookGroup/1.0",
              "groupType": "editable",
              "items": [
                {
                  "type": 1,
                  "content": {
                    "json": "## Reading notes\n\n**Navigation**\n\n- Per-tab descriptions live in **About > Navigation**, not at the top of each tab. The data tabs open straight onto their content.\n- Four top-level tabs: Overview, Audit, Inventory, About. Audit and Inventory carry their own sub-tab strip; Device inventory carries a third level.\n- `TimeRange` is declared at the top level and is therefore global. `Actor` and `Operation` are also declared at the top level, so they still apply to every audit query, but the parameter block is only *displayed* on the Audit tab through `conditionalVisibility`. Declaring them inside the Audit group instead would scope them to that group and break every query outside it.\n- KPI strips render at tile size 1 (medium). Size 4 (tiny) clips the number and produces a vertical scrollbar inside the strip.\n\n**Data scope**\n\n- `Sync*` operations (Autopilot, DEP, MultiToken) are excluded from the Overview, Configuration, Top actions and Raw audit log tabs: high volume, no audit value.\n- Empty actors are filtered out on the LAPS tab (they correspond to automatic password rotation, not to an administrative recovery).\n- The BitLocker tab's local **Actor type** filter defaults to `User`, hiding `Application`/service-account key reads (backup, key-escrow) unless explicitly selected. Unlike LAPS, actors are never empty here — an unresolved `InitiatedBy` falls back to `\"Unknown\"` rather than being filtered out.\n- `Delete ManagedDeviceMobileAppConfiguration` is explicitly excluded wherever `Delete ManagedDevice` is matched: it is a configuration object, not a device.\n- The `DeviceManagementAPIVersion` modified property is filtered out of configuration changes: it is present on almost every event and carries no analytical value.\n\n- Columns built with `make_set()` are joined into a plain string and given an explicit `customColumnWidthSetting`. A raw dynamic array renders as `[\"A\",\"B\",...]`, and the brackets and quotes waste about a fifth of the visible width before the cell is ellipsised.\n\n**Counting**\n\n- KPI tiles use `dcount(AuditEventId)` (HyperLogLog, roughly 0.8% default accuracy). Trend charts use `count()` on raw rows. Small gaps between a tile and its chart are expected. Use `dcount(x, 4)` if an exact count matters more than query cost.\n- Events are de-duplicated by `AuditEventId` because `mv-expand` on `Targets` then `ModifiedProperties` multiplies rows per event.\n\n**Filters**\n\n- The **Actor** and **Operation** filters are global and propagate to every tab.\n- The **Operation** filter targets `IntuneAuditLogs` operations only and is therefore not applied to the LAPS or BitLocker tabs, which read `AuditLogs`. The **Actor** filter applies normally to both.\n\n**Device name resolution**\n\n- `IntuneDevices` is a snapshot table (one row per device per day). It is de-duplicated with `arg_max` per `DeviceId` **before** any join, over a fixed 30-day lookback that is deliberately independent of the selected time range: a one-hour range would otherwise contain no snapshot row and resolve nothing.\n- On device action events, `TargetDisplayNames[0]` carries the **action label**, not the device name. The real device name comes from the inventory join and is kept in `DeviceName`, while the raw audit label is kept in `AuditTargetLabel`.\n- The join is a **left outer** on purpose: a device wiped and then deleted disappears from the inventory, and an inner join would silently hide exactly the events that matter. Unresolved rows are kept and flagged in the `NameResolution` column. `Not in inventory` usually means the device was deleted after the action, or last checked in more than 30 days ago.\n\n**Thresholds**\n\n- Wipe/Retire burst detection: 3 or more actions per actor within 15 minutes.\n- LAPS harvesting detection: 5 or more distinct devices per actor within 1 hour.\n- BitLocker harvesting detection: 5 or more distinct devices per actor within 1 hour, same as LAPS.\n- All thresholds are arbitrary starting points and are meant to be tuned against your own baseline. They are set directly in the corresponding queries.\n\n**Known gaps**\n\n- `Target.GroupId` is a raw GUID. The group display name is not present in `IntuneAuditLogs`. Resolving it requires joining an Entra ID group export (`externaldata` on a blob, or a custom table).\n- The `Result` column used on the LAPS tab comes from the standard Entra ID `AuditLogs` schema. If it is absent or named differently in your export, only the \"Failed attempts\" tile and the `Result` column are affected.\n- The BitLocker tab resolves its target device by `parse`-ing a `device: '<guid>'` fragment out of `AdditionalDetails[0].value`, since (unlike LAPS) `TargetResources` doesn't carry it. If Microsoft rewords that message, the parse returns nothing and the device name/serial join silently stops resolving.\n- The BitLocker tab never extracts the recovery key ID or the requester's IP address, by design.\n- Honeycomb (hive cluster) was considered for the Top actions tab but not implemented: its `graphSettings` JSON keys are not documented, and hand-writing them was judged too risky. The tile grid is the functional equivalent."
                  },
                  "name": "text - notes-reading"
                },
                {
                  "type": 1,
                  "content": {
                    "json": "---\n\n## Device inventory and Delivery Optimization\n\n**Extra tables required**\n\nThese two tabs read beyond `IntuneAuditLogs` / `IntuneDevices` / `AuditLogs`. If a section is empty, check the corresponding feed first, in the ingestion tile at the top of the workbook.\n\n- `IntuneOperationalLogs` — Intune diagnostic settings, *Operational logs* category. Needed for Autopilot builds.\n- `IntuneDeviceComplianceOrg` — Intune diagnostic settings, *Device compliance* category. Needed for the Compliance section, and for the `ComplianceState`/`IsCompliant` columns on All devices.\n- `UCClient`, `UCUpdateAlert`, `UCDOStatus` — [Windows Update for Business reports](https://learn.microsoft.com/en-us/windows/deployment/update/wufb-reports-overview), enrolled separately from the Azure portal and pointed at this workspace. Needed for Windows Update errors and the whole Delivery Optimization tab. Not available in GCC High or DoD tenants.\n\n**Time semantics**\n\n- Audit tabs are event streams: everything honours `{TimeRange}`.\n- Inventory tabs mostly read **snapshot** tables, one row per device per day. Sections that describe a *current state* (All devices tiles/table, Windows versions, Disk, Mobile OS currency, Compliance tiles) use a fixed **30-day** lookback, deliberately independent of the selected range, so that a one-hour range still resolves something.\n- Sections that are genuinely time-series (All devices trend, Autopilot builds, version evolution, compliance trend, update errors, Delivery Optimization) do honour `{TimeRange}`.\n- WUfB reports only refresh devices seen in the **last 28 days**. A 90-day range on the Delivery Optimization tab will not surface older data.\n\n**De-duplication**\n\nEvery snapshot read goes through `arg_max(TimeGenerated, ...)` on a stable key before any join or count:\n\n- `IntuneDevices` and `IntuneDeviceComplianceOrg` on `DeviceId`, not on `DeviceName` or `SerialNumber`. Device names are not unique and are sometimes reported as `User deleted for this device`; serial numbers are blank on many virtual machines.\n- `UCClient` on `AzureADDeviceId`.\n- Trend charts bin to one day and take the last record per device *within that day*, otherwise a day carrying two snapshots would double every point on the curve.\n- All devices is the only tab that actually joins `IntuneDevices` to `IntuneDeviceComplianceOrg` (elsewhere they're only ever deduplicated separately, never joined). Each side keeps its own established dedup: explicit-column `arg_max` for `IntuneDevices`, wildcard `arg_max(TimeGenerated, *)` for `IntuneDeviceComplianceOrg`, same as the standalone Compliance tab.\n\n**Version handling**\n\n- Windows releases are mapped from the **third octet** of `OSVersion` (`10.0.<build>.<revision>`), not from a `startswith` on the whole string. Monthly revisions therefore never break the mapping. Build 28000 is Windows 11 **26H1**, a new-device-only release, which is why it sorts above 26H2 (26300). LTSC cannot be told apart from `OSVersion` alone: 17763, 19044 and 26100 each cover both a semi-annual and an LTSC release.\n- Mobile OS versions are ranked with `parse_version()`, never by string comparison. Lexicographically `\"9.5\"` sorts above `\"18.5\"`, which would mark a whole model as current on a two-year-old release.\n- OS currency uses the tenant as its own reference: the newest version *seen on any device of the same model* is treated as the target. This needs no external version feed, but it silently reports 100 % if no device of that model has ever been updated.\n\n**Thresholds and constants**\n\n- Disk: `Critical` below 10 GB free, `Warning` below 25 GB. Set as `let` constants in each Disk query.\n- `StorageUnitToGB = 1024.0`. Microsoft documents `StorageFree` / `StorageTotal` only as `long`, with no unit. This tenant reports MB. If free space comes out absurdly large, switch the constant to `1073741824.0`. Same constant, same assumption, on the All devices tab's `Storage` column.\n- Delivery Optimization P2P includes `BytesFromIntPeers`. Most published queries count only LAN and group peers, which understates peering wherever `DODownloadMode` is 3.\n\n**Known gaps**\n\n- `GroupID` in `UCDOStatus` is an opaque hash of the DO group. It cannot be resolved to a site, subnet or policy name from this table.\n- Autopilot builds only cover the ESP path. A device provisioned without an Enrollment Status Page emits no `DeviceEnrollmentSuccess` scope and will not appear.\n- The Autopilot detail table keeps the latest build per device; the tiles and trend count every build event. A device rebuilt three times appears once in the table and three times in the counters.\n- ESP success is matched on `Status =~ \"Completed\"`, the only value Microsoft documents for the `EspSlaIsDeviceSyncDone` event; every other status is bucketed as `Failure`."
                  },
                  "name": "text - notes-inventory"
                },
                {
                  "type": 1,
                  "content": {
                    "json": "## Version\n\n**20261004**\n\nUpdated by hand whenever the workbook changes. Not semantic versioning — just\na same-day-comparable stamp. If you're looking at two copies of this file\nside by side, this line is the fastest way to tell which one is newer. See\n`docs/11-changelog.md` for what changed at each version."
                  },
                  "name": "text - notes-version"
                },
                {
                  "type": 1,
                  "content": {
                    "json": "---\n\n## Maintenance\n\nThis workbook JSON is maintained directly — edits are made in place, either\nin the Azure Workbook editor or in the JSON itself. There is no separate\nbuild step or generator to run; the JSON you're looking at is the source of\ntruth.\n\nBefore sharing this JSON outside the tenant, replace the subscription/resource-group/workspace identifiers with placeholders in **all 7 places** they appear: `fallbackResourceIds`, plus the `value` field of each of the 6 workspace-scope parameters (`IntuneSubscription`, `IntuneWorkspace`, `EntraSubscription`, `EntraWorkspace`, `WufbSubscription`, `WufbWorkspace`). Before sharing, verify with `grep -c '/subscriptions/<your-subscription-id>' workbook/IntuneHunter.workbook` — it should return `8`: the 7 real placeholders, plus one self-match, since this Maintenance text carries the command too."
                  },
                  "name": "text - notes-maint"
                }
              ]
            },
            "conditionalVisibility": {
              "parameterName": "AboutSection",
              "comparison": "isEqualTo",
              "value": "Notes"
            },
            "name": "group - about-notes",
            "styleSettings": {
              "showBorder": false,
              "padding": "10px"
            }
          },
          {
            "type": 12,
            "content": {
              "version": "NotebookGroup/1.0",
              "groupType": "editable",
              "items": [
                {
                  "type": 1,
                  "content": {
                    "json": "---\n\n## Sources and inspiration\n\n**KQL lineage**\n\nThe configuration-change query started from the classic `parse Properties with *` pattern published by Shehan Perera, and was progressively rewritten:\n\n- [Shehan Perera, IntuneAuditLogs series (2022)](https://emsroute.com/2022/10/23/intuneauditlogs-1/), originally published on `shehanperera.com` and now hosted on `emsroute.com`. Origin of the positional `parse` approach used to expose `Object`, `OperationName` and `ModifiedProperties`. Replaced here by `parse_json()`, which is insensitive to key order and to commas inside values.\n- [Oliver Kieselbach, Monitoring Intune policy configuration changes (2022)](https://oliverkieselbach.com/2022/07/19/monitoring-intune-policy-configuration-changes/). Same family of query, and the same documented limitation: the changed setting values could not be expanded automatically.\n- [Ugur Koc, Daily Intune monitoring report](https://ugurkoc.de/daily-intune-monitoring-report/). Source of the approach actually retained: `parse_json` plus `mv-expand` on `ModifiedProperties`, extracting `Name` / `Old` / `New` as proper columns, and resolving the actor through `Properties.Actor.UPN` then `Properties.Actor.ApplicationName`. One deviation: this workbook expands the **whole** `Targets` array rather than `Targets[0]`, because real tenant data showed that the meaningful `ModifiedProperties` often sit on the second target, not the first.\n- [parse operator, Microsoft Learn](https://learn.microsoft.com/en-us/azure/data-explorer/kusto/query/parseoperator). Reference for the original positional parsing.\n\n**Autopilot ESP duration lineage**\n\n- [Tom Wechsler, Microsoft_Endpoint_Manager, Kusto Query Language (KQL)](https://github.com/tomwechsler/Microsoft_Endpoint_Manager/blob/main/Kusto_Query_Language_(KQL).md). Independent reimplementation, inspired by seeing this approach: reading per-device ESP end-to-end duration and outcome from `IntuneOperationalLogs` / `ESPEnrollment`. The Autopilot failure-rate and average-duration queries were written independently for this workbook: aggregated by day instead of a single global average, scoped to the workbook's time range instead of a fixed 30-day lookback, and bucketing every non-`Success` status as `Failure` since only the success value is documented by Microsoft.\n\n**PIM lineage**\n\n- [reprise99, Audit-NewPIMRoleActivated](https://github.com/reprise99/Sentinel-Queries/blob/main/Azure%20Active%20Directory/Audit-NewPIMRoleActivated.kql). Starting point for the PIM tab's target and detail extraction from `AuditLogs`. Extended here to resolve role, target user and scope by `type` rather than by array position, and to coalesce the activation justification across its three possible schema locations instead of reading a single one.\n- [Microsoft Entra audit log schema](https://learn.microsoft.com/en-us/azure/azure-monitor/reference/tables/auditlogs) and [View activity and audit history for Privileged Identity Management](https://learn.microsoft.com/en-us/entra/id-governance/privileged-identity-management/pim-how-to-use-audit-log).\n\n**Presentation layer**\n\n- [MSEndpointMgr Intune Audit Dashboard (2022)](https://msendpointmgr.com/2022/10/28/msendpointmgr-intune-audit-dashboard/). Source of the visual grammar reused here: tab navigation via a `LinkItem` bound to a parameter plus conditional visibility on groups, KPI tiles with threshold icons and gradient numbers, per-value icons in grids, coloured `make-series` area charts, and the ingestion freshness indicator. The KQL of that dashboard was not reused: only its presentation patterns were.\n\n**Device name resolution on wipe events**\n\n- Based on a working query of your own, joining `IntuneAuditLogs` to `IntuneDevices` on the device ID extracted from `TargetObjectIds[0]`. Two changes were made: the inventory is de-duplicated before the join rather than after, so that multiple actions on the same device are preserved, and the join was switched from inner to left outer, so that actions on devices that are no longer in the inventory remain visible.\n\n**Microsoft documentation used for the workbook mechanics**\n\n- [Workbook visualizations](https://learn.microsoft.com/en-us/azure/azure-monitor/visualize/workbooks-visualizations)\n- [Tile visualizations](https://learn.microsoft.com/en-us/azure/azure-monitor/visualize/workbooks-tile-visualizations)\n- [Honeycomb visualizations](https://learn.microsoft.com/en-us/azure/azure-monitor/visualize/workbooks-honey-comb)\n- [Time parameters](https://learn.microsoft.com/en-us/azure/azure-monitor/visualize/workbooks-time)\n- [Workbook parameters](https://learn.microsoft.com/en-us/azure/azure-monitor/visualize/workbooks-parameters)\n- [Sample workbooks with links, the tab pattern](https://learn.microsoft.com/en-us/azure/azure-monitor/visualize/workbooks-samples)\n- [Interactive reports, grid link renderers and conditional visibility](https://learn.microsoft.com/en-us/azure/azure-monitor/visualize/workbooks-interactive-reports)\n\n**Device inventory and Delivery Optimization**\n\n- Queries in these two tabs are adapted from working queries of your own. Changes made: snapshot de-duplication moved *before* every join and count, `startswith` build matching replaced by an octet-based `case`, string version comparison replaced by `parse_version()`, `SerialNumber` de-duplication replaced by `DeviceId`, hard-coded `GroupID` and `DeviceName endswith` development filters replaced by workbook parameters, `format_bytes()` kept for tables only since it returns a string and cannot drive a chart or a tile, and the Delivery Optimization time filter corrected from `TimeGenerated < ago(7d)` — which selected everything *older* than seven days — to the global time range.\n- [IntuneDevices table reference](https://learn.microsoft.com/en-us/azure/azure-monitor/reference/tables/intunedevices)\n- [IntuneDeviceComplianceOrg table reference](https://learn.microsoft.com/en-us/azure/azure-monitor/reference/tables/intunedevicecomplianceorg)\n- [Windows Update for Business reports overview](https://learn.microsoft.com/en-us/windows/deployment/update/wufb-reports-overview) and the [UCDOStatus](https://learn.microsoft.com/en-us/windows/deployment/update/wufb-reports-schema-ucdostatus), [UCClient](https://learn.microsoft.com/en-us/windows/deployment/update/wufb-reports-schema-ucclient) and [UCUpdateAlert](https://learn.microsoft.com/en-us/windows/deployment/update/wufb-reports-schema-ucupdatealert) schemas\n- [Windows 11 release information](https://learn.microsoft.com/en-us/windows/release-health/windows11-release-information) and [Windows 10 release information](https://learn.microsoft.com/en-us/windows/release-health/windows10-release-information), used to build and check the build-number mapping\n- [Delivery Optimization reference](https://learn.microsoft.com/en-us/windows/deployment/do/waas-delivery-optimization-reference) for `DODownloadMode` and `DOGroupIdSource`\n- HTMD Blog, *List of Intune devices with patch deployment status and country details using KQL queries*, origin of the `UCClient` / `UCUpdateAlert` join pattern\n\n**MCC server usage table**\n\n- [DeliveryOptimization.workbook, microsoft/Application-Insights-Workbooks](https://github.com/microsoft/Application-Insights-Workbooks/blob/master/Workbooks/UpdateCompliance/DeliveryOptimization/DeliveryOptimization.workbook), the official Microsoft community workbook behind the Windows Update for Business reports Delivery Optimization tab. Source of the `CacheNodeDetails` / `mv-expand` aggregation pattern adapted into the *MCC server usage* table.\n- [UCDOStatus table reference, Azure Monitor Logs](https://learn.microsoft.com/en-us/azure/azure-monitor/reference/tables/ucdostatus). Confirms `CacheNodeDetails` as a `dynamic` column (\"an array of cache node details ... including cache node identifier, date, and bytes served\"); does not itemise the sub-field names, which come from the workbook above instead.\n\n**Multi-workspace parameterization**\n\n- [Query across resources with Azure Monitor, Microsoft Learn](https://learn.microsoft.com/en-us/azure/azure-monitor/logs/cross-workspace-query). Source of the `workspace('identifier').table` syntax used to pin a specific table to a specific workspace inside a single query, wherever an item reads across two of the three workspace buckets.\n- [Cross workspace queries, Microsoft Learn](https://learn.microsoft.com/en-us/azure/azure-monitor/logs/api/cross-workspace-queries). Confirms the accepted identifier formats (name, qualified name, workspace ID, Azure Resource ID) for `workspace()`.\n- [Azure Monitor workbook resource parameters, Microsoft Learn](https://learn.microsoft.com/en-us/azure/azure-monitor/visualize/workbooks-resources). Subscription and Resource picker parameter types used for the six `params - workspaces` parameters.\n- [microsoft/Application-Insights-Workbooks](https://github.com/microsoft/Application-Insights-Workbooks) - the Windows Update for Business reports hub workbook you supplied (`community-Workbooks/UpdateCompliance/UpdateComplianceHub`). Origin of the ARM-based subscription-then-workspace resolution pattern (Resource Graph query filtered by `type == \"microsoft.operationalinsights/workspaces\"`, scoped via `crossComponentResources` to the selected subscription). Its Graph API auto-detection of a saved workspace mapping and its onboarding-state UI were **not** reused: both are specific to the Windows Update for Business reports enrollment flow in the M365 admin center and have no equivalent for a bespoke workspace."
                  },
                  "name": "text - notes-sources"
                }
              ]
            },
            "conditionalVisibility": {
              "parameterName": "AboutSection",
              "comparison": "isEqualTo",
              "value": "Sources"
            },
            "name": "group - about-sources",
            "styleSettings": {
              "showBorder": false,
              "padding": "10px"
            }
          }
        ]
      },
      "conditionalVisibility": {
        "parameterName": "Tab",
        "comparison": "isEqualTo",
        "value": "About"
      },
      "name": "group - about",
      "styleSettings": {
        "showBorder": true,
        "padding": "10px"
      }
    }
  ],
  "styleSettings": {},
  "$schema": "https://github.com/Microsoft/Application-Insights-Workbooks/blob/master/schema/workbook.json",
  "layout": {
    "type": "flow"
  },
  "fallbackResourceIds": [
    "/subscriptions/<your-subscription-id>/resourceGroups/<your-resource-group>/providers/Microsoft.OperationalInsights/workspaces/<your-workspace-name>"
  ]
}
