              "items": [
                {
                  "type": 9,
                  "content": {
                    "version": "KqlParameterItem/1.0",
                    "parameters": [
                      {
                        "id": "c1000000-0000-0000-0000-000000000001",
                        "version": "KqlParameterItem/1.0",
                        "name": "TopN",
                        "label": "Top N",
                        "type": 2,
                        "isRequired": true,
                        "query": "datatable(TopN:string)[\"10\",\"15\",\"20\",\"30\",\"50\"]",
                        "value": "20",
                        "typeSettings": {
                          "additionalResourceOptions": [],
                          "showDefault": false
                        },
                        "timeContext": {
                          "durationMs": 0
                        },
                        "queryType": 0,
                        "resourceType": "microsoft.operationalinsights/workspaces"
                      },
                      {
                        "id": "c1000000-0000-0000-0000-000000000002",
                        "version": "KqlParameterItem/1.0",
                        "name": "FocusOperation",
                        "label": "Focus operation",
                        "type": 2,
                        "query": "IntuneAuditLogs\n| where TimeGenerated {TimeRange}\n| where not(OperationName matches regex \"(?i)^Sync\")\n| summarize Events = count() by OperationName\n| top 200 by Events desc\n| project OperationName\n| order by OperationName asc",
                        "typeSettings": {
                          "additionalResourceOptions": [],
                          "showDefault": false
                        },
                        "timeContext": {
                          "durationMs": 0
                        },
                        "timeContextFromParameter": "TimeRange",
                        "queryType": 0,
                        "resourceType": "microsoft.operationalinsights/workspaces",
