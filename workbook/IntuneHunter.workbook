                {
                  "type": 12,
                  "content": {
                    "version": "NotebookGroup/1.0",
                    "groupType": "editable",
                    "items": [
                      {
                        "type": 3,
                        "content": {
                          "version": "KqlItem/1.0",
                          "query": "let InventoryLookback = 30d;\nlet InventoryStart = iif({TimeRange:start} < ago(InventoryLookback), {TimeRange:start}, ago(InventoryLookback));\nlet WinNow = IntuneDevices\n| where TimeGenerated > InventoryStart\n| where OS == \"Windows\"\n| summarize arg_max(TimeGenerated, DeviceName, OSVersion, UPN, Model, Manufacturer, LastContact) by DeviceId\n| extend WinBuild = toint(split(OSVersion, \".\")[2])\n| extend OSName = case(WinBuild == 10240, \"Win 10 1507\", WinBuild == 10586, \"Win 10 1511\", WinBuild == 14393, \"Win 10 1607\", WinBuild == 15063, \"Win 10 1703\", WinBuild == 16299, \"Win 10 1709\", WinBuild == 17134, \"Win 10 1803\", WinBuild == 17763, \"Win 10 1809\", WinBuild == 18362, \"Win 10 1903\", WinBuild == 18363, \"Win 10 1909\", WinBuild == 19041, \"Win 10 2004\", WinBuild == 19042, \"Win 10 20H2\", WinBuild == 19043, \"Win 10 21H1\", WinBuild == 19044, \"Win 10 21H2\", WinBuild == 19045, \"Win 10 22H2\", WinBuild == 22000, \"Win 11 21H2\", WinBuild == 22621, \"Win 11 22H2\", WinBuild == 22631, \"Win 11 23H2\", WinBuild == 26100, \"Win 11 24H2\", WinBuild == 26200, \"Win 11 25H2\", WinBuild == 26300, \"Win 11 26H2\", WinBuild == 28000, \"Win 11 26H1\", \"Other / Unknown\")\n| extend WinFamily = case(isnull(WinBuild), \"Unknown\", WinBuild >= 22000, \"Windows 11\", WinBuild >= 10240, \"Windows 10\", \"Unknown\");\nWinNow\n| summarize Count = count()\n| extend Text = \"Windows devices\"\n| extend Range = strcat(\"last \", tostring(toint(round((now() - InventoryStart) / 1d, 0))), \" d snapshot\")",
                          "size": 1,
                          "queryType": 0,
