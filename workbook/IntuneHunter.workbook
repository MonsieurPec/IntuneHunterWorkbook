                    "crossComponentResources": [
                      "{WufbWorkspace}"
                    ]
                  },
                  "name": "chart - do-efficiency",
                  "customWidth": "65"
                },
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "let BytesPerGB = 1073741824.0;\nlet DO = UCDOStatus\n| where TimeGenerated {TimeRange}\n| where GroupID in ({DOGroupId}) or '*' in ({DOGroupId})\n| where ContentType in ({DOContentType}) or '*' in ({DOContentType});\nlet Totals = DO\n| summarize CDN = sum(BytesFromCDN), LANPeers = sum(BytesFromPeers), GroupPeers = sum(BytesFromGroupPeers), IntPeers = sum(BytesFromIntPeers), MCC = sum(BytesFromCache), Devices = dcount(DeviceName)\n| extend TotalBytes = CDN + LANPeers + GroupPeers + IntPeers + MCC\n| extend PeerBytes = LANPeers + GroupPeers + IntPeers;\nTotals\n| project Source = pack_array(\"CDN\", \"LAN peers\", \"Group peers\", \"Internet peers\", \"MCC\"), GB = pack_array(round(CDN / BytesPerGB, 2), round(LANPeers / BytesPerGB, 2), round(GroupPeers / BytesPerGB, 2), round(IntPeers / BytesPerGB, 2), round(MCC / BytesPerGB, 2))\n| mv-expand Source to typeof(string), GB to typeof(real)",
                    "size": 2,
                    "queryType": 0,
                    "resourceType": "microsoft.operationalinsights/workspaces",
                    "title": "Volume by source (GB)",
                    "visualization": "piechart",
                    "timeContextFromParameter": "TimeRange",
                    "chartSettings": {
                      "showLegend": false,
                      "seriesLabelSettings": [
                        {
                          "seriesName": "CDN",
                          "color": "orange"
                        },
                        {
                          "seriesName": "LAN peers",
                          "color": "green"
                        },
                        {
                          "seriesName": "Group peers",
                          "color": "greenDark"
                        },
                        {
                          "seriesName": "Internet peers",
                          "color": "yellow"
                        },
                        {
                          "seriesName": "MCC",
                          "color": "blue"
                        }
                      ]
                    },
                    "crossComponentResources": [
                      "{WufbWorkspace}"
                    ]
                  },
                  "name": "chart - do-sources",
                  "customWidth": "35"
                },
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "let BytesPerGB = 1073741824.0;\nlet DO = UCDOStatus\n| where TimeGenerated {TimeRange}\n| where GroupID in ({DOGroupId}) or '*' in ({DOGroupId})\n| where ContentType in ({DOContentType}) or '*' in ({DOContentType});\nDO\n| summarize Transfers = count() by ContentType, TimeGenerated = bin(TimeGenerated, 1d)\n| project TimeGenerated, ContentType, Transfers\n| sort by TimeGenerated asc",
                    "size": 2,
                    "queryType": 0,
                    "resourceType": "microsoft.operationalinsights/workspaces",
                    "title": "Content usage over time - {TimeRange:label}",
                    "visualization": "areachart",
                    "timeContextFromParameter": "TimeRange",
                    "chartSettings": {
                      "showLegend": false
                    },
                    "crossComponentResources": [
                      "{WufbWorkspace}"
                    ]
                  },
                  "name": "chart - do-content",
                  "customWidth": "65"
                },
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "let BytesPerGB = 1073741824.0;\nlet DO = UCDOStatus\n| where TimeGenerated {TimeRange}\n| where GroupID in ({DOGroupId}) or '*' in ({DOGroupId})\n| where ContentType in ({DOContentType}) or '*' in ({DOContentType});\nDO\n| summarize Bytes = sum(BytesFromCDN) + sum(BytesFromPeers) + sum(BytesFromGroupPeers) + sum(BytesFromIntPeers) + sum(BytesFromCache) by ContentType\n| extend GB = round(Bytes / BytesPerGB, 2)\n| project ContentType, GB\n| top 10 by GB desc",
                    "size": 2,
                    "queryType": 0,
                    "resourceType": "microsoft.operationalinsights/workspaces",
                    "title": "Volume by content type (GB)",
                    "visualization": "barchart",
                    "timeContextFromParameter": "TimeRange",
                    "chartSettings": {
                      "showLegend": false
                    },
                    "crossComponentResources": [
                      "{WufbWorkspace}"
                    ]
                  },
                  "name": "chart - do-content-gb",
                  "customWidth": "35"
                },
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "let BytesPerGB = 1073741824.0;\nlet DO = UCDOStatus\n| where TimeGenerated {TimeRange}\n| where GroupID in ({DOGroupId}) or '*' in ({DOGroupId})\n| where ContentType in ({DOContentType}) or '*' in ({DOContentType});\nDO\n| summarize CDN = sum(BytesFromCDN), LANPeers = sum(BytesFromPeers), GroupPeers = sum(BytesFromGroupPeers), IntPeers = sum(BytesFromIntPeers), MCC = sum(BytesFromCache), Devices = dcount(DeviceName) by GroupID\n| extend TotalBytes = CDN + LANPeers + GroupPeers + IntPeers + MCC\n| where TotalBytes > 0\n| extend PeerBytes = LANPeers + GroupPeers + IntPeers\n| extend TotalGB = round(TotalBytes / BytesPerGB, 2), PeerGB = round(PeerBytes / BytesPerGB, 2), MCCGB = round(MCC / BytesPerGB, 2), CDNGB = round(CDN / BytesPerGB, 2)\n| extend P2PPercent = round(100.0 * PeerBytes / TotalBytes, 2), MCCPercent = round(100.0 * MCC / TotalBytes, 2), CDNPercent = round(100.0 * CDN / TotalBytes, 2)\n| project GroupID, Devices, TotalGB, P2PPercent, MCCPercent, CDNPercent, PeerGB, MCCGB, CDNGB\n| sort by TotalGB desc",
                    "size": 0,
                    "queryType": 0,
                    "resourceType": "microsoft.operationalinsights/workspaces",
                    "title": "Efficiency per DO group",
                    "visualization": "table",
