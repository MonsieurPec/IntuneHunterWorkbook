                {
                  "type": 12,
                  "content": {
                    "version": "NotebookGroup/1.0",
                    "groupType": "editable",
                    "items": [
                      {
                        "type": 3,
                        "content": {
                          "version": "KqlItem/1.0",
                          "query": "let InventoryLookback = 30d;\nlet InventoryStart = iif({TimeRange:start} < ago(InventoryLookback), {TimeRange:start}, ago(InventoryLookback));\nIntuneDevices\n| where TimeGenerated > InventoryStart\n| summarize arg_max(TimeGenerated, OS) by DeviceId\n| extend OSShortName = case(OS =~ \"iOS/iPadOS\", \"iOS/iPadOS\", OS has \"Android\", \"Android\", OS has \"Windows\", \"Windows\", OS =~ \"MacOS\", \"macOS\", isempty(OS), \"Unknown\", \"Other\")\n| summarize Count = count()\n| extend Text = \"All devices\"\n| extend Range = strcat(\"last \", tostring(toint(round((now() - InventoryStart) / 1d, 0))), \" d snapshot\")",
                          "size": 1,
                          "queryType": 0,
                          "resourceType": "microsoft.operationalinsights/workspaces",
                          "title": "All devices",
                          "visualization": "tiles",
                          "timeContextFromParameter": "TimeRange",
                          "tileSettings": {
                            "titleContent": {
                              "columnMatch": "Text",
                              "formatter": 18,
                              "formatOptions": {
                                "thresholdsOptions": "icons",
                                "thresholdsGrid": [
                                  {
                                    "operator": "Default",
                                    "thresholdValue": null,
                                    "representation": "AllServices",
                                    "text": "{0}{1}"
                                  }
                                ]
                              }
                            },
                            "leftContent": {
                              "columnMatch": "Count",
                              "formatter": 12,
