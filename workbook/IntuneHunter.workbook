                          "query": "let AutopilotBuilds = IntuneOperationalLogs\n| where TimeGenerated {TimeRange}\n| where OperationName == \"ESPEnrollment\"\n| extend P = todynamic(Properties)\n| extend ManagedDeviceId = tostring(P.DeviceId), AadDeviceId = tostring(P.AadDeviceId), SerialNumber = tostring(P.ZtdDeviceSerialNumber), IsAutopilot = tostring(P.IsAutopilot), Status = tostring(P.Status), EventId = tostring(P.EventId), Scope = tostring(P.Scope), EnrollmentType = tostring(P.EnrollmentTypeMessage), ESPPolicyName = tostring(P.ESPPolicyName)\n| where IsAutopilot =~ \"true\"\n| where Status =~ \"Success\"\n| where EventId == \"DeviceProvisioningProgressEvent\"\n| where Scope == \"DeviceEnrollmentSuccess\"\n| where isnotempty(ManagedDeviceId)\n| project BuildTime = TimeGenerated, ManagedDeviceId, AadDeviceId, SerialNumber, EnrollmentType, ESPPolicyName;\nAutopilotBuilds\n| summarize Builds = count() by ManagedDeviceId\n| where Builds > 1\n| summarize Count = count()\n| extend Text = \"Devices rebuilt\"\n| extend Range = \"{TimeRange:label}\"",
