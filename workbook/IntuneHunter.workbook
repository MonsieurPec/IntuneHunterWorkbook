                },
                {
                  "durationMs": 1209600000
                },
                {
                  "durationMs": 2419200000
                },
                {
                  "durationMs": 2592000000
                },
                {
                  "durationMs": 5184000000
                },
                {
                  "durationMs": 7776000000
                }
              ],
              "allowCustom": true
            }
          }
        ],
        "style": "pills"
      },
      "customWidth": "15",
      "name": "params - timerange"
    },
    {
      "type": 9,
      "content": {
        "version": "KqlParameterItem/1.0",
        "parameters": [
          {
            "id": "a1000000-0000-0000-0000-000000000002",
            "version": "KqlParameterItem/1.0",
            "name": "Actor",
            "label": "Actor",
            "type": 2,
            "multiSelect": true,
            "quote": "'",
            "delimiter": ",",
            "query": "union isfuzzy=true\n (IntuneAuditLogs\n  | extend AuditProps = parse_json(Properties)\n  | extend ActorUPN = tostring(AuditProps.Actor.UPN)\n  | extend ActorApp = tostring(AuditProps.Actor.ApplicationName)\n  | extend Actor = case(isnotempty(ActorUPN), ActorUPN, isnotempty(ActorApp), strcat(ActorApp, \" (app)\"), Identity)\n  | project Actor),\n (workspace('{EntraWorkspace}').AuditLogs\n  | where OperationName == \"Recover device local administrator password\"\n  | extend Actor = tostring(coalesce(InitiatedBy.user.userPrincipalName, InitiatedBy.app.appDisplayName))\n  | project Actor),\n (workspace('{EntraWorkspace}').AuditLogs\n  | where OperationName == \"Read BitLocker key\"\n  | extend Actor = case(\n      isnotempty(InitiatedBy[\"app\"]), coalesce(tostring(InitiatedBy[\"app\"][\"displayName\"]), tostring(InitiatedBy[\"app\"][\"servicePrincipalId\"])),\n      isnotempty(InitiatedBy[\"user\"]), coalesce(tostring(InitiatedBy[\"user\"][\"userPrincipalName\"]), tostring(InitiatedBy[\"user\"][\"displayName\"])),\n      \"Unknown\")\n  | project Actor)\n| where isnotempty(Actor) and Actor != \"See Actor details in properties\"\n| distinct Actor\n| order by Actor asc",
            "typeSettings": {
              "additionalResourceOptions": [
                "value::all"
              ],
              "showDefault": false
            },
            "defaultValue": "value::all",
            "timeContext": {
              "durationMs": 0
            },
            "timeContextFromParameter": "TimeRange",
            "queryType": 0,
            "resourceType": "microsoft.operationalinsights/workspaces",
            "crossComponentResources": [
              "{IntuneWorkspace}"
            ]
          },
          {
            "id": "a1000000-0000-0000-0000-000000000003",
            "version": "KqlParameterItem/1.0",
            "name": "Operation",
            "label": "Operation",
            "type": 2,
            "multiSelect": true,
            "quote": "'",
            "delimiter": ",",
            "query": "IntuneAuditLogs\n| distinct OperationName\n| order by OperationName asc",
            "typeSettings": {
              "additionalResourceOptions": [
                "value::all"
              ],
              "showDefault": false
            },
            "defaultValue": "value::all",
            "timeContext": {
              "durationMs": 0
            },
            "timeContextFromParameter": "TimeRange",
            "queryType": 0,
            "resourceType": "microsoft.operationalinsights/workspaces",
            "crossComponentResources": [
              "{IntuneWorkspace}"
            ]
          }
        ],
        "style": "pills"
      },
      "conditionalVisibility": {
        "parameterName": "Tab",
        "comparison": "isEqualTo",
        "value": "Audit"
      },
      "customWidth": "50",
      "name": "params - auditfilters"
    },
    {
      "type": 1,
