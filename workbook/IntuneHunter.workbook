                      {
                        "type": 3,
                        "content": {
                          "version": "KqlItem/1.0",
                          "query": "let AutopilotBuilds = IntuneOperationalLogs\n| where TimeGenerated {TimeRange}\n| where OperationName == \"ESPEnrollment\"\n| extend P = todynamic(Properties)\n| extend ManagedDeviceId = tostring(P.DeviceId), AadDeviceId = tostring(P.AadDeviceId), SerialNumber = tostring(P.ZtdDeviceSerialNumber), IsAutopilot = tostring(P.IsAutopilot), Status = tostring(P.Status), EventId = tostring(P.EventId), Scope = tostring(P.Scope), EnrollmentType = tostring(P.EnrollmentTypeMessage), ESPPolicyName = tostring(P.ESPPolicyName)\n| where IsAutopilot =~ \"true\"\n| where Status =~ \"Success\"\n| where EventId == \"DeviceProvisioningProgressEvent\"\n| where Scope == \"DeviceEnrollmentSuccess\"\n| where isnotempty(ManagedDeviceId)\n| project BuildTime = TimeGenerated, ManagedDeviceId, AadDeviceId, SerialNumber, EnrollmentType, ESPPolicyName;\nAutopilotBuilds\n| make-series Builds = count() default = 0 on BuildTime from {TimeRange:start} to {TimeRange:end} step {TimeRange:grain}",
                          "size": 2,
                          "queryType": 0,
                          "resourceType": "microsoft.operationalinsights/workspaces",
                          "title": "Autopilot builds over time - {TimeRange:label}",
                          "visualization": "areachart",
                          "timeContextFromParameter": "TimeRange",
                          "chartSettings": {
                            "showLegend": false,
                            "seriesLabelSettings": [
                              {
                                "seriesName": "Builds",
                                "color": "green"
                              }
                            ]
                          },
                          "crossComponentResources": [
                            "{IntuneWorkspace}"
                          ]
                        },
                        "name": "chart - ap-trend",
                        "customWidth": "60",
                        "styleSettings": {}
                      },
                      {
                        "type": 3,
                        "content": {
                          "version": "KqlItem/1.0",
                          "query": "let AutopilotBuilds = IntuneOperationalLogs\n| where TimeGenerated {TimeRange}\n| where OperationName == \"ESPEnrollment\"\n| extend P = todynamic(Properties)\n| extend ManagedDeviceId = tostring(P.DeviceId), AadDeviceId = tostring(P.AadDeviceId), SerialNumber = tostring(P.ZtdDeviceSerialNumber), IsAutopilot = tostring(P.IsAutopilot), Status = tostring(P.Status), EventId = tostring(P.EventId), Scope = tostring(P.Scope), EnrollmentType = tostring(P.EnrollmentTypeMessage), ESPPolicyName = tostring(P.ESPPolicyName)\n| where IsAutopilot =~ \"true\"\n| where Status =~ \"Success\"\n| where EventId == \"DeviceProvisioningProgressEvent\"\n| where Scope == \"DeviceEnrollmentSuccess\"\n| where isnotempty(ManagedDeviceId)\n| project BuildTime = TimeGenerated, ManagedDeviceId, AadDeviceId, SerialNumber, EnrollmentType, ESPPolicyName;\nAutopilotBuilds\n| extend ESPPolicyName = iif(isempty(ESPPolicyName), \"<none>\", ESPPolicyName)\n| summarize Builds = count() by ESPPolicyName\n| top 10 by Builds desc",
                          "size": 2,
                          "queryType": 0,
                          "resourceType": "microsoft.operationalinsights/workspaces",
                          "title": "Builds by ESP profile (top 10)",
                          "visualization": "piechart",
                          "timeContextFromParameter": "TimeRange",
                          "chartSettings": {
                            "showLegend": false,
                            "simpleLegendSettings": {
                              "position": "right"
                            }
                          },
                          "crossComponentResources": [
                            "{IntuneWorkspace}"
                          ]
                        },
                        "name": "chart - ap-esp",
                        "customWidth": "40",
                        "styleSettings": {}
                      },
                      {
                        "type": 3,
                        "content": {
                          "version": "KqlItem/1.0",
                          "query": "let InventoryLookback = 30d;\nlet InventoryStart = iif({TimeRange:start} < ago(InventoryLookback), {TimeRange:start}, ago(InventoryLookback));\nlet DeviceModels = IntuneDevices\n| where TimeGenerated > InventoryStart\n| where isnotempty(DeviceId)\n| summarize arg_max(TimeGenerated, Model) by DeviceId\n| project ManagedDeviceId = tostring(DeviceId), Model;\nlet AutopilotBuilds = IntuneOperationalLogs\n| where TimeGenerated {TimeRange}\n| where OperationName == \"ESPEnrollment\"\n| extend P = todynamic(Properties)\n| extend ManagedDeviceId = tostring(P.DeviceId), IsAutopilot = tostring(P.IsAutopilot), Status = tostring(P.Status), EventId = tostring(P.EventId), Scope = tostring(P.Scope)\n| where IsAutopilot =~ \"true\"\n| where Status =~ \"Success\"\n| where EventId == \"DeviceProvisioningProgressEvent\"\n| where Scope == \"DeviceEnrollmentSuccess\"\n| where isnotempty(ManagedDeviceId)\n| project BuildTime = TimeGenerated, ManagedDeviceId;\nAutopilotBuilds\n| join kind=leftouter (DeviceModels) on ManagedDeviceId\n| extend Model = iif(isempty(Model), \"Unknown\", Model)\n| summarize Builds = count() by Model, TimeGenerated = bin(BuildTime, 1d)\n| project TimeGenerated, Model, Builds\n| sort by TimeGenerated asc",
                          "size": 2,
                          "queryType": 0,
                          "resourceType": "microsoft.operationalinsights/workspaces",
                          "title": "Builds by model over time - {TimeRange:label}",
                          "visualization": "barchart",
                          "timeContextFromParameter": "TimeRange",
                          "chartSettings": {
                            "showLegend": false
                          },
                          "crossComponentResources": [
                            "{IntuneWorkspace}"
                          ]
                        },
                        "name": "chart - ap-model-trend",
                        "customWidth": "65",
                        "styleSettings": {}
                      },
                      {
                        "type": 3,
                        "content": {
                          "version": "KqlItem/1.0",
                          "query": "let AutopilotBuilds = IntuneOperationalLogs\n| where TimeGenerated {TimeRange}\n| where OperationName == \"ESPEnrollment\"\n| extend P = todynamic(Properties)\n| extend ManagedDeviceId = tostring(P.DeviceId), AadDeviceId = tostring(P.AadDeviceId), SerialNumber = tostring(P.ZtdDeviceSerialNumber), IsAutopilot = tostring(P.IsAutopilot), Status = tostring(P.Status), EventId = tostring(P.EventId), Scope = tostring(P.Scope), EnrollmentType = tostring(P.EnrollmentTypeMessage), ESPPolicyName = tostring(P.ESPPolicyName)\n| where IsAutopilot =~ \"true\"\n| where Status =~ \"Success\"\n| where EventId == \"DeviceProvisioningProgressEvent\"\n| where Scope == \"DeviceEnrollmentSuccess\"\n| where isnotempty(ManagedDeviceId)\n| project BuildTime = TimeGenerated, ManagedDeviceId, AadDeviceId, SerialNumber, EnrollmentType, ESPPolicyName;\nAutopilotBuilds\n| extend EnrollmentType = iif(isempty(EnrollmentType), \"<none>\", EnrollmentType)\n| summarize Builds = count() by EnrollmentType",
                          "size": 2,
                          "queryType": 0,
                          "resourceType": "microsoft.operationalinsights/workspaces",
                          "title": "Builds by enrollment type",
                          "visualization": "piechart",
                          "timeContextFromParameter": "TimeRange",
                          "chartSettings": {
                            "showLegend": false,
                            "simpleLegendSettings": {
                              "position": "right"
                            }
                          },
                          "crossComponentResources": [
                            "{IntuneWorkspace}"
                          ]
                        },
                        "name": "chart - ap-enrollment",
                        "customWidth": "35",
                        "styleSettings": {}
                      },
                      {
                        "type": 3,
                        "content": {
                          "version": "KqlItem/1.0",
                          "query": "let InventoryLookback = 30d;\nlet InventoryStart = iif({TimeRange:start} < ago(InventoryLookback), {TimeRange:start}, ago(InventoryLookback));\n// Latest known name/model per managed device\nlet DeviceNames = IntuneDevices\n| where TimeGenerated > InventoryStart\n| where isnotempty(DeviceId)\n| summarize arg_max(TimeGenerated, DeviceName, Model) by DeviceId\n| project ManagedDeviceId = tostring(DeviceId), ComputerName = tostring(DeviceName), Model = tostring(Model);\n// Single scan of the ESP events, reused by both branches\nlet ESPEvents = materialize(\n    IntuneOperationalLogs\n    | where TimeGenerated {TimeRange}\n    | where OperationName == \"ESPEnrollment\"\n    | extend P = todynamic(Properties)\n    | where tostring(P.IsAutopilot) =~ \"true\"\n    | extend ManagedDeviceId = tostring(P.DeviceId)\n    | where isnotempty(ManagedDeviceId)\n    | project TimeGenerated, ManagedDeviceId, P\n);\n// Branch 1: successful Autopilot build (one row per device, latest)\nlet Builds = ESPEvents\n| where tostring(P.Status) =~ \"Success\"\n| where tostring(P.EventId) == \"DeviceProvisioningProgressEvent\"\n| where tostring(P.Scope) == \"DeviceEnrollmentSuccess\"\n| summarize arg_max(TimeGenerated, P) by ManagedDeviceId\n| project ManagedDeviceId,\n    BuildTime = TimeGenerated,\n    AadDeviceId = tostring(P.AadDeviceId),\n    SerialNumber = tostring(P.ZtdDeviceSerialNumber),\n    EnrollmentType = tostring(P.EnrollmentTypeMessage),\n    ESPPolicyName = tostring(P.ESPPolicyName);\n// Branch 2: ESP end-to-end duration (one row per device, latest)\nlet Durations = ESPEvents\n| where tostring(P.EventId) == \"EspSlaIsDeviceSyncDone\"\n| where tostring(P.Scope) == \"DeviceEspE2E\"\n| extend Time_Seconds = toreal(P.TimeDiff), ESPStatus = tostring(P.Status)\n| where isnotnull(Time_Seconds)\n| summarize arg_max(TimeGenerated, Time_Seconds, ESPStatus) by ManagedDeviceId\n| project ManagedDeviceId, Time_Seconds, ESPStatus;\nBuilds\n| join kind=leftouter (Durations) on ManagedDeviceId\n| join kind=leftouter (DeviceNames) on ManagedDeviceId\n| extend NameResolution = iif(isnotempty(ComputerName), \"Resolved\", \"Not in inventory\")\n| extend ComputerName = iif(isnotempty(ComputerName), ComputerName, strcat(\"<unresolved \", ManagedDeviceId, \">\"))\n| extend DurationText = iif(isnotnull(Time_Seconds), format_timespan(Time_Seconds * 1s, 'hh:mm:ss'), \"n/a\")\n| project BuildTime, ComputerName, Model, SerialNumber, ESPPolicyName, EnrollmentType, ESPStatus, DurationText, NameResolution\n| sort by BuildTime desc",
                          "size": 0,
                          "queryType": 0,
                          "resourceType": "microsoft.operationalinsights/workspaces",
                          "title": "Latest build per device",
                          "visualization": "table",
                          "timeContextFromParameter": "TimeRange",
                          "showExportToExcel": true,
                          "gridSettings": {
                            "filter": true,
                            "rowLimit": 1000,
                            "formatters": [
                              {
                                "columnMatch": "NameResolution",
                                "formatter": 18,
                                "formatOptions": {
                                  "thresholdsOptions": "icons",
                                  "thresholdsGrid": [
                                    {
                                      "operator": "==",
                                      "thresholdValue": "Resolved",
                                      "representation": "success",
