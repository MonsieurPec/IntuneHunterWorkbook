                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "let InventoryLookback = 30d;\nlet InventoryStart = iif({TimeRange:start} < ago(InventoryLookback), {TimeRange:start}, ago(InventoryLookback));\nlet DeviceInventory = workspace('{IntuneWorkspace}').IntuneDevices\n| where TimeGenerated > InventoryStart\n| where isnotempty(ReferenceId)\n| summarize arg_max(TimeGenerated, DeviceName) by DeviceId = ReferenceId\n| project DeviceId, DeviceName;\nAuditLogs\n| where TimeGenerated {TimeRange}\n| where OperationName == \"Read BitLocker key\"\n| extend AdditionalInfo = tostring(AdditionalDetails[0].value)\n| parse AdditionalInfo with * \"device: '\" AadDeviceId \"'\" *\n| extend ActorType = case(\n    isnotempty(InitiatedBy[\"app\"]), \"Application\",\n    isnotempty(InitiatedBy[\"user\"]), \"User\",\n    \"Unknown\")\n| extend Actor = case(\n    isnotempty(InitiatedBy[\"app\"]), coalesce(tostring(InitiatedBy[\"app\"][\"displayName\"]), tostring(InitiatedBy[\"app\"][\"servicePrincipalId\"])),\n    isnotempty(InitiatedBy[\"user\"]), coalesce(tostring(InitiatedBy[\"user\"][\"userPrincipalName\"]), tostring(InitiatedBy[\"user\"][\"displayName\"])),\n    \"Unknown\")\n| where ActorType in ({BitlockerActorType}) or '*' in ({BitlockerActorType})\n| where Actor in ({Actor}) or '*' in ({Actor})\n| join kind=leftouter (DeviceInventory) on $left.AadDeviceId == $right.DeviceId\n| extend PC = coalesce(DeviceName, AadDeviceId)\n| summarize DevicesRequested = dcount(AadDeviceId), Requests = count(), DeviceSet = make_set(PC, 200) by Actor, bin(TimeGenerated, 1h)\n| where DevicesRequested >= 5\n| extend Devices = strcat_array(DeviceSet, \", \")\n| project TimeGenerated, Actor, DevicesRequested, Requests, Devices\n| sort by DevicesRequested desc",
                    "size": 0,
                    "queryType": 0,
                    "resourceType": "microsoft.operationalinsights/workspaces",
                    "title": "Potential harvesting (5+ distinct devices per hour by actor)",
                    "visualization": "table",
                    "timeContextFromParameter": "TimeRange",
                    "showExportToExcel": true,
                    "gridSettings": {
                      "formatters": [
                        {
                          "columnMatch": "Actor",
                          "formatter": 18,
                          "formatOptions": {
                            "thresholdsOptions": "icons",
                            "thresholdsGrid": [
                              {
                                "operator": "contains",
                                "thresholdValue": "(app)",
                                "representation": "Gear",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": "Default",
                                "thresholdValue": null,
