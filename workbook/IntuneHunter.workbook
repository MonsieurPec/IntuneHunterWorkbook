          },
          {
            "type": 12,
            "content": {
              "version": "NotebookGroup/1.0",
              "groupType": "editable",
              "items": [
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "let ExcludedOperationPatterns = dynamic([\"^Sync\",\"ManagedDevice\",\"decrypt\",\"ClientCertificate\",\"WindowsAutopilotDeviceIdentity\",\"Assignment\"]);\nlet ExcludedRegex = strcat(\"(?i)\", strcat_array(ExcludedOperationPatterns, \"|\"));\nIntuneAuditLogs\n| where TimeGenerated {TimeRange}\n| where not(OperationName matches regex ExcludedRegex)\n| where OperationName in ({Operation}) or '*' in ({Operation})\n| extend AuditProps = parse_json(Properties)\n| extend ActorUPN = tostring(AuditProps.Actor.UPN)\n| extend ActorApp = tostring(AuditProps.Actor.ApplicationName)\n| extend Actor = case(isnotempty(ActorUPN), ActorUPN, isnotempty(ActorApp), strcat(ActorApp, \" (app)\"), Identity)\n| where Actor in ({Actor}) or '*' in ({Actor})\n| extend Object = tostring(AuditProps.TargetDisplayNames[0])\n| mv-expand Target = AuditProps.Targets\n| mv-expand ModifiedProperty = Target.ModifiedProperties\n| extend PropertyName = tostring(ModifiedProperty.Name), OldValue = tostring(ModifiedProperty.Old), NewValue = tostring(ModifiedProperty.New)\n| where isnotempty(PropertyName) and PropertyName != \"DeviceManagementAPIVersion\" \n| summarize Count = dcount(tostring(AuditProps.AuditEventId))\n| extend Text = \"Changes\" \n| extend Range = \"{TimeRange:label}\"",
                    "size": 1,
                    "queryType": 0,
                    "resourceType": "microsoft.operationalinsights/workspaces",
                    "title": "Changes",
                    "visualization": "tiles",
                    "timeContextFromParameter": "TimeRange",
                    "tileSettings": {
                      "titleContent": {
                        "columnMatch": "Text",
                        "formatter": 18,
                        "formatOptions": {
                          "thresholdsOptions": "icons",
                          "thresholdsGrid": [
                            {
                              "operator": "Default",
                              "thresholdValue": null,
                              "representation": "Commit",
                              "text": "{0}{1}"
                            }
                          ]
                        }
                      },
                      "leftContent": {
                        "columnMatch": "Count",
                        "formatter": 12,
                        "formatOptions": {
                          "min": 0,
                          "palette": "greenRed"
                        }
                      },
                      "secondaryContent": {
                        "columnMatch": "Range",
                        "formatter": 1
                      },
                      "showBorder": false
                    },
                    "crossComponentResources": [
                      "{IntuneWorkspace}"
                    ]
                  },
                  "name": "kpi-config-changes",
                  "customWidth": "33"
                },
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "let ExcludedOperationPatterns = dynamic([\"^Sync\",\"ManagedDevice\",\"decrypt\",\"ClientCertificate\",\"WindowsAutopilotDeviceIdentity\",\"Assignment\"]);\nlet ExcludedRegex = strcat(\"(?i)\", strcat_array(ExcludedOperationPatterns, \"|\"));\nIntuneAuditLogs\n| where TimeGenerated {TimeRange}\n| where not(OperationName matches regex ExcludedRegex)\n| where OperationName in ({Operation}) or '*' in ({Operation})\n| extend AuditProps = parse_json(Properties)\n| extend ActorUPN = tostring(AuditProps.Actor.UPN)\n| extend ActorApp = tostring(AuditProps.Actor.ApplicationName)\n| extend Actor = case(isnotempty(ActorUPN), ActorUPN, isnotempty(ActorApp), strcat(ActorApp, \" (app)\"), Identity)\n| where Actor in ({Actor}) or '*' in ({Actor})\n| extend Object = tostring(AuditProps.TargetDisplayNames[0])\n| mv-expand Target = AuditProps.Targets\n| mv-expand ModifiedProperty = Target.ModifiedProperties\n| extend PropertyName = tostring(ModifiedProperty.Name), OldValue = tostring(ModifiedProperty.Old), NewValue = tostring(ModifiedProperty.New)\n| where isnotempty(PropertyName) and PropertyName != \"DeviceManagementAPIVersion\" \n| where Object <> \"<null>\" and isnotempty(Object)\n| summarize Count = dcount(Object)\n| extend Text = \"Modified objects\" \n| extend Range = \"{TimeRange:label}\"",
