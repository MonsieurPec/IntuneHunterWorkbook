    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let ExcludedOperationPatterns = dynamic([\"^Sync\",\"ManagedDevice\",\"decrypt\",\"ClientCertificate\",\"WindowsAutopilotDeviceIdentity\"]);\nlet ExcludedRegex = strcat(\"(?i)\", strcat_array(ExcludedOperationPatterns, \"|\"));\nIntuneAuditLogs\n| where TimeGenerated {TimeRange}\n| where not(OperationName matches regex ExcludedRegex)\n| where OperationName in ({Operation}) or '*' in ({Operation})\n| extend AuditProps = parse_json(Properties)\n| extend ActorUPN = tostring(AuditProps.Actor.UPN)\n| extend ActorApp = tostring(AuditProps.Actor.ApplicationName)\n| extend Actor = case(isnotempty(ActorUPN), ActorUPN, isnotempty(ActorApp), strcat(ActorApp, \" (app)\"), Identity)\n| where Actor in ({Actor}) or '*' in ({Actor})\n| summarize Count = dcount(tostring(AuditProps.AuditEventId))\n| extend Text = \"Config & assignment changes\"\n| extend Range = \"audit · {TimeRange:label}\"\n| extend TargetTab = \"Audit\", TargetSection = \"Config\"",
              "size": 1,
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "title": "Config & assignment changes",
              "visualization": "tiles",
              "timeContextFromParameter": "TimeRange",
              "tileSettings": {
                "titleContent": {
                  "columnMatch": "Text",
                  "formatter": 18,
                  "formatOptions": {
                    "thresholdsOptions": "icons",
                    "thresholdsGrid": [
                      {
                        "operator": "Default",
                        "thresholdValue": null,
                        "representation": "Gear",
                        "text": "{0}{1}"
                      }
                    ]
                  }
                },
                "leftContent": {
                  "columnMatch": "Count",
                  "formatter": 12,
                  "formatOptions": {
                    "min": 0,
                    "palette": "blue"
                  }
                },
                "secondaryContent": {
                  "columnMatch": "Range",
                  "formatter": 1
                },
                "showBorder": true
              },
              "exportedParameters": [
                {
                  "fieldName": "TargetTab",
                  "parameterName": "Tab",
                  "parameterType": 1
                },
                {
                  "fieldName": "TargetSection",
                  "parameterName": "AuditSection",
                  "parameterType": 1
                }
              ],
              "exportMultipleValues": false,
              "crossComponentResources": [
                "{IntuneWorkspace}"
              ]
            },
            "name": "kpi-ov-config",
            "customWidth": "25"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "IntuneAuditLogs\n| where TimeGenerated {TimeRange}\n| where OperationName has_any (\"wipe\", \"retire\", \"cleanWindowsDevice\", \"freshStart\", \"eraseDevice\") or (OperationName contains \"Delete ManagedDevice\" and OperationName <> \"Delete ManagedDeviceMobileAppConfiguration\")\n| where OperationName in ({Operation}) or '*' in ({Operation})\n| extend AuditProps = parse_json(Properties)\n| extend ActorUPN = tostring(AuditProps.Actor.UPN)\n| extend ActorApp = tostring(AuditProps.Actor.ApplicationName)\n| extend Actor = case(isnotempty(ActorUPN), ActorUPN, isnotempty(ActorApp), strcat(ActorApp, \" (app)\"), Identity)\n| where Actor in ({Actor}) or '*' in ({Actor})\n| summarize Count = count()\n| extend Text = \"Destructive & deletion actions\"\n| extend Range = \"audit · {TimeRange:label}\"\n| extend TargetTab = \"Audit\", TargetSection = \"Wipe\"",
              "size": 1,
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "title": "Destructive & deletion actions",
              "visualization": "tiles",
              "timeContextFromParameter": "TimeRange",
              "tileSettings": {
                "titleContent": {
                  "columnMatch": "Text",
                  "formatter": 18,
                  "formatOptions": {
                    "thresholdsOptions": "icons",
                    "thresholdsGrid": [
                      {
                        "operator": "Default",
                        "thresholdValue": null,
                        "representation": "2",
                        "text": "{0}{1}"
                      }
                    ]
                  }
                },
                "leftContent": {
                  "columnMatch": "Count",
                  "formatter": 12,
                  "formatOptions": {
                    "min": 0,
                    "palette": "red"
                  }
                },
                "secondaryContent": {
                  "columnMatch": "Range",
                  "formatter": 1
                },
                "showBorder": true
              },
              "exportedParameters": [
                {
                  "fieldName": "TargetTab",
                  "parameterName": "Tab",
                  "parameterType": 1
                },
                {
                  "fieldName": "TargetSection",
                  "parameterName": "AuditSection",
                  "parameterType": 1
                }
              ],
              "exportMultipleValues": false,
              "crossComponentResources": [
                "{IntuneWorkspace}"
              ]
            },
            "name": "kpi-ov-wipe",
            "customWidth": "25"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "IntuneAuditLogs\n| where TimeGenerated {TimeRange}\n| where not(OperationName matches regex \"(?i)^Sync\")\n| where OperationName in ({Operation}) or '*' in ({Operation})\n| extend AuditProps = parse_json(Properties)\n| extend ActorUPN = tostring(AuditProps.Actor.UPN)\n| extend ActorApp = tostring(AuditProps.Actor.ApplicationName)\n| extend Actor = case(isnotempty(ActorUPN), ActorUPN, isnotempty(ActorApp), strcat(ActorApp, \" (app)\"), Identity)\n| where Actor != \"See Actor details in properties\"\n| where Actor != \"Microsoft Intune (app)\"\n| where Actor in ({Actor}) or '*' in ({Actor})\n| summarize Count = dcount(Actor)\n| extend Text = \"Distinct actors\"\n| extend Range = \"audit · {TimeRange:label}\"\n| extend TargetTab = \"Audit\", TargetSection = \"TopActions\"",
              "size": 1,
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "title": "Distinct actors",
              "visualization": "tiles",
              "timeContextFromParameter": "TimeRange",
              "tileSettings": {
                "titleContent": {
                  "columnMatch": "Text",
                  "formatter": 18,
                  "formatOptions": {
                    "thresholdsOptions": "icons",
                    "thresholdsGrid": [
                      {
                        "operator": "Default",
                        "thresholdValue": null,
                        "representation": "Person",
                        "text": "{0}{1}"
                      }
                    ]
                  }
                },
                "leftContent": {
                  "columnMatch": "Count",
                  "formatter": 12,
                  "formatOptions": {
                    "min": 0,
                    "palette": "blue"
                  }
                },
                "secondaryContent": {
                  "columnMatch": "Range",
                  "formatter": 1
                },
                "showBorder": true
              },
              "exportedParameters": [
                {
                  "fieldName": "TargetTab",
                  "parameterName": "Tab",
                  "parameterType": 1
                },
                {
                  "fieldName": "TargetSection",
                  "parameterName": "AuditSection",
                  "parameterType": 1
                }
              ],
              "exportMultipleValues": false,
              "crossComponentResources": [
                "{IntuneWorkspace}"
              ]
            },
            "name": "kpi-ov-actors",
            "customWidth": "25"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "AuditLogs\n| where TimeGenerated {TimeRange}\n| where OperationName == \"Recover device local administrator password\"\n| mv-expand TargetResources\n| extend DeviceName = tostring(TargetResources.displayName)\n| extend Actor = tostring(coalesce(InitiatedBy.user.userPrincipalName, InitiatedBy.app.appDisplayName))\n| where isnotempty(Actor)\n| where Actor in ({Actor}) or '*' in ({Actor})\n| summarize Count = count()\n| extend Text = \"LAPS recoveries\"\n| extend Range = \"privileged · {TimeRange:label}\"\n| extend TargetTab = \"Audit\", TargetSection = \"LAPS\"",
              "size": 1,
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "title": "LAPS recoveries",
              "visualization": "tiles",
              "timeContextFromParameter": "TimeRange",
              "tileSettings": {
                "titleContent": {
                  "columnMatch": "Text",
                  "formatter": 18,
                  "formatOptions": {
                    "thresholdsOptions": "icons",
                    "thresholdsGrid": [
                      {
                        "operator": "Default",
                        "thresholdValue": null,
                        "representation": "Monitoring",
                        "text": "{0}{1}"
                      }
                    ]
                  }
                },
                "leftContent": {
                  "columnMatch": "Count",
                  "formatter": 12,
                  "formatOptions": {
                    "min": 0,
                    "palette": "orange"
                  }
                },
                "secondaryContent": {
                  "columnMatch": "Range",
                  "formatter": 1
                },
                "showBorder": true
              },
              "exportedParameters": [
                {
                  "fieldName": "TargetTab",
                  "parameterName": "Tab",
                  "parameterType": 1
                },
                {
                  "fieldName": "TargetSection",
                  "parameterName": "AuditSection",
                  "parameterType": 1
                }
              ],
              "exportMultipleValues": false,
              "crossComponentResources": [
                "{EntraWorkspace}"
              ]
            },
            "name": "kpi-ov-laps",
            "customWidth": "25"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let MinJustificationLength = 15;\nlet BusinessStart = 7;\nlet BusinessEnd = 19;\nlet PIMActivations = AuditLogs\n| where TimeGenerated {TimeRange}\n| where LoggedByService == \"PIM\"\n| where OperationName == \"Add member to role completed (PIM activation)\"\n| extend Requestor = tostring(InitiatedBy.user.userPrincipalName)\n| where isnotempty(Requestor)\n| where Requestor in ({Actor}) or '*' in ({Actor})\n| mv-apply Target = todynamic(TargetResources) on (\n    summarize RoleSet = make_set_if(tostring(Target.displayName), tostring(Target.type) =~ \"Role\"),\n              UserSet = make_set_if(tostring(Target.userPrincipalName), tostring(Target.type) =~ \"User\"),\n              ScopeSet = make_set_if(tostring(Target.displayName), tostring(Target.type) !~ \"Role\" and isnotempty(tostring(Target.displayName))))\n| extend Role = tostring(RoleSet[0]), TargetUser = tostring(UserSet[0]), ResourceName = tostring(ScopeSet[0])\n| extend RawDetails = iif(array_length(todynamic(AdditionalDetails)) == 0, pack_array(bag_pack(\"key\", \"_none\", \"value\", \"\")), todynamic(AdditionalDetails))\n| mv-apply Detail = RawDetails on (\n    summarize Bag = make_bag(bag_pack(tostring(Detail.key), Detail.value)))\n| extend Justification = coalesce(tostring(Bag[\"Justification\"]), tostring(ResultReason), tostring(ResultDescription), \"\")\n| extend StartTime = todatetime(coalesce(tostring(Bag[\"StartTime\"]), tostring(Bag[\"startDateTime\"])))\n| extend EndTime = todatetime(coalesce(tostring(Bag[\"ExpirationTime\"]), tostring(Bag[\"EndTime\"]), tostring(Bag[\"expirationDateTime\"])))\n| extend TicketNumber = tostring(Bag[\"TicketNumber\"]), TicketSystem = tostring(Bag[\"TicketSystem\"]), ActorIP = tostring(Bag[\"ipaddr\"])\n| extend DurationHours = iif(isnotnull(StartTime) and isnotnull(EndTime), round((EndTime - StartTime) / 1h, 1), real(-1))\n| extend JustificationLength = strlen(Justification)\n| extend JustificationQuality = case(JustificationLength == 0, \"Missing\", JustificationLength < MinJustificationLength, \"Too short\", \"Provided\")\n| extend OutsideHours = hourofday(TimeGenerated) < BusinessStart or hourofday(TimeGenerated) >= BusinessEnd or dayofweek(TimeGenerated) in (0d, 6d)\n;\nPIMActivations\n| summarize Total = count(), Weak = countif(JustificationQuality != \"Provided\")\n| extend Count = iif(Total > 0, toint(round(100.0 * Weak / Total)), 0)\n| extend Text = \"PIM weak-justification rate\"\n| extend Range = \"privileged · % of activations\"\n| extend TargetTab = \"Audit\", TargetSection = \"PIM\"",
              "size": 1,
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "title": "PIM weak-justification rate",
              "visualization": "tiles",
              "timeContextFromParameter": "TimeRange",
              "tileSettings": {
                "titleContent": {
                  "columnMatch": "Text",
                  "formatter": 18,
                  "formatOptions": {
                    "thresholdsOptions": "icons",
                    "thresholdsGrid": [
                      {
                        "operator": "Default",
                        "thresholdValue": null,
                        "representation": "Alert",
                        "text": "{0}{1}"
                      }
                    ]
                  }
                },
                "leftContent": {
                  "columnMatch": "Count",
                  "formatter": 12,
                  "formatOptions": {
                    "min": 0,
                    "palette": "redGreen"
                  }
                },
                "secondaryContent": {
                  "columnMatch": "Range",
                  "formatter": 1
                },
                "showBorder": true
              },
              "exportedParameters": [
                {
                  "fieldName": "TargetTab",
                  "parameterName": "Tab",
                  "parameterType": 1
                },
                {
                  "fieldName": "TargetSection",
                  "parameterName": "AuditSection",
                  "parameterType": 1
                }
              ],
              "exportMultipleValues": false,
              "crossComponentResources": [
                "{EntraWorkspace}"
              ]
            },
            "name": "kpi-ov-pim",
            "customWidth": "25"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let InventoryLookback = 30d;\nlet InventoryStart = iif({TimeRange:start} < ago(InventoryLookback), {TimeRange:start}, ago(InventoryLookback));\nlet WinNow = IntuneDevices\n| where TimeGenerated > InventoryStart\n| where OS == \"Windows\"\n| summarize arg_max(TimeGenerated, OSVersion) by DeviceId\n| extend WinBuild = toint(split(OSVersion, \".\")[2])\n| extend WinFamily = case(isnull(WinBuild), \"Unknown\", WinBuild >= 22000, \"Windows 11\", WinBuild >= 10240, \"Windows 10\", \"Unknown\");\nWinNow\n| summarize Total = count(), Win11 = countif(WinFamily == \"Windows 11\")\n| extend Count = iif(Total > 0, toint(round(100.0 * Win11 / Total)), 0)\n| extend Text = \"Windows 11 share\"\n| extend Range = \"fleet · %\"\n| extend TargetTab = \"Inventory\", TargetInvTab = \"DeviceInventory\", TargetInvSection = \"WinVersion\"",
              "size": 1,
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "title": "Windows 11 share",
              "visualization": "tiles",
              "timeContextFromParameter": "TimeRange",
              "tileSettings": {
                "titleContent": {
                  "columnMatch": "Text",
                  "formatter": 18,
                  "formatOptions": {
                    "thresholdsOptions": "icons",
                    "thresholdsGrid": [
                      {
                        "operator": "Default",
                        "thresholdValue": null,
                        "representation": "Monitoring",
                        "text": "{0}{1}"
                      }
                    ]
                  }
                },
                "leftContent": {
                  "columnMatch": "Count",
                  "formatter": 12,
                  "formatOptions": {
                    "min": 0,
                    "palette": "redGreen"
                  }
                },
                "secondaryContent": {
                  "columnMatch": "Range",
                  "formatter": 1
                },
                "showBorder": true
              },
              "exportedParameters": [
                {
                  "fieldName": "TargetTab",
                  "parameterName": "Tab",
                  "parameterType": 1
                },
                {
                  "fieldName": "TargetInvTab",
                  "parameterName": "InvTab",
                  "parameterType": 1
                },
                {
                  "fieldName": "TargetInvSection",
                  "parameterName": "InvSection",
                  "parameterType": 1
                }
              ],
              "exportMultipleValues": false,
              "crossComponentResources": [
                "{IntuneWorkspace}"
              ]
            },
            "name": "kpi-ov-win11",
            "customWidth": "25"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let InventoryLookback = 30d;\nlet InventoryStart = iif({TimeRange:start} < ago(InventoryLookback), {TimeRange:start}, ago(InventoryLookback));\nIntuneDeviceComplianceOrg\n| where TimeGenerated > InventoryStart\n| summarize arg_max(TimeGenerated, ComplianceState) by DeviceId\n| summarize Total = count(), Ok = countif(ComplianceState =~ \"Compliant\")\n| extend Count = iif(Total > 0, toint(round(100.0 * Ok / Total)), 0)\n| extend Text = \"Compliance rate\"\n| extend Range = \"fleet · %\"\n| extend TargetTab = \"Inventory\", TargetInvTab = \"DeviceInventory\", TargetInvSection = \"Compliance\"",
              "size": 1,
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "title": "Compliance rate",
              "visualization": "tiles",
              "timeContextFromParameter": "TimeRange",
              "tileSettings": {
                "titleContent": {
                  "columnMatch": "Text",
                  "formatter": 18,
                  "formatOptions": {
                    "thresholdsOptions": "icons",
                    "thresholdsGrid": [
                      {
                        "operator": "Default",
                        "thresholdValue": null,
                        "representation": "success",
                        "text": "{0}{1}"
                      }
                    ]
                  }
                },
                "leftContent": {
                  "columnMatch": "Count",
                  "formatter": 12,
                  "formatOptions": {
                    "min": 0,
                    "palette": "redGreen"
                  }
                },
                "secondaryContent": {
                  "columnMatch": "Range",
                  "formatter": 1
                },
                "showBorder": true
              },
              "exportedParameters": [
                {
                  "fieldName": "TargetTab",
                  "parameterName": "Tab",
                  "parameterType": 1
                },
                {
                  "fieldName": "TargetInvTab",
                  "parameterName": "InvTab",
                  "parameterType": 1
                },
                {
                  "fieldName": "TargetInvSection",
                  "parameterName": "InvSection",
                  "parameterType": 1
                }
              ],
              "exportMultipleValues": false,
              "crossComponentResources": [
                "{IntuneWorkspace}"
              ]
            },
            "name": "kpi-ov-compliance",
            "customWidth": "25"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let InventoryLookback = 30d;\nlet InventoryStart = iif({TimeRange:start} < ago(InventoryLookback), {TimeRange:start}, ago(InventoryLookback));\nlet StorageUnitToGB = 1024.0;\nlet CriticalGB = 10.0;\nIntuneDevices\n| where TimeGenerated > InventoryStart\n| where OS == \"Windows\"\n| summarize arg_max(TimeGenerated, StorageFree, StorageTotal) by DeviceId\n| extend Free = todouble(StorageFree), Total = todouble(StorageTotal)\n| where isnotnull(Free) and isnotnull(Total) and Free > 0 and Total > 0\n| where round(Free / StorageUnitToGB, 2) < CriticalGB\n| summarize Count = count()\n| extend Text = \"Disk critical\"\n| extend Range = \"Windows fleet · < 10 GB free\"\n| extend TargetTab = \"Inventory\", TargetInvTab = \"DeviceInventory\", TargetInvSection = \"Disk\"",
              "size": 1,
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "title": "Disk critical",
              "visualization": "tiles",
              "timeContextFromParameter": "TimeRange",
              "tileSettings": {
                "titleContent": {
                  "columnMatch": "Text",
                  "formatter": 18,
                  "formatOptions": {
                    "thresholdsOptions": "icons",
                    "thresholdsGrid": [
                      {
                        "operator": "Default",
                        "thresholdValue": null,
                        "representation": "2",
                        "text": "{0}{1}"
                      }
                    ]
                  }
                },
                "leftContent": {
                  "columnMatch": "Count",
                  "formatter": 12,
                  "formatOptions": {
                    "min": 0,
                    "palette": "red"
                  }
                },
                "secondaryContent": {
                  "columnMatch": "Range",
                  "formatter": 1
                },
                "showBorder": true
              },
              "exportedParameters": [
                {
                  "fieldName": "TargetTab",
                  "parameterName": "Tab",
                  "parameterType": 1
                },
                {
                  "fieldName": "TargetInvTab",
                  "parameterName": "InvTab",
                  "parameterType": 1
                },
                {
                  "fieldName": "TargetInvSection",
                  "parameterName": "InvSection",
                  "parameterType": 1
                }
              ],
              "exportMultipleValues": false,
              "crossComponentResources": [
                "{IntuneWorkspace}"
              ]
            },
            "name": "kpi-ov-disk",
            "customWidth": "25"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "IntuneAuditLogs\n| where TimeGenerated {TimeRange}\n| where not(OperationName matches regex \"(?i)^Sync\")\n| where OperationName in ({Operation}) or '*' in ({Operation})\n| extend AuditProps = parse_json(Properties)\n| extend ActorUPN = tostring(AuditProps.Actor.UPN)\n| extend ActorApp = tostring(AuditProps.Actor.ApplicationName)\n| extend Actor = case(isnotempty(ActorUPN), ActorUPN, isnotempty(ActorApp), strcat(ActorApp, \" (app)\"), Identity)\n| where Actor in ({Actor}) or '*' in ({Actor})\n| extend EventCategory = case(OperationName contains \"Assignment\", \"Assignment\", OperationName has_any (\"wipe\", \"retire\", \"cleanWindowsDevice\", \"freshStart\", \"eraseDevice\"), \"Wipe/Retire/Reset\", OperationName contains \"Delete ManagedDevice\" and OperationName != \"Delete ManagedDeviceMobileAppConfiguration\", \"Device deletion\", \"Configuration\")\n| make-series Trend = count() default = 0 on TimeGenerated from {TimeRange:start} to {TimeRange:end} step {TimeRange:grain} by EventCategory",
              "size": 2,
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "title": "Activity by category - {TimeRange:label}",
              "visualization": "areachart",
              "timeContextFromParameter": "TimeRange",
              "chartSettings": {
                "showLegend": true,
                "seriesLabelSettings": [
                  {
                    "seriesName": "Configuration",
                    "color": "blue"
                  },
                  {
                    "seriesName": "Assignment",
                    "color": "greenDark"
                  },
                  {
                    "seriesName": "Wipe/Retire/Reset",
                    "color": "red"
                  },
                  {
                    "seriesName": "Device deletion",
                    "color": "orange"
                  }
                ]
              },
              "crossComponentResources": [
                "{IntuneWorkspace}"
              ]
            },
            "name": "chart - ov-trend",
            "customWidth": 65
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "IntuneAuditLogs\n| where TimeGenerated {TimeRange}\n| where not(OperationName matches regex \"(?i)^Sync\")\n| where OperationName in ({Operation}) or '*' in ({Operation})\n| extend AuditProps = parse_json(Properties)\n| extend ActorUPN = tostring(AuditProps.Actor.UPN)\n| extend ActorApp = tostring(AuditProps.Actor.ApplicationName)\n| extend Actor = case(isnotempty(ActorUPN), ActorUPN, isnotempty(ActorApp), strcat(ActorApp, \" (app)\"), Identity)\n| where Actor != \"See Actor details in properties\"\n| where Actor != \"Microsoft Intune (app)\"\n| where Actor in ({Actor}) or '*' in ({Actor})\n| summarize Actions = dcount(tostring(AuditProps.AuditEventId)) by Actor\n| top 15 by Actions desc",
              "size": 2,
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "title": "Top 15 actors",
              "visualization": "barchart",
              "timeContextFromParameter": "TimeRange",
              "chartSettings": {
                "showLegend": false
              },
              "crossComponentResources": [
                "{IntuneWorkspace}"
              ]
            },
            "name": "chart - ov-actors",
            "customWidth": 35
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let PIM = AuditLogs\n| where TimeGenerated {TimeRange}\n| where LoggedByService == \"PIM\"\n| where OperationName == \"Add member to role completed (PIM activation)\"\n| extend Stream = \"PIM activation\";\nlet LAPS = AuditLogs\n| where TimeGenerated {TimeRange}\n| where OperationName == \"Recover device local administrator password\"\n| extend Stream = \"LAPS recovery\";\nunion PIM, LAPS\n| make-series Trend = count() default = 0 on TimeGenerated from {TimeRange:start} to {TimeRange:end} step {TimeRange:grain} by Stream",
              "size": 2,
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "title": "Privileged access over time - {TimeRange:label}",
              "visualization": "areachart",
              "timeContextFromParameter": "TimeRange",
              "chartSettings": {
                "showLegend": true,
                "seriesLabelSettings": [
                  {
                    "seriesName": "PIM activation",
                    "color": "orange"
                  },
                  {
                    "seriesName": "LAPS recovery",
                    "color": "blue"
                  }
                ]
              },
              "crossComponentResources": [
                "{EntraWorkspace}"
              ]
            },
            "name": "chart - ov-privileged",
            "customWidth": 65
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let InventoryLookback = 30d;\nlet InventoryStart = iif({TimeRange:start} < ago(InventoryLookback), {TimeRange:start}, ago(InventoryLookback));\nlet WinNow = IntuneDevices\n| where TimeGenerated > InventoryStart\n| where OS == \"Windows\"\n| summarize arg_max(TimeGenerated, OSVersion) by DeviceId\n| extend WinBuild = toint(split(OSVersion, \".\")[2])\n| extend WinFamily = case(isnull(WinBuild), \"Unknown\", WinBuild >= 22000, \"Windows 11\", WinBuild >= 10240, \"Windows 10\", \"Unknown\");\nWinNow\n| summarize Devices = count() by WinFamily",
              "size": 2,
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "title": "Windows fleet split",
              "visualization": "piechart",
              "timeContextFromParameter": "TimeRange",
              "chartSettings": {
                "showLegend": true,
                "seriesLabelSettings": [
                  {
                    "seriesName": "Windows 11",
                    "color": "green"
                  },
                  {
                    "seriesName": "Windows 10",
                    "color": "red"
                  },
                  {
                    "seriesName": "Unknown",
                    "color": "gray"
                  }
                ]
              },
              "crossComponentResources": [
                "{IntuneWorkspace}"
              ]
            },
            "name": "chart - ov-fleet",
            "customWidth": 35
          }
        ]
      },
