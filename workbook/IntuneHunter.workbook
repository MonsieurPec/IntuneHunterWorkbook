                      {
                        "type": 3,
                        "content": {
                          "version": "KqlItem/1.0",
                          "query": "let InventoryLookback = 30d;\nlet InventoryStart = iif({TimeRange:start} < ago(InventoryLookback), {TimeRange:start}, ago(InventoryLookback));\nlet Compliance = IntuneDeviceComplianceOrg\n| where TimeGenerated > InventoryStart\n| summarize arg_max(TimeGenerated, *) by DeviceId\n| extend OSShortName = case(OS =~ \"iOS/iPadOS\", \"iOS/iPadOS\", OS has \"Android\", \"Android\", OS has \"Windows\", \"Windows\", OS =~ \"MacOS\", \"macOS\", isempty(OS), \"Unknown\", \"Other\")\n| where OSShortName in ({ComplianceOS}) or '*' in ({ComplianceOS})\n| extend GraceUntil = todatetime(InGracePeriodUntil)\n| extend InGrace = isnotnull(GraceUntil) and GraceUntil > now() and GraceUntil < datetime(9000-01-01)\n| extend State = case(isempty(ComplianceState), \"Unknown\", ComplianceState);\nCompliance\n| project DeviceName, UserEmail, OSShortName, OSVersion, State, InGrace, GraceUntil, DeviceHealthThreatLevel, OwnerType, ManagementAgents, LastContact, DeviceId\n| sort by State asc, DeviceName asc",
                          "size": 0,
                          "queryType": 0,
                          "resourceType": "microsoft.operationalinsights/workspaces",
