                                "operator": "contains",
                                "thresholdValue": "Delete",
                                "representation": "Delete",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": "contains",
                                "thresholdValue": "Create",
                                "representation": "Code",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": "contains",
                                "thresholdValue": "Patch",
                                "representation": "Commit",
                                "text": "{0}{1}"
                              },
                              {
                                "operator": "contains",
                                "thresholdValue": "Update",
                                "representation": "Commit",
                                "text": "{0}{1}"
