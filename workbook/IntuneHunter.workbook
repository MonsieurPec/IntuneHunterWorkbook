                        },
                        {
                          "columnMatch": "DevicesRequested",
                          "formatter": 4,
                          "formatOptions": {
                            "palette": "red",
                            "customColumnWidthSetting": "12ch"
                          }
                        },
                        {
                          "columnMatch": "Devices",
                          "formatter": 0,
                          "formatOptions": {
                            "customColumnWidthSetting": "3fr"
                          }
                        }
                      ],
                      "filter": true,
                      "labelSettings": [
                        {
                          "columnId": "TimeGenerated",
                          "label": "Window (1 h)"
                        },
                        {
                          "columnId": "DevicesRequested",
                          "label": "Distinct devices"
                        },
                        {
                          "columnId": "Requests",
                          "label": "Requests"
                        },
                        {
                          "columnId": "Devices",
                          "label": "Devices affected"
