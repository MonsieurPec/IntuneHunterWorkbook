          {
            "type": 12,
            "content": {
              "version": "NotebookGroup/1.0",
              "groupType": "editable",
              "items": [
                {
                  "type": 9,
                  "content": {
                    "version": "KqlParameterItem/1.0",
                    "parameters": [
                      {
                        "id": "d1000000-0000-0000-0000-000000000001",
                        "version": "KqlParameterItem/1.0",
                        "name": "OS",
                        "label": "Operating system",
                        "type": 2,
                        "multiSelect": true,
                        "quote": "'",
                        "delimiter": ",",
                        "query": "IntuneDevices\n| where TimeGenerated > ago(30d)\n| extend OSShortName = case(OS =~ \"iOS/iPadOS\", \"iOS/iPadOS\", OS has \"Android\", \"Android\", OS has \"Windows\", \"Windows\", OS =~ \"MacOS\", \"macOS\", \"Other\")\n| distinct OSShortName\n| union (print OSShortName = \"Unknown\")\n| order by OSShortName asc",
                        "typeSettings": {
                          "additionalResourceOptions": [
                            "value::all"
                          ],
                          "showDefault": false
                        },
                        "defaultValue": "value::all",
                        "timeContext": {
                          "durationMs": 2592000000
                        },
                        "queryType": 0,
                        "resourceType": "microsoft.operationalinsights/workspaces",
                        "crossComponentResources": [
                          "{IntuneWorkspace}"
                        ]
                      }
                    ],
                    "style": "pills"
                  },
                  "name": "params - devices"
                },
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "let InventoryLookback = 30d;\nlet InventoryStart = iif({TimeRange:start} < ago(InventoryLookback), {TimeRange:start}, ago(InventoryLookback));\nlet DeviceLookup = IntuneDevices\n| where TimeGenerated > InventoryStart\n| summarize arg_max(TimeGenerated, DeviceName, UPN, OS, OSVersion, Model, Manufacturer, LastContact) by DeviceId\n| extend InvOS = case(OS =~ \"iOS/iPadOS\", \"iOS/iPadOS\", OS has \"Android\", \"Android\", OS has \"Windows\", \"Windows\", OS =~ \"MacOS\", \"macOS\", \"Other\")\n| project DeviceId, InvDeviceName = DeviceName, UPN, InvOS, OSVersion, Model, Manufacturer, LastContact;\nIntuneAuditLogs\n| where TimeGenerated {TimeRange}\n| where OperationName contains \"ManagedDevice\"\n| where OperationName <> \"Delete ManagedDeviceMobileAppConfiguration\"\n| where OperationName in ({Operation}) or '*' in ({Operation})\n| extend AuditProps = parse_json(Properties)\n| extend ActorUPN = tostring(AuditProps.Actor.UPN)\n| extend ActorApp = tostring(AuditProps.Actor.ApplicationName)\n| extend Actor = case(isnotempty(ActorUPN), ActorUPN, isnotempty(ActorApp), strcat(ActorApp, \" (app)\"), Identity)\n| where Actor in ({Actor}) or '*' in ({Actor})\n| extend DeviceId = tostring(AuditProps.TargetObjectIds[0])\n| extend AuditTargetLabel = tostring(AuditProps.TargetDisplayNames[0])\n| where isnotempty(DeviceId)\n| join kind=leftouter (DeviceLookup) on DeviceId\n| extend NameResolution = iif(isnotempty(InvDeviceName), \"Resolved\", \"Not in inventory\")\n| extend DeviceName = iif(isnotempty(InvDeviceName), InvDeviceName, strcat(\"<unresolved \", DeviceId, \">\"))\n| extend OSShortName = iif(isempty(InvOS), \"Unknown\", InvOS)\n| where OSShortName in ({OS}) or '*' in ({OS})\n| summarize Actions = count() by OSShortName",
                    "size": 2,
                    "queryType": 0,
                    "resourceType": "microsoft.operationalinsights/workspaces",
                    "title": "Actions by operating system",
                    "visualization": "piechart",
                    "timeContextFromParameter": "TimeRange",
                    "chartSettings": {
                      "showLegend": false,
                      "seriesLabelSettings": [
                        {
                          "seriesName": "Windows",
                          "color": "blue"
                        },
                        {
                          "seriesName": "Android",
                          "color": "orange"
                        },
                        {
                          "seriesName": "iOS/iPadOS",
                          "color": "green"
                        },
                        {
                          "seriesName": "macOS",
                          "color": "blueDark"
                        },
                        {
                          "seriesName": "Other",
                          "color": "gray"
                        },
                        {
                          "seriesName": "Unknown",
                          "color": "gray"
                        }
                      ]
                    },
                    "crossComponentResources": [
                      "{IntuneWorkspace}"
                    ]
                  },
                  "name": "chart - devices-byos",
                  "customWidth": "35"
                },
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "let InventoryLookback = 30d;\nlet InventoryStart = iif({TimeRange:start} < ago(InventoryLookback), {TimeRange:start}, ago(InventoryLookback));\nlet DeviceLookup = IntuneDevices\n| where TimeGenerated > InventoryStart\n| summarize arg_max(TimeGenerated, DeviceName, UPN, OS, OSVersion, Model, Manufacturer, LastContact) by DeviceId\n| extend InvOS = case(OS =~ \"iOS/iPadOS\", \"iOS/iPadOS\", OS has \"Android\", \"Android\", OS has \"Windows\", \"Windows\", OS =~ \"MacOS\", \"macOS\", \"Other\")\n| project DeviceId, InvDeviceName = DeviceName, UPN, InvOS, OSVersion, Model, Manufacturer, LastContact;\nIntuneAuditLogs\n| where TimeGenerated {TimeRange}\n| where OperationName contains \"ManagedDevice\"\n| where OperationName <> \"Delete ManagedDeviceMobileAppConfiguration\"\n| where OperationName in ({Operation}) or '*' in ({Operation})\n| extend AuditProps = parse_json(Properties)\n| extend ActorUPN = tostring(AuditProps.Actor.UPN)\n| extend ActorApp = tostring(AuditProps.Actor.ApplicationName)\n| extend Actor = case(isnotempty(ActorUPN), ActorUPN, isnotempty(ActorApp), strcat(ActorApp, \" (app)\"), Identity)\n| where Actor in ({Actor}) or '*' in ({Actor})\n| extend DeviceId = tostring(AuditProps.TargetObjectIds[0])\n| extend AuditTargetLabel = tostring(AuditProps.TargetDisplayNames[0])\n| where isnotempty(DeviceId)\n| join kind=leftouter (DeviceLookup) on DeviceId\n| extend NameResolution = iif(isnotempty(InvDeviceName), \"Resolved\", \"Not in inventory\")\n| extend DeviceName = iif(isnotempty(InvDeviceName), InvDeviceName, strcat(\"<unresolved \", DeviceId, \">\"))\n| extend OSShortName = iif(isempty(InvOS), \"Unknown\", InvOS)\n| where OSShortName in ({OS}) or '*' in ({OS})\n| make-series Trend = count() default = 0 on TimeGenerated from {TimeRange:start} to {TimeRange:end} step {TimeRange:grain} by OSShortName",
                    "size": 2,
                    "queryType": 0,
                    "resourceType": "microsoft.operationalinsights/workspaces",
                    "title": "Action trend by operating system - {TimeRange:label}",
                    "visualization": "areachart",
                    "timeContextFromParameter": "TimeRange",
                    "chartSettings": {
                      "showLegend": false,
                      "seriesLabelSettings": [
                        {
                          "seriesName": "Windows",
                          "color": "blue"
                        },
                        {
                          "seriesName": "Android",
                          "color": "orange"
                        },
                        {
                          "seriesName": "iOS/iPadOS",
                          "color": "green"
                        },
                        {
                          "seriesName": "macOS",
                          "color": "blueDark"
                        },
                        {
                          "seriesName": "Other",
                          "color": "gray"
